    Title("Auto Parry")
    -- ===== FITUR: Auto Parry =====
    -- Logic asli dari AUTO PARRY [ UDAH TESTING ].txt
    local AP = { enabled = false, range = 10, visual = true }

    local AP_ATTACK_LIST = {
        "110355011987939","121216847022485","139369275981139","117042998468241",
        "133963973694098","113255068724446","74968262036854","118907603246885",
        "78432063483146","122812055447896","78935059863801","98163597193511",
        "80411309607666","105374834496520","129784271201071","132817836308238",
        "111920872708571","82666958311998","130593238885843","109402730355822",
        "138720291317243","115244153053858","117070354890871","106871536134254",
        "135002183282873",
    }
    local AP_ATTACK_IDS = {}
    for _, id in ipairs(AP_ATTACK_LIST) do AP_ATTACK_IDS[id] = true end

    local AP_CONN = nil
    local AP_state = nil

    local function AP_Start()
        if AP.enabled then return end
        AP.enabled = true

        local CONFIG = {
            RING_SEGMENTS = 32, RING_DASH_RATIO = 0.7, RING_HEIGHT = 0.05,
            RING_WIDTH = 0.18, RING_TRANSPARENCY = 0.4, RING_GROUND_OFFSET = 0.1,
            MAX_FIRES_PER_ATTACK = 2, REFIRE_INTERVAL = 0.12, PARRY_LEAD = 0,
            USE_PING_COMPENSATION = true, CHECK_LINE_OF_SIGHT = true,
            LOS_INTERVAL = 0.04, LOS_FILTER_REFRESH = 1, FIRE_WINDOW = 0.45,
            LUNGE_DETECT = true, LUNGE_DURATION = 0.6,
        }

        local COLOR_RING_IDLE = Color3.fromRGB(255, 255, 255)
        local COLOR_RING_ACTIVE = Color3.fromRGB(40, 255, 80)

        local HIT_TIME = {}
        local state = { enabled = true, range = AP.range, visual = AP.visual }
        AP_state = state

        local shuttingDown = false
        local conns = {}
        local playerConns = {}
        local charData = {}
        local attacks = {}
        local idCache = setmetatable({}, { __mode = "k" })

        local myChar, myRoot, myHum = nil, nil, nil
        local myAlive = false
        local ping = 0
        local lastFire = nil
        local ringFolder, ringParts, ringLastColor = nil, nil, nil
        local rayParams, rayChar = nil, nil
        local losParams, losDirty, losFilterOk, losFilterT = nil, true, false, 0
        local parryButton = nil
        local lastButtonTry = 0

        local function setStatus(text) end

        local function animIdOf(track)
            local cached = idCache[track]
            if cached ~= nil then
                if cached == false then return nil end
                return cached
            end
            local ok, raw = pcall(function()
                local anim = track.Animation
                return anim and anim.AnimationId or nil
            end)
            if ok and type(raw) == "string" then
                local digits = string.match(raw, "%d+")
                if digits then idCache[track] = digits; return digits end
                idCache[track] = false
            end
            return nil
        end

        local function updateSelf()
            local char = LocalPlayer.Character
            if char ~= myChar then
                myChar = char; myRoot = nil; myHum = nil; losDirty = true
            end
            if not char then myAlive = false; return end
            if not (myRoot and myRoot.Parent) then myRoot = char:FindFirstChild("HumanoidRootPart") end
            if not (myHum and myHum.Parent) then myHum = char:FindFirstChildOfClass("Humanoid") end
            myAlive = (myRoot ~= nil) and (myHum ~= nil) and myHum.Health > 0
        end

        local function refreshPing()
            if not CONFIG.USE_PING_COMPENSATION then ping = 0; return end
            local ok, v = pcall(function() return LocalPlayer:GetNetworkPing() end)
            if ok and type(v) == "number" then ping = math.clamp(v, 0, 0.4) end
        end

        local function getParryButton()
            if parryButton and parryButton.Parent then return parryButton end
            parryButton = nil
            local now = os.clock()
            if now - lastButtonTry < 0.2 then return nil end
            lastButtonTry = now
            local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            if not pg then return nil end
            local sm = pg:FindFirstChild("Survivor-mob")
            if not sm then return nil end
            local controls = sm:FindFirstChild("Controls")
            local btn = controls and controls:FindFirstChild("Gui-mob")
            if not btn then btn = sm:FindFirstChild("Gui-mob", true) end
            if btn and btn:IsA("GuiButton") then parryButton = btn; return btn end
            return nil
        end

        local function pressParry()
            local btn = getParryButton()
            if not btn then return false end
            local fs = firesignal
            if fs then
                local ok = pcall(fs, btn.MouseButton1Down)
                if ok then return true end
            end
            if getconnections then
                local ok, list = pcall(getconnections, btn.MouseButton1Down)
                if ok and list then
                    local fired = false
                    for _, c in ipairs(list) do
                        local o = pcall(function() c:Fire() end)
                        if o then fired = true end
                    end
                    return fired
                end
            end
            return false
        end

        local function rebuildLosFilter(now)
            if not losParams then
                losParams = RaycastParams.new()
                losParams.FilterType = Enum.RaycastFilterType.Exclude
                losParams.RespectCanCollide = true
                losParams.IgnoreWater = true
            end
            local list, n = {}, 0
            for _, p in ipairs(Players:GetPlayers()) do
                local c = p.Character
                if c then n = n + 1; list[n] = c end
            end
            for char in pairs(charData) do n = n + 1; list[n] = char end
            if myChar then n = n + 1; list[n] = myChar end
            if ringFolder then n = n + 1; list[n] = ringFolder end
            losFilterOk = pcall(function() losParams.FilterDescendantsInstances = list end)
            losDirty = false; losFilterT = now
        end

        local function isBlocked(rec, kroot, now)
            if not CONFIG.CHECK_LINE_OF_SIGHT then return false end
            if now - rec.losT < CONFIG.LOS_INTERVAL then return rec.losBlocked end
            rec.losT = now
            if losDirty or not losParams then rebuildLosFilter(now) end
            if not losFilterOk then rec.losBlocked = false; return false end
            local origin = kroot.Position
            local dir = myRoot.Position - origin
            local ok, result = pcall(workspace.Raycast, workspace, origin, dir, losParams)
            rec.losBlocked = ok and (result ~= nil)
            return rec.losBlocked
        end

        local function tryPress(rec, kroot, delta)
            if rec.fires >= CONFIG.MAX_FIRES_PER_ATTACK then return end
            local t = os.clock()
            if t - rec.lastTry < CONFIG.REFIRE_INTERVAL then return end
            local d = rec.data
            if d.windowFires >= CONFIG.MAX_FIRES_PER_ATTACK and (t - d.windowT) <= CONFIG.FIRE_WINDOW then return end
            if isBlocked(rec, kroot, t) then return end
            rec.lastTry = t
            if pressParry() then
                if (t - d.windowT) > CONFIG.FIRE_WINDOW then
                    d.windowT = t; d.windowFires = 0
                end
                d.windowFires = d.windowFires + 1
                rec.fires = rec.fires + 1
                lastFire = { t = t, id = rec.id, src = rec.isLunge and "lunge" or "anim" }
            end
        end

        local function effectiveDistance(kroot, delta, dist)
            local effDist = dist
            if dist > 0.001 and ping > 0 then
                local rv = kroot.AssemblyLinearVelocity - myRoot.AssemblyLinearVelocity
                local closing = rv:Dot(delta.Unit)
                if closing > 0 then effDist = dist - closing * ping end
            end
            return effDist
        end

        local function processRecord(rec, now, fresh)
            if rec.isLunge then
                if (not fresh) and (not rec.data.lunging) and (now - rec.start > 0.1) then
                    if attacks[rec.key] == rec then attacks[rec.key] = nil end
                    return false
                end
            else
                local track = rec.track
                if (not fresh) and (not track.IsPlaying) and (now - rec.start > 0.1) then
                    if attacks[track] == rec then attacks[track] = nil end
                    return false
                end
            end
            if not (myRoot and myRoot.Parent) then return false end
            local kroot = rec.kroot
            if not (kroot and kroot.Parent) then
                kroot = rec.data.char:FindFirstChild("HumanoidRootPart")
                rec.kroot = kroot
                if not kroot then return false end
            end
            local delta = myRoot.Position - kroot.Position
            local dist = delta.Magnitude
            local inRange = dist <= state.range
            if rec.armed == nil then
                if myAlive then rec.armed = effectiveDistance(kroot, delta, dist) <= state.range
                else rec.armed = false end
            end
            if not rec.armed then
                if rec.data.lunging then rec.armed = true
                else return false end
            end
            if (not state.enabled) or (not myAlive) then return inRange end
            local effDist = effectiveDistance(kroot, delta, dist)
            if effDist <= state.range then
                local hit = HIT_TIME[rec.id]
                if hit and (now - rec.start) < (hit - ping - CONFIG.PARRY_LEAD) then return inRange end
                tryPress(rec, kroot, delta)
            end
            return inRange
        end

        local function register(d, track, id, isEvent)
            local now = os.clock()
            local rec = attacks[track]
            if rec then
                if isEvent then
                    rec.start = now; rec.fires = 0; rec.lastTry = -math.huge
                    rec.armed = nil; rec.losT = -math.huge; rec.losBlocked = false
                end
                return rec
            end
            rec = {
                data = d, track = track, id = id, start = now, fires = 0,
                lastTry = -math.huge, kroot = nil, armed = nil,
                losT = -math.huge, losBlocked = false,
            }
            attacks[track] = rec
            local c
            c = track.Stopped:Connect(function()
                if attacks[track] == rec then attacks[track] = nil end
                if c then c:Disconnect() end
            end)
            return rec
        end

        local function isKillerData(d)
            if d.isKiller then return true end
            if d.char and d.char.Parent then
                if d.char:FindFirstChild("Lookscriptkiller", true) then
                    d.isKiller = true; return true
                end
            end
            return false
        end

        local function startLunge(d, now)
            updateSelf()
            local rec = attacks[d]
            if rec then
                rec.start = now; rec.fires = 0; rec.lastTry = -math.huge
                rec.armed = true; rec.kroot = nil
                rec.losT = -math.huge; rec.losBlocked = false
            else
                rec = {
                    data = d, key = d, isLunge = true, track = nil, id = "lunge",
                    start = now, fires = 0, lastTry = -math.huge, kroot = nil,
                    armed = true, losT = -math.huge, losBlocked = false,
                }
                attacks[d] = rec
            end
            processRecord(rec, now, true)
        end

        local function refreshLunge(d, now)
            if d.lunging and now >= d.lungeUntil then d.lunging = false end
        end

        local function findCharData(inst)
            local cur = inst
            while cur and cur ~= game do
                local d = charData[cur]
                if d then return d end
                cur = cur.Parent
            end
            return nil
        end

        local function onLungeRemote(...)
            if shuttingDown or not CONFIG.LUNGE_DETECT then return end
            local now = os.clock()
            local list = {}
            local n = select("#", ...)
            for i = 1, n do
                local a = select(i, ...)
                if typeof(a) == "Instance" then
                    local target = a
                    if a:IsA("Player") then target = a.Character end
                    local d = target and findCharData(target)
                    if d and isKillerData(d) then list[#list + 1] = d end
                end
            end
            if #list == 0 then
                for _, d in pairs(charData) do
                    if d.isKiller then list[#list + 1] = d end
                end
            end
            if #list == 0 then
                for _, d in pairs(charData) do
                    if isKillerData(d) then list[#list + 1] = d end
                end
            end
            for _, d in ipairs(list) do
                d.lungeUntil = now + CONFIG.LUNGE_DURATION
                d.lunging = true
                startLunge(d, now)
            end
        end

        local function onAnimPlayed(d, track)
            local id = animIdOf(track)
            if not id or not AP_ATTACK_IDS[id] then return end
            if not isKillerData(d) then return end
            updateSelf()
            local rec = register(d, track, id, true)
            if rec then processRecord(rec, os.clock(), true) end
        end

        local function unhookChar(char)
            local d = charData[char]
            if not d then return end
            charData[char] = nil
            losDirty = true
            for _, c in ipairs(d.conns) do pcall(function() c:Disconnect() end) end
            if d.animConn then pcall(function() d.animConn:Disconnect() end) end
            for tr, rec in pairs(attacks) do
                if rec.data == d then attacks[tr] = nil end
            end
        end

        local function hookAnimator(d, animator)
            if d.animConn then pcall(function() d.animConn:Disconnect() end) end
            d.animator = animator
            d.animConn = animator.AnimationPlayed:Connect(function(track) onAnimPlayed(d, track) end)
        end

        local function hookChar(char)
            if charData[char] then return end
            local d = {
                char = char, conns = {}, isKiller = false, animator = nil,
                animConn = nil, lunging = false, lungeUntil = 0,
                windowT = -math.huge, windowFires = 0,
            }
            charData[char] = d
            losDirty = true
            table.insert(d.conns, char.AncestryChanged:Connect(function(_, parent)
                if parent == nil then unhookChar(char) end
            end))
            task.spawn(function()
                local hum = char:WaitForChild("Humanoid", 20)
                if not hum or charData[char] ~= d then return end
                table.insert(d.conns, hum.ChildAdded:Connect(function(c)
                    if c:IsA("Animator") then hookAnimator(d, c) end
                end))
                local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 20)
                if animator and charData[char] == d then hookAnimator(d, animator) end
            end)
        end

        local function hookPlayer(p)
            if p == LocalPlayer or playerConns[p] then return end
            local list = {}
            playerConns[p] = list
            table.insert(list, p.CharacterAdded:Connect(function(c) hookChar(c) end))
            if p.Character then hookChar(p.Character) end
        end

        local function unhookPlayer(p)
            local list = playerConns[p]
            if list then
                for _, c in ipairs(list) do pcall(function() c:Disconnect() end) end
                playerConns[p] = nil
            end
            if p.Character then unhookChar(p.Character) end
        end

        -- Ring visual
        local function destroyRingParts()
            if ringFolder then pcall(function() ringFolder:Destroy() end); ringFolder = nil; losDirty = true end
            ringParts = nil
        end
        local function ensureRing()
            local cam = workspace.CurrentCamera
            if not cam then return nil end
            if ringFolder and ringFolder.Parent == cam then return ringParts end
            destroyRingParts()
            local folder = Instance.new("Folder")
            folder.Name = "AP_Ring"
            folder.Parent = cam
            ringFolder = folder; losDirty = true
            local segs = {}
            for i = 1, CONFIG.RING_SEGMENTS do
                local part = Instance.new("Part")
                part.Name = "Seg_" .. i
                part.Anchored = true; part.CanCollide = false
                part.CanQuery = false; part.CanTouch = false; part.CastShadow = false
                part.Material = Enum.Material.Neon
                part.Size = Vector3.new(1, CONFIG.RING_HEIGHT, CONFIG.RING_WIDTH)
                part.Color = COLOR_RING_IDLE
                part.Transparency = CONFIG.RING_TRANSPARENCY
                part.TopSurface = Enum.SurfaceType.Smooth
                part.BottomSurface = Enum.SurfaceType.Smooth
                part.Parent = folder
                segs[i] = part
            end
            ringParts = segs; ringLastColor = nil
            return ringParts
        end
        local function getGroundDy()
            if not (myRoot and myRoot.Parent) then return nil end
            if not rayParams then
                rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.RespectCanCollide = true
            end
            if rayChar ~= myChar then
                rayChar = myChar
                rayParams.FilterDescendantsInstances = myChar and { myChar } or {}
            end
            local origin = myRoot.Position
            local ok, result = pcall(workspace.Raycast, workspace, origin, Vector3.new(0, -30, 0), rayParams)
            if ok and result then
                return (result.Position.Y + CONFIG.RING_GROUND_OFFSET) - origin.Y
            end
            local hip = myHum and myHum.HipHeight or 0
            if hip < 0.1 then hip = 2 end
            return -(hip + myRoot.Size.Y / 2) + CONFIG.RING_GROUND_OFFSET
        end
        local function updateRing(anyIn)
            if not (state.visual and myRoot and myRoot.Parent and myAlive) then
                if ringFolder then ringFolder.Parent = nil end
                return
            end
            local parts = ensureRing()
            if not parts then return end
            if ringFolder.Parent ~= workspace.CurrentCamera then
                ringFolder.Parent = workspace.CurrentCamera
            end
            local range = state.range
            local stepAng = (2 * math.pi) / CONFIG.RING_SEGMENTS
            local chord = 2 * range * math.sin(stepAng / 2)
            local dy = getGroundDy() or 0
            local col = anyIn and COLOR_RING_ACTIVE or COLOR_RING_IDLE
            local baseY = myRoot.Position.Y + dy
            for i = 1, CONFIG.RING_SEGMENTS do
                local seg = parts[i]
                local a0 = (i - 1) * stepAng
                local a1 = a0 + stepAng * CONFIG.RING_DASH_RATIO
                local p0x = math.cos(a0) * range
                local p0z = math.sin(a0) * range
                local p1x = math.cos(a1) * range
                local p1z = math.sin(a1) * range
                local mx = (p0x + p1x) / 2
                local mz = (p0z + p1z) / 2
                local dx = p1x - p0x
                local dz = p1z - p0z
                local len = math.sqrt(dx * dx + dz * dz)
                if len < 0.001 then seg.Transparency = 1
                else
                    local yaw = math.atan2(dz, dx)
                    seg.Size = Vector3.new(len, CONFIG.RING_HEIGHT, CONFIG.RING_WIDTH)
                    seg.CFrame = CFrame.new(myRoot.Position.X + mx, baseY, myRoot.Position.Z + mz)
                        * CFrame.Angles(0, -yaw, 0)
                    seg.Transparency = CONFIG.RING_TRANSPARENCY
                end
                if ringLastColor ~= col then seg.Color = col end
            end
            ringLastColor = col
        end

        -- main heartbeat
        local lastPingT, lastScanT = 0, 0
        local hbConn = RunService.Heartbeat:Connect(function()
            local now = os.clock()
            updateSelf()
            if CONFIG.CHECK_LINE_OF_SIGHT and (losDirty or now - losFilterT >= CONFIG.LOS_FILTER_REFRESH) then
                rebuildLosFilter(now)
            end
            if now - lastPingT >= 0.5 then lastPingT = now; refreshPing() end
            if now - lastScanT >= 1 then
                lastScanT = now
                for _, d in pairs(charData) do
                    if not d.isKiller then isKillerData(d) end
                end
            end
            for _, d in pairs(charData) do
                if d.lunging then refreshLunge(d, now) end
                if d.isKiller and d.animator then
                    local ok, tracks = pcall(d.animator.GetPlayingAnimationTracks, d.animator)
                    if ok and tracks then
                        for i = 1, #tracks do
                            local tr = tracks[i]
                            if not attacks[tr] then
                                local id = animIdOf(tr)
                                if id and AP_ATTACK_IDS[id] then register(d, tr, id, false) end
                            end
                        end
                    end
                end
            end
            local anyIn = false
            for _, rec in pairs(attacks) do
                if processRecord(rec, now, false) then anyIn = true end
            end
            updateRing(anyIn)
        end)

        -- parry result + lunge remote
        local extraConns = {}
        table.insert(extraConns, Players.PlayerAdded:Connect(hookPlayer))
        table.insert(extraConns, Players.PlayerRemoving:Connect(unhookPlayer))
        for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end

        table.spawn(function()
            pcall(function()
                local remotes = ReplicatedStorage:WaitForChild("Remotes", 30)
                local items = remotes and remotes:WaitForChild("Items", 30)
                local folder = items and items:WaitForChild("Parrying Dagger", 30)
                local result = folder and folder:WaitForChild("parryResult", 30)
                if result then
                    table.insert(extraConns, result.OnClientEvent:Connect(function() end))
                end
            end)
        end)
        task.spawn(function()
            pcall(function()
                local remotes = ReplicatedStorage:WaitForChild("Remotes", 30)
                local attacksFolder = remotes and remotes:WaitForChild("Attacks", 30)
                local lunge = attacksFolder and attacksFolder:WaitForChild("Lunge", 30)
                if lunge and (lunge:IsA("RemoteEvent") or lunge:IsA("UnreliableRemoteEvent")) then
                    table.insert(extraConns, lunge.OnClientEvent:Connect(onLungeRemote))
                end
            end)
        end)

        AP_CONN = { hb = hbConn, extra = extraConns, ringParts = ringParts,
            destroyRing = destroyRingParts, setRange = function(r) state.range = r end,
            setVisual = function(v) state.visual = v end }
    end

    local function AP_Stop()
        if not AP.enabled then return end
        AP.enabled = false
        local conn = AP_CONN
        AP_CONN = nil
        if conn then
            if conn.hb then pcall(function() conn.hb:Disconnect() end) end
            if conn.extra then
                for _, c in ipairs(conn.extra) do pcall(function() c:Disconnect() end) end
            end
            if conn.destroyRing then pcall(conn.destroyRing) end
        end
        AP_state = nil
    end

    AddFeature("Auto Parry", {
        type = "toggle",
        default = false,
        callback = function(state)
            if state then AP_Start() else AP_Stop() end
        end,
        extra = {
            { type = "stepper", min = 5, max = 12, step = 1, default = 10,
              callback = function(v)
                  AP.range = v
                  if AP_state then AP_state.range = v end
              end },
            { type = "check", label = "Range Visual", default = true,
              callback = function(v)
                  AP.visual = v
                  if AP_state then AP_state.visual = v end
              end },
        },
    })

    Title("Auto Generator")
    -- ===== FITUR: Auto Generator =====
    -- Logic asli dari AUTO GENERATOR [ UDAH TESTING ].txt
    local AG = {
        enabled = false,
        mode = "PERFECT",
        scourgeMode = "INSTANT",
        cleanupFn = nil,
    }

    local AG_MODES = { "PERFECT", "NORMAL", "INSTANT" }
    local AG_SCOURGE_MODES = { "NORMAL", "INSTANT" }

    local function AG_Start()
        if AG.enabled then return end
        AG.enabled = true

        local SUCCESS_MIN = 102
        local SUCCESS_MAX = 116
        local NEUTRAL_MIN = 116
        local NEUTRAL_MAX = 159
        local INSTANT_ANGLE = 109
        local TriggerDelay = 0.035
        local LastTrigger = 0
        local SCOURGE_TIMEOUT = 15

        local Enabled = true
        local Mode = AG.mode
        local ScourgeMode = AG.scourgeMode

        local Alive = true
        local Connections = {}
        local Busy = false
        local ScourgeActive = false
        local ScourgeRound = 0
        local LastVisible = 0
        local PreviousVisible = false
        local Check, Line, Goal, Action = nil, nil, nil, nil

        local function Track(c) table.insert(Connections, c); return c end


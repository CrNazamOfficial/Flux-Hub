local INV_SCOPE = nil

Hub:Bind("Invisible", function(state, extras)
	if state then
		if INV_SCOPE then return end
		local S = newScope()
		INV_SCOPE = S

		local CONFIG = {
			InvisibleURL = "https://leekguy.vercel.app/roblox/menghub/crack_obf_invisible_93978595733734.lua",
			IndicatorImageIds = { "rbxassetid://133149347590039", "rbxassetid://77869394766337" },
			IndicatorSize = UDim2.new(3.5, 0, 3.5, 0),
			IndicatorOffset = Vector3.new(0, 1.5, 0),
			IndicatorFallbackText = "[ INVISIBLE ]",
			IndicatorTextColor = Color3.fromRGB(0, 0, 0),
			SurvivorTheme = {
				FillColor = Color3.fromRGB(240, 240, 240),
				FillTransparency = 0.75,
				OutlineColor = Color3.fromRGB(0, 0, 0),
				OutlineTransparency = 0,
				DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			},
		}
		local invisibleModule = nil
		local invisibleEnabled = false
		local busy = false
		local loading = false
		local resolvedIndicatorId = nil
		local resolvingIndicator = false

		local function testImageId(imageId)
			local probe = Instance.new("ImageLabel")
			probe.Image = imageId
			local success = false
			pcall(function()
				ContentProvider:PreloadAsync({probe}, function(_, status)
					if status == Enum.AssetFetchStatus.Success then success = true end
				end)
			end)
			probe:Destroy()
			return success
		end
		local function pickIndicatorImage()
			if resolvedIndicatorId ~= nil then return resolvedIndicatorId end
			if resolvingIndicator then return CONFIG.IndicatorImageIds[1] end
			resolvingIndicator = true
			local result = nil
			for _, id in ipairs(CONFIG.IndicatorImageIds) do
				if testImageId(id) then result = id; break end
			end
			resolvedIndicatorId = result or "TEXT"
			resolvingIndicator = false
			return resolvedIndicatorId
		end
		S:addThread(task.spawn(function() pickIndicatorImage() end))

		local function loadInvisible()
			if _G.MengHub and _G.MengHub.Invisible then invisibleModule = _G.MengHub.Invisible; return true end
			if loading then return false end
			loading = true
			local ok, err = pcall(function()
				local source = game:HttpGet(CONFIG.InvisibleURL)
				local loader = loadstring(source)
				assert(type(loader) == "function", "Loader tidak valid")
				loader()
			end)
			loading = false
			if _G.MengHub and _G.MengHub.Invisible then invisibleModule = _G.MengHub.Invisible; return true end
			if not ok then warn("[Invisible] Gagal memuat: " .. tostring(err)) end
			return false
		end
		local function setInvisible(st)
			if busy then return false end
			if not invisibleModule and not loadInvisible() then return false end
			busy = true
			local ok, err = pcall(function()
				if st then invisibleModule.enable() else invisibleModule.disable() end
			end)
			busy = false
			if ok then invisibleEnabled = st else warn("[Invisible] Error saat toggle: " .. tostring(err)) end
			return ok
		end

		local function processHighlight(hl)
			if hl:GetAttribute("NinjaPatched") then return end
			hl:SetAttribute("NinjaPatched", true)
			local function applyTheme()
				if hl.FillColor ~= CONFIG.SurvivorTheme.FillColor then hl.FillColor = CONFIG.SurvivorTheme.FillColor end
				if hl.FillTransparency ~= CONFIG.SurvivorTheme.FillTransparency then hl.FillTransparency = CONFIG.SurvivorTheme.FillTransparency end
				if hl.OutlineColor ~= CONFIG.SurvivorTheme.OutlineColor then hl.OutlineColor = CONFIG.SurvivorTheme.OutlineColor end
				if hl.OutlineTransparency ~= CONFIG.SurvivorTheme.OutlineTransparency then hl.OutlineTransparency = CONFIG.SurvivorTheme.OutlineTransparency end
				if hl.DepthMode ~= CONFIG.SurvivorTheme.DepthMode then hl.DepthMode = CONFIG.SurvivorTheme.DepthMode end
			end
			applyTheme()
			S:addConn(hl:GetPropertyChangedSignal("FillColor"):Connect(applyTheme))
			S:addConn(hl:GetPropertyChangedSignal("OutlineColor"):Connect(applyTheme))
			S:addConn(hl:GetPropertyChangedSignal("FillTransparency"):Connect(applyTheme))
			S:addConn(hl:GetPropertyChangedSignal("OutlineTransparency"):Connect(applyTheme))
		end
		local function createFallbackText(parent)
			if parent:FindFirstChild("CustomInvisibleText") then return end
			local txt = Instance.new("TextLabel")
			txt.Name = "CustomInvisibleText"
			txt.Size = UDim2.new(1, 0, 1, 0)
			txt.BackgroundTransparency = 1
			txt.Text = CONFIG.IndicatorFallbackText
			txt.TextColor3 = CONFIG.IndicatorTextColor
			txt.TextStrokeTransparency = 0
			txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
			txt.Font = Enum.Font.GothamBold
			txt.TextScaled = true
			txt.Parent = parent
		end
		local function processIndicator(gui)
			if gui:GetAttribute("NinjaPatched") then return end
			gui:SetAttribute("NinjaPatched", true)
			gui.Enabled = false
			local function killEye(child)
				if child.Name == "CustomInvisibleIcon" or child.Name == "CustomInvisibleText" then return end
				if child.Name == "EyeIcon" or child:IsA("ImageLabel") then
					if child:IsA("ImageLabel") or child:IsA("ImageButton") then
						child.Visible = false
						child.ImageTransparency = 1
					end
					child:Destroy()
				end
			end
			for _, child in ipairs(gui:GetChildren()) do killEye(child) end
			gui.ChildAdded:Connect(killEye)
			if not gui:FindFirstChild("CustomInvisibleIcon") and not gui:FindFirstChild("CustomInvisibleText") then
				local chosenId = resolvedIndicatorId
				if chosenId == nil then chosenId = CONFIG.IndicatorImageIds[1] end
				if chosenId == "TEXT" then createFallbackText(gui)
				else
					local icon = Instance.new("ImageLabel")
					icon.Name = "CustomInvisibleIcon"
					icon.Size = UDim2.new(1, 0, 1, 0)
					icon.BackgroundTransparency = 1
					icon.Image = chosenId
					icon.ScaleType = Enum.ScaleType.Fit
					icon.Parent = gui
					if resolvedIndicatorId == nil then
						task.spawn(function()
							local finalId = pickIndicatorImage()
							if not icon.Parent then return end
							if finalId == "TEXT" then icon:Destroy(); createFallbackText(gui)
							elseif finalId ~= icon.Image then icon.Image = finalId end
						end)
					end
				end
			end
			gui.Size = CONFIG.IndicatorSize
			gui.StudsOffsetWorldSpace = CONFIG.IndicatorOffset
			gui.StudsOffset = CONFIG.IndicatorOffset
			gui.Enabled = true
		end
		local function onDescendantAdded(obj)
			if not invisibleEnabled then return end
			if obj.Name == "MengHub_InvisibilityFX" and obj:IsA("Highlight") then processHighlight(obj)
			elseif obj.Name == "MengHub_InvisibilityIndicator" and obj:IsA("BillboardGui") then processIndicator(obj) end
		end
		local function renderGuard()
			if not invisibleEnabled or not LocalPlayer.Character then return end
			local char = LocalPlayer.Character
			local fx = char:FindFirstChild("MengHub_InvisibilityFX")
			if fx and not fx:GetAttribute("NinjaPatched") then processHighlight(fx) end
			local head = char:FindFirstChild("Head")
			if head then
				local indicator = head:FindFirstChild("MengHub_InvisibilityIndicator")
				if indicator and not indicator:GetAttribute("NinjaPatched") then processIndicator(indicator) end
			end
		end
		local function setupCharacter(char)
			if not char then return end
			S:addConn(char.DescendantAdded:Connect(onDescendantAdded))
			for _, obj in ipairs(char:GetDescendants()) do onDescendantAdded(obj) end
		end
		S:addConn(LocalPlayer.CharacterAdded:Connect(function(char) task.wait(0.1); setupCharacter(char) end))
		if LocalPlayer.Character then setupCharacter(LocalPlayer.Character) end
		S:addConn(RunService.RenderStepped:Connect(renderGuard))

		S:addThread(task.spawn(function() loadInvisible() end))
		setInvisible(true)

		S.extraCleanup = function()
			pcall(function() setInvisible(false) end)
		end
	else
		if INV_SCOPE then
			if INV_SCOPE.extraCleanup then pcall(INV_SCOPE.extraCleanup) end
			INV_SCOPE:cleanup()
			INV_SCOPE = nil
		end
	end
end)


		S.extraCleanup = function()
			isOn = false
			if healthConn then pcall(function() healthConn:Disconnect() end); healthConn = nil end
		end
	else
		if GM_SCOPE then
			if GM_SCOPE.extraCleanup then pcall(GM_SCOPE.extraCleanup) end
			GM_SCOPE:cleanup()
			GM_SCOPE = nil
		end
	end
end)

		end
		local function updateSelf()
			local char = LocalPlayer.Character
			if char ~= myChar then myChar = char; myRoot = nil; myHum = nil; losDirty = true end
			if not char then myAlive = false; return end
			if not (myRoot and myRoot.Parent) then myRoot = char:FindFirstChild("HumanoidRootPart") end
			if not (myHum and myHum.Parent) then myHum = char:FindFirstChildOfClass("Humanoid") end
			myAlive = (myRoot ~= nil) and (myHum ~= nil) and myHum.Health > 0

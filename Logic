		end
		local function ensureRing()
			local cam = workspace.CurrentCamera
			if not cam then return nil end
			if ringFolder and ringFolder.Parent == cam then return ringParts end
			destroyRingParts()
			local folder = Instance.new("Folder")
			folder.Name = "AP_Ring"
			folder.Parent = cam
			ringFolder = folder
			losDirty = true
			local segs = {}
			for i = 1, CONFIG.RING_SEGMENTS do
				local part = Instance.new("Part")
				part.Name = "Seg_" .. i
				part.Anchored = true; part.CanCollide = false; part.CanQuery = false; part.CanTouch = false
				part.CastShadow = false
				part.Material = Enum.Material.Neon
				part.Size = Vector3.new(1, CONFIG.RING_HEIGHT, CONFIG.RING_WIDTH)
				part.Color = COLOR_RING_IDLE
				part.Transparency = CONFIG.RING_TRANSPARENCY
				part.TopSurface = Enum.SurfaceType.Smooth
				part.BottomSurface = Enum.SurfaceType.Smooth
				part.Parent = folder
				segs[i] = part
			end
			ringParts = segs
			ringLastColor = nil
			return ringParts
		end
		local function getGroundDy()
			if not (myRoot and myRoot.Parent) then return nil end
			if not rayParams then
				rayParams = RaycastParams.new()
				rayParams.FilterType = Enum.RaycastFilterType.Exclude
				rayParams.RespectCanCollide = true
			end
			if rayChar ~= myChar then
				rayChar = myChar
				if myChar then rayParams.FilterDescendantsInstances = { myChar } else rayParams.FilterDescendantsInstances = {} end
			end
			local origin = myRoot.Position
			local ok, result = pcall(workspace.Raycast, workspace, origin, Vector3.new(0, -30, 0), rayParams)
			if ok and result then return (result.Position.Y + CONFIG.RING_GROUND_OFFSET) - origin.Y end
			local hip = myHum and myHum.HipHeight or 0
			if hip < 0.1 then hip = 2 end
			return -(hip + myRoot.Size.Y / 2) + CONFIG.RING_GROUND_OFFSET
		end
		local function updateRing(anyIn)
			if not (stateAP.visual and myRoot and myRoot.Parent and myAlive) then
				if ringFolder then ringFolder.Parent = nil end
				return
			end
			local parts = ensureRing()
			if not parts then return end
			if ringFolder.Parent ~= workspace.CurrentCamera then ringFolder.Parent = workspace.CurrentCamera end
			local range = stateAP.range
			local stepAng = (2 * math.pi) / CONFIG.RING_SEGMENTS
			local dy = getGroundDy() or 0
			local col = anyIn and COLOR_RING_ACTIVE or COLOR_RING_IDLE
			local baseY = myRoot.Position.Y + dy
			for i = 1, CONFIG.RING_SEGMENTS do
				local seg = parts[i]
				local a0 = (i - 1) * stepAng
				local a1 = a0 + stepAng * CONFIG.RING_DASH_RATIO
				local p0x = math.cos(a0) * range
				local p0z = math.sin(a0) * range
				local p1x = math.cos(a1) * range
				local p1z = math.sin(a1) * range
				local mx = (p0x + p1x) / 2
				local mz = (p0z + p1z) / 2
				local dx = p1x - p0x
				local dz = p1z - p0z
				local len = math.sqrt(dx * dx + dz * dz)
				if len < 0.001 then
					seg.Transparency = 1
				else
					local yaw = math.atan2(dz, dx)
					seg.Size = Vector3.new(len, CONFIG.RING_HEIGHT, CONFIG.RING_WIDTH)
					seg.CFrame = CFrame.new(myRoot.Position.X + mx, baseY, myRoot.Position.Z + mz) * CFrame.Angles(0, -yaw, 0)
					seg.Transparency = CONFIG.RING_TRANSPARENCY
				end
				if ringLastColor ~= col then seg.Color = col end
			end
			ringLastColor = col
		end

		S:addConn(Players.PlayerAdded:Connect(hookPlayer))
		S:addConn(Players.PlayerRemoving:Connect(unhookPlayer))
		for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end

		S:addThread(task.spawn(function()
			pcall(function()
				local remotes = ReplicatedStorage:WaitForChild("Remotes", 30)
				local items = remotes and remotes:WaitForChild("Items", 30)
				local folder = items and items:WaitForChild("Parrying Dagger", 30)
				local result = folder and folder:WaitForChild("parryResult", 30)
				if result and not shuttingDown then
					S:addConn(result.OnClientEvent:Connect(function(success, cooldown)
						local lf = lastFire
						if not lf then return end
						local t = os.clock()
						if t - lf.t > 3 then return end
						lastFire = nil
					end))
				end
			end)
		end))
		S:addThread(task.spawn(function()
			pcall(function()
				local remotes = ReplicatedStorage:WaitForChild("Remotes", 30)
				local attacksFolder = remotes and remotes:WaitForChild("Attacks", 30)
				local lunge = attacksFolder and attacksFolder:WaitForChild("Lunge", 30)
				if lunge and not shuttingDown and (lunge:IsA("RemoteEvent") or lunge:IsA("UnreliableRemoteEvent")) then
					S:addConn(lunge.OnClientEvent:Connect(onLungeRemote))
				end
			end)
		end))

		local lastPingT, lastScanT = 0, 0
		S:addConn(RunService.Heartbeat:Connect(function()
			local now = os.clock()
			updateSelf()
			if CONFIG.CHECK_LINE_OF_SIGHT and (losDirty or now - losFilterT >= CONFIG.LOS_FILTER_REFRESH) then rebuildLosFilter(now) end
			if now - lastPingT >= 0.5 then lastPingT = now; refreshPing() end
			if now - lastScanT >= 1 then
				lastScanT = now
				for _, d in pairs(charData) do if not d.isKiller then isKillerData(d) end end
			end
			for _, d in pairs(charData) do

    local function StandUpCleanly()
        local char = LocalPlayer.Character
        if not char then return end
        local inter = char:FindFirstChild("CheckInterractable")
        if not inter then
            local waited = 0
            while not inter and waited < 0.5 do
                task.wait(0.05); waited = waited + 0.05
                inter = char:FindFirstChild("CheckInterractable")
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hum and hum.Parent then
            local animator = hum:FindFirstChildOfClass("Animator")
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    local tName = (track.Name or ""):lower()
                    local tId = track.Animation and track.Animation.AnimationId or ""
                    if tId == REPAIR_ANIM_ID or tName:find("repair") or tName:find("fix")
                        or tName:find("work") or tName:find("interact") then
                        pcall(function() track:Stop(0) end)
                    end
                end
            end
            pcall(function() hum.AutoRotate = true end)
            if hum.WalkSpeed < 10 then pcall(function() hum.WalkSpeed = 16 end) end
            if hum.PlatformStand then pcall(function() hum.PlatformStand = false end) end
            if hum.Sit then pcall(function() hum.Sit = false end) end
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
        end
        if inter then
            for _ = 1, 2 do
                for _, attr in ipairs({
                    "isRepairing", "isHealing", "isVaulting", "isSliding",
                    "isUnhooking", "isExiting", "isDroppingPallet", "isCarrying", "isDowned"
                }) do
                    pcall(function() inter:SetAttribute(attr, false) end)
                end
                task.wait(0.05)
            end
        end
        if hrp and hrp.Parent then
            for _ = 1, 3 do
                pcall(function() hrp.Anchored = false end)
                pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
                pcall(function() hrp.AssemblyAngularVelocity = Vector3.zero end)
                task.wait(0.03)
            end
        end
        StopRepairAnim()
    end
    local function waitForRepairing(point, timeout)
        local start = tick()
        while tick() - start < (timeout or 1) do
            if not point or not point.Parent then return false end
            if point:GetAttribute("IsRepairing") == true then return true end
            task.wait(CONFIG.CONFIRM_POLL)
        end
        return false
    end

    local function SmoothMoveTo(targetCFrame, duration)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp or not hrp.Parent then return end
        local startCFrame = hrp.CFrame
        local elapsed = 0
        local hbConn
        local function step(dt)
            if not hrp or not hrp.Parent then
                if hbConn then hbConn:Disconnect() end
                return
            end
            elapsed = elapsed + dt
            local alpha = math.min(elapsed / duration, 1)
            hrp.CFrame = startCFrame:lerp(targetCFrame, alpha)
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
            if alpha >= 1 then
                if hbConn then hbConn:Disconnect() end
            end
        end
        hbConn = RunService.Heartbeat:Connect(step)
        while elapsed < duration do task.wait() end
        if hbConn then hbConn:Disconnect() end
    end


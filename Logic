local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local lp = Players.LocalPlayer

local SCENARIOS = {
    { triggerY = 229.1,  target = Vector3.new(132.3, 599.6, -3088.7) },
    { triggerY = 956.1,  target = Vector3.new(-874.9, 1358.6, -5560.9) },
    { triggerY = 1024.1, target = Vector3.new(-6940.3, 1352.3, -7211.2) },
}

local Y_TOLERANCE   = 8.0
local COOLDOWN      = 3.0
local RISE_HEIGHT   = 45
local RISE_TIME     = 0.18
local SHIFT_TIME    = 0.22
local RESTORE_DELAY = 0.35

local enabled       = false
local lastTeleport  = 0
local isTeleporting = false

local gui = Instance.new("ScreenGui")
gui.Name = "WoodTPToggle"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = game:GetService("CoreGui")

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 48, 0, 48)
btn.Position = UDim2.new(0, 30, 0, 200)
btn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
btn.BackgroundTransparency = 0.1
btn.BorderSizePixel = 0
btn.Text = "OFF"
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 13
btn.AutoButtonColor = false
btn.Active = true
btn.Parent = gui

Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

local stroke = Instance.new("UIStroke", btn)
stroke.Color = Color3.fromRGB(255, 255, 255)
stroke.Thickness = 2
stroke.Transparency = 0.4

local function updateVisual()
    if enabled then
        btn.BackgroundColor3 = Color3.fromRGB(60, 220, 120)
        btn.Text = "ON"
        stroke.Color = Color3.fromRGB(180, 255, 200)
    else
        btn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        btn.Text = "OFF"
        stroke.Color = Color3.fromRGB(255, 200, 200)
    end
end

local function toggle()
    enabled = not enabled
    updateVisual()
end

btn.MouseButton1Click:Connect(toggle)

local dragging, dragInput, dragStart, startPos

btn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = btn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

btn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        btn.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Q then toggle() end
end)

local function getHRP()
    local char = lp.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    return hrp, hum
end

local function getGroundInfo(hrp)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {lp.Character}
    params.IgnoreWater = false
    return Workspace:Raycast(hrp.Position, Vector3.new(0, -15, 0), params)
end

local function findMatchingScenario(yPos)
    local best, bestDiff = nil, math.huge
    for _, sc in ipairs(SCENARIOS) do
        local diff = math.abs(yPos - sc.triggerY)
        if diff <= Y_TOLERANCE and diff < bestDiff then
            best, bestDiff = sc, diff
        end
    end
    return best
end

local function spawnRiseEffect(position)
    local ring = Instance.new("Part")
    ring.Shape = Enum.PartType.Cylinder
    ring.Material = Enum.Material.SmoothPlastic
    ring.Color = Color3.fromRGB(0, 0, 0)
    ring.Size = Vector3.new(1, 6, 6)
    ring.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
    ring.Anchored = true
    ring.CanCollide = false
    ring.CanQuery = false
    ring.CanTouch = false
    ring.CastShadow = false
    ring.Transparency = 0.45
    ring.Parent = Workspace

    TweenService:Create(ring,
        TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = Vector3.new(1, 18, 18), Transparency = 1 }
    ):Play()

    task.delay(0.45, function()
        if ring then ring:Destroy() end
    end)
end

local function doTeleport(hrp, humanoid, targetPos)
    if isTeleporting then return end
    isTeleporting = true

    local startPos = hrp.Position

    humanoid.AutoRotate = false
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.JumpHeight = 0

    hrp.Anchored = true

    spawnRiseEffect(startPos)

    local skyPos = Vector3.new(startPos.X, startPos.Y + RISE_HEIGHT, startPos.Z)
    local riseTween = TweenService:Create(
        hrp,
        TweenInfo.new(RISE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { CFrame = CFrame.new(skyPos) }
    )
    riseTween:Play()
    riseTween.Completed:Wait()

    local destSky = Vector3.new(targetPos.X, targetPos.Y + RISE_HEIGHT, targetPos.Z)
    local shiftTween = TweenService:Create(
        hrp,
        TweenInfo.new(SHIFT_TIME, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        { CFrame = CFrame.new(destSky) }
    )
    shiftTween:Play()
    shiftTween.Completed:Wait()

    hrp.CFrame = CFrame.new(targetPos)
    spawnRiseEffect(targetPos)

    task.delay(RESTORE_DELAY, function()
        humanoid.WalkSpeed = 16
        humanoid.JumpPower = 50
        humanoid.JumpHeight = 7.2
        humanoid.AutoRotate = true
        isTeleporting = false
    end)
end

RunService.Heartbeat:Connect(function()
    if not enabled or isTeleporting then return end
    if tick() - lastTeleport < COOLDOWN then return end

    local hrp, hum = getHRP()
    if not hrp then return end

    local result = getGroundInfo(hrp)
    if not result then return end

    local mat = result.Material
    if mat ~= Enum.Material.Wood and mat ~= Enum.Material.WoodPlanks then return end

    local sc = findMatchingScenario(hrp.Position.Y)
    if not sc then return end

    lastTeleport = tick()
    doTeleport(hrp, hum, sc.target)
end)

lp.CharacterAdded:Connect(function(char)
    char:WaitForChild("HumanoidRootPart", 10)
    isTeleporting = false
    lastTeleport = 0
    task.wait(1)
end)

updateVisual()

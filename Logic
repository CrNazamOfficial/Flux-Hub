        end
        local function analyzeMotion(tr, now)
            local h = tr.hist
            local cutoff = now - CONFIG.ZIGZAG_WINDOW
            while #h > 0 and h[1].t < cutoff do table.remove(h, 1) end
            local n = #h
            if n < 4 or (h[n].t - h[1].t) < 0.2 then return nil, 1 end
            local t0, x0, z0 = h[1].t, h[1].x, h[1].z
            local st, stt, sx, stx, sz, stz = 0, 0, 0, 0, 0, 0
            for i = 1, n do
                local t = h[i].t - t0
                local x = h[i].x - x0
                local z = h[i].z - z0
                st = st + t; stt = stt + t * t
                sx = sx + x; stx = stx + t * x
                sz = sz + z; stz = stz + t * z
            end
            local D = n * stt - st * st
            if math.abs(D) < 1e-9 then return nil, 1 end
            local bx = (n * stx - st * sx) / D
            local ax = (sx - bx * st) / n
            local bz = (n * stz - st * sz) / D
            local az = (sz - bz * st) / n
            local sq = 0
            for i = 1, n do
                local t = h[i].t - t0
                local ex = (h[i].x - x0) - (ax + bx * t)
                local ez = (h[i].z - z0) - (az + bz * t)
                sq = sq + ex * ex + ez * ez
            end
            local rms = math.sqrt(sq / n)
            local span = math.max(CONFIG.ZIGZAG_FULL - CONFIG.ZIGZAG_DEADZONE, 0.01)
            local stable = math.clamp(1 - (rms - CONFIG.ZIGZAG_DEADZONE) / span, 0, 1)
            return Vector3.new(bx, 0, bz), stable
        end
        local function trackVelocity(root, now)
            local pos = root.Position
            local tr = tracker[root]
            if not tr then
                tr = { pos = pos, t = now, vel = Vector3.new(), hist = {}, pred = nil, stable = 1 }
                tracker[root] = tr
            end
            local jump = (pos - tr.pos).Magnitude
            if jump > 15 then
                tr.hist = { { t = now, x = pos.X, z = pos.Z } }
                tr.vel = Vector3.new(); tr.pred = nil; tr.stable = 1
                tr.pos = pos; tr.t = now
                return tr.vel
            end
            table.insert(tr.hist, { t = now, x = pos.X, z = pos.Z })
            tr.pred, tr.stable = analyzeMotion(tr, now)
            if jump < 0.001 then
                if now - tr.t > 0.15 then tr.vel = Vector3.new() end
                return tr.vel
            end
            local dt = now - tr.t
            if dt <= 0 or dt > 0.35 then tr.vel = Vector3.new()
            else
                local raw = (pos - tr.pos) / dt
                if raw.Magnitude > 180 then tr.vel = Vector3.new()
                else tr.vel = tr.vel:Lerp(raw, CONFIG.VELOCITY_SMOOTH) end
            end
            tr.pos = pos; tr.t = now
            return tr.vel
        end
        local function solveDirection(origin, speed, base, hv, g, lead)
            local t = (base - origin).Magnitude / speed
            local dirOut = nil
            local aimPos = base
            for _ = 1, 6 do
                aimPos = base + hv * (t + lead)
                local d = aimPos - origin
                local hd = Vector3.new(d.X, 0, d.Z)
                local x = hd.Magnitude
                local y = d.Y
                if x < 0.01 then
                    dirOut = Vector3.new(0, y >= 0 and 1 or -1, 0)
                    t = math.abs(y) / speed
                elseif g <= 0 then
                    dirOut = d.Unit
                    t = d.Magnitude / speed
                else
                    local v2 = speed * speed
                    local disc = v2 * v2 - g * (g * x * x + 2 * y * v2)
                    local theta
                    if disc >= 0 then theta = math.atan((v2 - math.sqrt(disc)) / (g * x))
                    else theta = math.rad(45) end
                    local hdir = hd / x
                    dirOut = hdir * math.cos(theta) + Vector3.new(0, math.sin(theta), 0)
                    local vx = speed * math.cos(theta)
                    if vx > 0.01 then t = x / vx end
                end
            end
            if not dirOut or dirOut.X ~= dirOut.X or dirOut.Y ~= dirOut.Y or dirOut.Z ~= dirOut.Z then
                return nil
            end
            return dirOut, aimPos
        end
        local function computeSpearDirection(args)

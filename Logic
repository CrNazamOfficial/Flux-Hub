    Title("World Setting")
    -- ===== FITUR: World Setting =====
    -- Logic asli dari World Setting[ UDAH TESTING ].txt
    -- OFF = restore lighting/sky ke state semula (snapshot)
    local WS = { enabled = false, cleanupFn = nil, snapshot = nil }

    local function WS_Snapshot()
        local snap = {
            Lighting = {
                Brightness = Lighting.Brightness,
                ClockTime = Lighting.ClockTime,
                ExposureCompensation = Lighting.ExposureCompensation,
                FogStart = Lighting.FogStart,
                FogEnd = Lighting.FogEnd,
                Ambient = Lighting.Ambient,
                OutdoorAmbient = Lighting.OutdoorAmbient,
            },
            Atmospheres = {},
            Skies = {},
        }
        for _, inst in ipairs(Lighting:GetChildren()) do
            if inst:IsA("Atmosphere") then
                table.insert(snap.Atmospheres, {
                    inst = inst,
                    Density = inst.Density,
                    Haze = inst.Haze,
                    Glare = inst.Glare,
                })
            elseif inst:IsA("Sky") then
                local skySnap = { inst = inst }
                for _, face in ipairs({ "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }) do
                    skySnap[face] = inst[face]
                end
                skySnap.CelestialBodiesShown = inst.CelestialBodiesShown
                skySnap.StarCount = inst.StarCount
                table.insert(snap.Skies, skySnap)
            end
        end
        return snap
    end

    local function WS_Restore(snap)
        if not snap then return end
        pcall(function()
            for k, v in pairs(snap.Lighting) do Lighting[k] = v end
        end)
        for _, at in ipairs(snap.Atmospheres) do
            if at.inst and at.inst.Parent then
                pcall(function()
                    at.inst.Density = at.Density
                    at.inst.Haze = at.Haze
                    at.inst.Glare = at.Glare
                end)
            end
        end
        for _, sky in ipairs(snap.Skies) do
            if sky.inst and sky.inst.Parent then
                pcall(function()
                    for _, face in ipairs({ "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }) do
                        sky.inst[face] = sky[face]
                    end
                    sky.inst.CelestialBodiesShown = sky.CelestialBodiesShown
                    sky.inst.StarCount = sky.StarCount
                end)
            end
        end
        -- Hapus own sky yang kita buat
        pcall(function()
            local own = Lighting:FindFirstChild("FullBrightSky")
            if own then own:Destroy() end
        end)
    end

    local function WS_Start()
        if WS.enabled then return end
        WS.enabled = true
        WS.snapshot = WS_Snapshot()

        local SKY_NAME = "FullBrightSky"
        local FACES = { "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }
        local SKY_TEX = {
            SkyboxBk = "rbxasset://textures/sky/sky512_bk.tex",
            SkyboxDn = "rbxasset://textures/sky/sky512_dn.tex",
            SkyboxFt = "rbxasset://textures/sky/sky512_ft.tex",
            SkyboxLf = "rbxasset://textures/sky/sky512_lf.tex",
            SkyboxRt = "rbxasset://textures/sky/sky512_rt.tex",
            SkyboxUp = "rbxasset://textures/sky/sky512_up.tex",
        }
        local BRIGHT = {
            Brightness = 2, ClockTime = 14, ExposureCompensation = 0,
            FogStart = 100000, FogEnd = 100000,
            Ambient = Color3.fromRGB(170, 170, 170),
            OutdoorAmbient = Color3.fromRGB(170, 170, 170),
        }

        local tracked = {}
        local globalConns = {}
        local ownSky = nil
        local heartbeatConn = nil
        local enforcing = false
        local alive = true

        local function enforce(sky)
            if enforcing then return end
            enforcing = true
            for _, face in ipairs(FACES) do
                pcall(function()
                    if sky[face] ~= SKY_TEX[face] then sky[face] = SKY_TEX[face] end
                end)
            end
            pcall(function()
                if sky.CelestialBodiesShown ~= false then sky.CelestialBodiesShown = false end
                if sky.StarCount ~= 0 then sky.StarCount = 0 end
            end)
            enforcing = false
        end
        local function enforceAll()
            for sky in pairs(tracked) do enforce(sky) end
        end
        local function enforceLighting()
            for prop, val in pairs(BRIGHT) do
                pcall(function()
                    if Lighting[prop] ~= val then Lighting[prop] = val end
                end)
            end
            pcall(function()
                for _, inst in ipairs(Lighting:GetChildren()) do
                    if inst:IsA("Atmosphere") then
                        if inst.Density ~= 0 then inst.Density = 0 end
                        if inst.Haze ~= 0 then inst.Haze = 0 end
                        if inst.Glare ~= 0 then inst.Glare = 0 end
                    end
                end
            end)
        end
        local function untrack(sky)
            local conns = tracked[sky]
            if conns then
                for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
                tracked[sky] = nil
            end
        end
        local function track(sky)
            if not alive or tracked[sky] then return end
            local conns = {}
            tracked[sky] = conns
            enforce(sky)
            for _, face in ipairs(FACES) do
                local ok, sig = pcall(function() return sky:GetPropertyChangedSignal(face) end)
                if ok and sig then
                    table.insert(conns, sig:Connect(function() enforce(sky) end))
                end
            end
            table.insert(conns, sky.AncestryChanged:Connect(function()
                if not sky:IsDescendantOf(game) then untrack(sky) end
            end))
        end
        local function ensureOwnSky()
            if ownSky == nil or ownSky.Parent ~= Lighting then
                if ownSky then untrack(ownSky); ownSky = nil end
                local existing = Lighting:FindFirstChild(SKY_NAME)
                if existing and existing:IsA("Sky") then ownSky = existing
                else
                    local s = Instance.new("Sky")
                    s.Name = SKY_NAME
                    pcall(function() s.Parent = Lighting end)
                    if s.Parent == Lighting then ownSky = s end
                end
            end
            if ownSky then track(ownSky) end
        end
        local function scan(root)
            local ok, list = pcall(function() return root:GetDescendants() end)
            if ok and list then
                for _, inst in ipairs(list) do
                    if inst:IsA("Sky") then track(inst) end
                end
            end
        end

        ensureOwnSky()
        scan(Lighting)
        scan(Workspace)
        enforceLighting()

        table.insert(globalConns, Lighting.DescendantAdded:Connect(function(inst)
            if inst:IsA("Sky") then track(inst) end
        end))
        table.insert(globalConns, Workspace.DescendantAdded:Connect(function(inst)
            if inst:IsA("Sky") then track(inst) end
        end))
        table.insert(globalConns, Lighting.ChildRemoved:Connect(function() ensureOwnSky() end))

        local elapsed = 0
        heartbeatConn = RunService.Heartbeat:Connect(function(dt)
            if not alive then return end
            pcall(function()
                ensureOwnSky()
                enforceAll()
                enforceLighting()
                elapsed = elapsed + dt
                if elapsed >= 2 then
                    elapsed = 0
                    scan(Lighting)
                end
            end)
        end)

        WS.cleanupFn = function()
            alive = false
            if heartbeatConn then pcall(function() heartbeatConn:Disconnect() end); heartbeatConn = nil end
            for _, c in ipairs(globalConns) do pcall(function() c:Disconnect() end) end
            globalConns = {}
            for sky in pairs(tracked) do untrack(sky) end
            if ownSky then pcall(function() ownSky:Destroy() end); ownSky = nil end
            if WS.snapshot then WS_Restore(WS.snapshot); WS.snapshot = nil end
        end
    end

    local function WS_Stop()
        if not WS.enabled then return end
        WS.enabled = false
        if WS.cleanupFn then pcall(WS.cleanupFn); WS.cleanupFn = nil end
    end


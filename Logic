-- Script Auto Skip Animasi Spesifik + Trigger Remote Skip
-- LocalScript di StarterPlayerScripts

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local SKIP_REMOTE_NAME = "JumpFlySkipRequest"
local TARGET_ANIM_ID = "98352002677627"

-- ==========================================
-- NOTIFIKASI STATUS ON
-- ==========================================
local function notify(text, color)
    local gui = Instance.new("ScreenGui")
    gui.Name = "SkipNotif_" .. tick()
    gui.ResetOnSpawn = false
    gui.Parent = player:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 300, 0, 45)
    frame.Position = UDim2.new(0.5, -150, 0, 20)
    frame.BackgroundColor3 = color or Color3.fromRGB(0, 170, 0)
    frame.BorderSizePixel = 0
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 1, 0)
    label.Position = UDim2.new(0, 5, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Parent = frame

    task.delay(2, function()
        if gui and gui.Parent then gui:Destroy() end
    end)
end

notify("✅ Status: ON - Auto Skip Aktif", Color3.fromRGB(0, 170, 0))

-- ==========================================
-- FUNGSI TRIGGER SKIP
-- ==========================================
local triggered = false

local function doSkip(track)
    if triggered then return end
    triggered = true

    -- 1. Stop animasi instan
    pcall(function() track:Stop(0) end)

    -- 2. Picu remote skip
    local remote = ReplicatedStorage:FindFirstChild(SKIP_REMOTE_NAME, true)
    if remote and remote:IsA("RemoteEvent") then
        pcall(function() remote:FireServer() end)
        print("[SKIP] Remote terkirim!")
    else
        warn("[SKIP] Remote '" .. SKIP_REMOTE_NAME .. "' tidak ditemukan!")
    end

    notify("⏭️ Animasi di-SKIP!", Color3.fromRGB(200, 50, 50))

    task.delay(0.3, function() triggered = false end)
end

-- ==========================================
-- DETEKSI ANIMASI (2 LAPIS BIAR CEPAT)
-- ==========================================
local function setup(character)
    local humanoid = character:WaitForChild("Humanoid")
    local animator = humanoid:WaitForChild("Animator")

    -- LAPIS 1: Event instan saat animasi baru diputar
    animator.AnimationPlayed:Connect(function(track)
        if track.Animation and string.find(track.Animation.AnimationId, TARGET_ANIM_ID) then
            task.defer(function() doSkip(track) end)
        end
    end)

    -- LAPIS 2: Polling cepat (jaga-jaga kalau event gak ke-trigger)
    task.spawn(function()
        while character.Parent do
            local tracks = animator:GetPlayingAnimationTracks()
            for _, track in ipairs(tracks) do
                if track.Animation and string.find(track.Animation.AnimationId, TARGET_ANIM_ID) then
                    doSkip(track)
                end
            end
            task.wait(0.05) -- 50ms = super cepat
        end
    end)
end

if player.Character then setup(player.Character) end
player.CharacterAdded:Connect(function(c)
    task.wait(0.5)
    setup(c)
end)

-- Script Auto Skip SEMUA Animasi (Super Cepat)
-- LocalScript di StarterPlayerScripts

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local SKIP_REMOTE_NAME = "JumpFlySkipRequest"

-- ==========================================
-- KONFIGURASI
-- ==========================================
local SKIP_ALL_ANIMATIONS = true        -- true = skip SEMUA animasi, false = hanya ID tertentu
local TARGET_ANIMATION_IDS = {          -- isi ID animasi spesifik kalau SKIP_ALL = false
    "98352002677627"
}
local USE_TELEPORT = false              -- true = teleport saat skip
local TELEPORT_CFRAME = CFrame.new(116.8, 599.6, -3102.1)
local COOLDOWN = 0.05                   -- jeda antar cek (super cepat, 50ms)

-- ==========================================
-- NOTIFIKASI STATUS ON
-- ==========================================
local function showNotification(text, color)
    local gui = Instance.new("ScreenGui")
    gui.Name = "SkipNotif_" .. tick()
    gui.ResetOnSpawn = false
    gui.Parent = player:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 280, 0, 45)
    frame.Position = UDim2.new(0.5, -140, 0, 20)
    frame.BackgroundColor3 = color or Color3.fromRGB(0, 170, 0)
    frame.BorderSizePixel = 0
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 1, 0)
    label.Position = UDim2.new(0, 5, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Parent = frame

    task.delay(2, function()
        if frame and frame.Parent then
            local TweenService = game:GetService("TweenService")
            TweenService:Create(frame, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
            TweenService:Create(label, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
            task.wait(0.5)
            if gui and gui.Parent then gui:Destroy() end
        end
    end)
end

showNotification("⚡ AUTO SKIP ON - Semua Animasi", Color3.fromRGB(0, 170, 0))

-- ==========================================
-- FUNGSI CEK ID
-- ==========================================
local function isTargetAnimation(animId)
    if SKIP_ALL_ANIMATIONS then return true end
    for _, id in ipairs(TARGET_ANIMATION_IDS) do
        if string.find(animId, id) then return true end
    end
    return false
end

-- ==========================================
-- LOGIKA SKIP
-- ==========================================
local skipCooldown = 0

local function skipAnimations(character, humanoid)
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then return end

    local tracks = animator:GetPlayingAnimationTracks()
    for _, track in ipairs(tracks) do
        if track.Animation and isTargetAnimation(track.Animation.AnimationId) then
            -- Stop instan
            pcall(function() track:Stop(0) end)
            pcall(function() track:Destroy() end) -- extra agresif

            -- Kirim remote skip
            local remote = ReplicatedStorage:FindFirstChild(SKIP_REMOTE_NAME, true)
            if remote and remote:IsA("RemoteEvent") then
                pcall(function() remote:FireServer() end)
            end

            -- Teleport opsional
            if USE_TELEPORT then
                local hrp = character:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.CFrame = TELEPORT_CFRAME end
            end

            showNotification("⏭️ SKIP! " .. track.Animation.AnimationId:match("%d+"), Color3.fromRGB(200, 50, 50))
            print("[AUTO-SKIP] Animation stopped:", track.Animation.AnimationId)
        end
    end
end

-- ==========================================
-- LOOP SUPER CEPAT (RenderStepped = tiap frame)
-- ==========================================
local function setup(character)
    local humanoid = character:WaitForChild("Humanoid")

    RunService.RenderStepped:Connect(function(dt)
        if not character.Parent then return end
        if humanoid.Health <= 0 then return end

        skipCooldown = skipCooldown - dt
        if skipCooldown <= 0 then
            skipCooldown = COOLDOWN
            skipAnimations(character, humanoid)
        end
    end)

    -- Fallback: pantau animasi baru via ChildAdded
    local animator = humanoid:WaitForChild("Animator")
    animator.AnimationPlayed:Connect(function(track)
        task.defer(function()
            if track.Animation and isTargetAnimation(track.Animation.AnimationId) then
                pcall(function() track:Stop(0) end)
                local remote = ReplicatedStorage:FindFirstChild(SKIP_REMOTE_NAME, true)
                if remote and remote:IsA("RemoteEvent") then
                    pcall(function() remote:FireServer() end)
                end
                showNotification("⏭️ SKIP! " .. track.Animation.AnimationId:match("%d+"), Color3.fromRGB(200, 50, 50))
            end
        end)
    end)
end

if player.Character then setup(player.Character) end
player.CharacterAdded:Connect(function(c)
    task.wait(0.5)
    setup(c)
end)

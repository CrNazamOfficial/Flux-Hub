local ENV = _G
pcall(function()
	if getgenv then ENV = getgenv() end
end)
if ENV.__AutoJumpTP_Cleanup then
	pcall(ENV.__AutoJumpTP_Cleanup)
	ENV.__AutoJumpTP_Cleanup = nil
end

local ZONES = {
	{ y = 229.1,  target = Vector3.new(132.3, 599.6, -3088.7) },
	{ y = 956.1,  target = Vector3.new(-874.9, 1358.6, -5560.9) },
	{ y = 1024.1, target = Vector3.new(-6940.3, 1352.3, -7211.2) },
}

local Y_EXACT = 0.12
local SPEED = 2000
local CRUISE_EXTRA = 150
local COOLDOWN = 0.5
local BUSY_TIMEOUT = 10
local GROUND_GRACE = 0.25
local TOGGLE_KEY = Enum.KeyCode.Q

local conns = {}
local charConns = {}
local alive = true
local enabled = false
local teleporting = false
local busySince = 0
local lastTeleportEnd = 0
local groundZone = nil
local groundTime = 0

local function track(c)
	conns[#conns + 1] = c
	return c
end

local PROTECT_STATES = {
	Enum.HumanoidStateType.FallingDown,
	Enum.HumanoidStateType.Ragdoll,
	Enum.HumanoidStateType.Physics,
}

local function getChar()
	local char = player.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid") or char:FindFirstChildWhichIsA("Humanoid", true)
	if not hum or hum.Health <= 0 then return nil end
	local root = char:FindFirstChild("HumanoidRootPart") or hum.RootPart or char.PrimaryPart
	if not root then return nil end
	return char, root, hum
end

local function feetOffset(root, hum)
	local o = 0
	pcall(function()
		o = hum.HipHeight + root.Size.Y / 2
	end)
	return o
end

local function floorY(char, root)
	local result = nil
	pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { char }
		local hit = workspace:Raycast(root.Position, Vector3.new(0, -12, 0), params)
		if hit then result = hit.Position.Y end
	end)
	return result
end

local function matchZone(char, root, hum)
	local y = root.Position.Y
	local refs = { y, y - feetOffset(root, hum) }
	local fy = floorY(char, root)
	if fy then refs[#refs + 1] = fy end
	local best = nil
	local bestDiff = math.huge
	for _, z in ipairs(ZONES) do
		for _, ry in ipairs(refs) do
			local diff = math.abs(ry - z.y)
			if diff <= Y_EXACT and diff < bestDiff then
				best = z
				bestDiff = diff
			end
		end
	end
	return best
end

local function isGrounded(hum)
	local ok, mat = pcall(function() return hum.FloorMaterial end)
	if ok and mat ~= Enum.Material.Air then return true end
	local ok2, st = pcall(function() return hum:GetState() end)
	if ok2 and (st == Enum.HumanoidStateType.Running
		or st == Enum.HumanoidStateType.RunningNoPhysics
		or st == Enum.HumanoidStateType.Landed) then
		return true
	end
	return false
end

local function protectBegin(char, hum)
	local g = { parts = {}, states = {}, conn = nil }
	local function guardPart(part)
		if g.parts[part] == nil then
			local old = true
			pcall(function() old = part.CanTouch end)
			g.parts[part] = old
		end
		pcall(function() part.CanTouch = false end)
	end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then guardPart(d) end
	end
	g.conn = char.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then guardPart(d) end
	end)
	for _, st in ipairs(PROTECT_STATES) do
		pcall(function()
			g.states[st] = hum:GetStateEnabled(st)
			hum:SetStateEnabled(st, false)
		end)
	end
	return g
end

local function protectEnd(g, hum)
	if not g then return end
	if g.conn then
		pcall(function() g.conn:Disconnect() end)
	end
	for part, old in pairs(g.parts) do
		pcall(function()
			if part and part.Parent then part.CanTouch = old end
		end)
	end
	if hum and hum.Parent then
		for st, old in pairs(g.states) do
			pcall(function() hum:SetStateEnabled(st, old) end)
		end
	end
end

local function doTeleport(zone)
	local char, root, hum = getChar()
	if not char then
		teleporting = false
		return
	end
	busySince = tick()

	local saved = {}
	local oldAutoRotate = true
	pcall(function() oldAutoRotate = hum.AutoRotate end)

	local guard = nil
	pcall(function() guard = protectBegin(char, hum) end)

	local function zeroVel()
		pcall(function()
			root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		end)
	end

	pcall(function()
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(saved, { part = d, collide = d.CanCollide })
				pcall(function() d.CanCollide = false end)
			end
		end
		hum.AutoRotate = false
		hum.PlatformStand = true

		local rot = root.CFrame.Rotation
		local p0 = root.Position
		local target = zone.target
		local cruise = math.max(p0.Y, target.Y) + CRUISE_EXTRA

		local waypoints = {
			Vector3.new(p0.X, cruise, p0.Z),
			Vector3.new(target.X, cruise, target.Z),
			target,
		}

		local current = p0
		for _, wp in ipairs(waypoints) do
			while true do
				if not alive or not root.Parent or char ~= player.Character or hum.Health <= 0 then
					error("aborted")
				end
				local diff = wp - current
				local dist = diff.Magnitude
				if dist < 0.05 then
					current = wp
					root.CFrame = CFrame.new(current) * rot
					zeroVel()
					break
				end
				local dt = RunService.Heartbeat:Wait()
				if dt > 0.1 then dt = 0.1 end
				local step = SPEED * dt
				if step >= dist then
					current = wp
				else
					current = current + diff.Unit * step
				end
				root.CFrame = CFrame.new(current) * rot
				zeroVel()
				if current == wp then break end
			end
		end

		for _ = 1, 5 do
			root.CFrame = CFrame.new(target) * rot
			zeroVel()
			RunService.Heartbeat:Wait()
		end
	end)

	pcall(function()
		for _, e in ipairs(saved) do
			if e.part and e.part.Parent then
				e.part.CanCollide = e.collide
			end
		end
	end)
	pcall(function()
		if hum and hum.Parent then
			hum.PlatformStand = false
			hum.AutoRotate = oldAutoRotate
			hum.Jump = false
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
	zeroVel()
	pcall(function() protectEnd(guard, hum) end)

	groundZone = nil
	groundTime = 0
	lastTeleportEnd = tick()
	teleporting = false
end

local function tryJump()
	if not alive or not enabled or teleporting then return end
	local now = tick()
	if (now - lastTeleportEnd) < COOLDOWN then return end
	local char, root, hum = getChar()
	if not char then return end

	local zone = nil
	if isGrounded(hum) then
		zone = matchZone(char, root, hum)
	end
	if not zone and groundZone and (now - groundTime) <= GROUND_GRACE then
		zone = groundZone
	end
	if not zone then return end

	teleporting = true
	busySince = now
	groundZone = nil
	task.spawn(doTeleport, zone)
end

track(RunService.Heartbeat:Connect(function()
	local now = tick()
	if teleporting and (now - busySince) > BUSY_TIMEOUT then
		teleporting = false
	end
	if not enabled or teleporting then
		groundZone = nil
		return
	end
	local char, root, hum = getChar()
	if not char then
		groundZone = nil
		return
	end
	if isGrounded(hum) then
		local z = matchZone(char, root, hum)
		if z then
			groundZone = z
			groundTime = now
		else
			groundZone = nil
		end
	end
end))

local function clearCharConns()
	for _, c in ipairs(charConns) do
		pcall(function() c:Disconnect() end)
	end
	charConns = {}
end

local function hookChar(char)
	clearCharConns()
	task.spawn(function()
		local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
		if not hum or not alive or player.Character ~= char then return end
		charConns[#charConns + 1] = hum.StateChanged:Connect(function(_, new)
			if new == Enum.HumanoidStateType.Jumping then
				tryJump()
			end
		end)
		charConns[#charConns + 1] = hum:GetPropertyChangedSignal("Jump"):Connect(function()
			if hum.Jump then tryJump() end
		end)
	end)
end

track(player.CharacterAdded:Connect(function(char)
	teleporting = false
	groundZone = nil
	hookChar(char)
end))
if player.Character then
	hookChar(player.Character)
end

track(UserInputService.JumpRequest:Connect(function()
	tryJump()
end))

local GUI_NAME = "AutoJumpTPGui"
local function getGuiParent()
	local ok, h = pcall(function()
		if gethui then return gethui() end
		return nil
	end)
	if ok and h then return h end
	local ok2 = pcall(function() return CoreGui.Name end)
	if ok2 then return CoreGui end
	return player:WaitForChild("PlayerGui")
end

local parent = getGuiParent()
pcall(function()
	local old = parent:FindFirstChild(GUI_NAME)
	if old then old:Destroy() end
end)

local gui = Instance.new("ScreenGui")
gui.Name = GUI_NAME
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 999
gui.Parent = parent

local btn = Instance.new("TextButton")
btn.Name = "Toggle"
btn.Size = UDim2.new(0, 50, 0, 50)
btn.Position = UDim2.new(0, 20, 0, 200)
btn.AutoButtonColor = false
btn.Text = "Off"
btn.Font = Enum.Font.GothamBold
btn.TextSize = 15
btn.Active = true
btn.Selectable = false
btn.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = btn

local stroke = Instance.new("UIStroke")
stroke.Thickness = 2
stroke.Parent = btn

local function refresh()
	if enabled then
		btn.Text = "On"
		btn.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
		btn.BackgroundTransparency = 0.1
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		stroke.Color = Color3.fromRGB(120, 255, 170)
	else
		btn.Text = "Off"
		btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		btn.BackgroundTransparency = 0.5
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		stroke.Color = Color3.fromRGB(255, 255, 255)
	end
end
refresh()

local function setEnabled(v)
	enabled = v
	groundZone = nil
	lastTeleportEnd = 0
	refresh()
end

local function clampXY(x, y)
	local s = gui.AbsoluteSize
	local b = btn.AbsoluteSize
	return math.clamp(x, 0, math.max(0, s.X - b.X)), math.clamp(y, 0, math.max(0, s.Y - b.Y))
end

local function setPos(x, y)
	local cx, cy = clampXY(x, y)
	btn.Position = UDim2.new(0, cx, 0, cy)
end

do
	local abs = btn.AbsolutePosition - gui.AbsolutePosition
	setPos(abs.X, abs.Y)
end

track(gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	local abs = btn.AbsolutePosition - gui.AbsolutePosition
	setPos(abs.X, abs.Y)
end))

local dragging = false
local dragMoved = false
local dragInput = nil
local pressPos = nil
local btnStartX = 0
local btnStartY = 0

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function finishDrag()
	if not dragging then return end
	dragging = false
	dragInput = nil
	local moved = dragMoved
	dragMoved = false
	if not moved then
		setEnabled(not enabled)
	end
end

track(btn.InputBegan:Connect(function(input)
	if isPress(input) and not dragging then
		dragging = true
		dragMoved = false
		dragInput = input
		pressPos = Vector2.new(input.Position.X, input.Position.Y)
		local abs = btn.AbsolutePosition - gui.AbsolutePosition
		btnStartX = abs.X
		btnStartY = abs.Y
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End and dragInput == input then
				finishDrag()
			end
		end)
	end
end))

track(UserInputService.InputChanged:Connect(function(input)
	if not dragging or not dragInput then return end
	local isMouse = dragInput.UserInputType == Enum.UserInputType.MouseButton1
		and input.UserInputType == Enum.UserInputType.MouseMovement
	local isTouch = dragInput.UserInputType == Enum.UserInputType.Touch
		and input == dragInput
	if not (isMouse or isTouch) then return end

	local cur = Vector2.new(input.Position.X, input.Position.Y)
	local delta = cur - pressPos
	if not dragMoved and delta.Magnitude > 8 then
		dragMoved = true
	end
	if dragMoved then
		setPos(btnStartX + delta.X, btnStartY + delta.Y)
	end
end))

track(UserInputService.InputEnded:Connect(function(input)
	if not dragging or not dragInput then return end
	if input == dragInput
		or (dragInput.UserInputType == Enum.UserInputType.MouseButton1
			and input.UserInputType == Enum.UserInputType.MouseButton1) then
		finishDrag()
	end
end))

track(UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if UserInputService:GetFocusedTextBox() then return end
	if input.KeyCode == TOGGLE_KEY then
		setEnabled(not enabled)
	elseif input.KeyCode == Enum.KeyCode.Space then
		tryJump()
	end
end))

ENV.__AutoJumpTP_Cleanup = function()
	alive = false
	enabled = false
	for _, c in ipairs(conns) do
		pcall(function() c:Disconnect() end)
	end
	conns = {}
	clearCharConns()
	pcall(function() gui:Destroy() end)
end

-- DRAG ENGINE
local function isPressInput(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function pointerOf(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		return Vector2.new(input.Position.X, input.Position.Y)
	end
	return UserInputService:GetMouseLocation()
end

local function dragSize(cfg)
	local s = cfg.Size
	if type(s) == "function" then
		local ok, r = pcall(s)
		if ok then s = r else s = nil end
	end
	if typeof(s) ~= "Vector2" then s = cfg.Target.AbsoluteSize end
	return s
end

local function clampToScreen(cfg, x, y)
	local vp = viewportSize()
	local s = dragSize(cfg)
	return math.clamp(x, 0, math.max(vp.X - s.X, 0)), math.clamp(y, 0, math.max(vp.Y - s.Y, 0))
end

local reclampFns = {}
reclampAll = function()
	for _, fn in ipairs(reclampFns) do pcall(fn) end
end

local function makeDrag(cfg)
	local target = cfg.Target
	local threshold = cfg.Threshold or 5
	local smooth = cfg.Smooth
	local active = nil
	local moved, exceeded = false, false
	local startPointer = Vector2.new(0, 0)
	local startPos = Vector2.new(0, 0)
	local curX, curY, tgtX, tgtY = 0, 0, 0, 0
	local stepConn, changedConn = nil, nil

	local function setPos(x, y) target.Position = UDim2.fromOffset(x, y) end
	local function stopStep()
		if stepConn then stepConn:Disconnect(); stepConn = nil end
	end

	local function finish(cancelled)
		if not active then return end
		active = nil
		if changedConn then changedConn:Disconnect(); changedConn = nil end
		if moved then
			if cfg.OnDragEnd then safeCall(cfg.OnDragEnd, tgtX, tgtY) end
			if not smooth then
				setPos(tgtX, tgtY)
				moved = false
				stopStep()
			end
		else
			stopStep()
			if not exceeded and not cancelled and cfg.OnTap then safeCall(cfg.OnTap) end
		end
	end

	local function step(dt)
		if closing or not target.Parent then
			active = nil
			moved = false
			stopStep()
			return
		end
		if active then
			local st = active.UserInputState
			if st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel then
				finish(st == Enum.UserInputState.Cancel)
			elseif active.UserInputType == Enum.UserInputType.MouseButton1 and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
				finish(false)
			end
		end
		if active then
			local d = pointerOf(active) - startPointer
			if d.Magnitude >= threshold then
				exceeded = true
				if not moved and (not cfg.CanDrag or cfg.CanDrag()) then
					moved = true
					if cfg.OnDragStart then safeCall(cfg.OnDragStart) end
				end
			end
			if moved then
				tgtX, tgtY = clampToScreen(cfg, startPos.X + d.X, startPos.Y + d.Y)
			end
		end
		if moved then
			if smooth then
				local alpha = 1 - math.exp(-dt * smooth)
				curX = curX + (tgtX - curX) * alpha
				curY = curY + (tgtY - curY) * alpha
				if not active and math.abs(tgtX - curX) < 0.3 and math.abs(tgtY - curY) < 0.3 then
					curX, curY = tgtX, tgtY
					setPos(curX, curY)
					moved = false
					stopStep()
					return
				end
				setPos(curX, curY)
			else
				setPos(tgtX, tgtY)
			end
		end
	end

	local function onBegan(input)
		if closing or active or not isPressInput(input) or not target.Parent then return end
		active = input
		moved, exceeded = false, false
		startPointer = pointerOf(input)
		startPos = Vector2.new(target.Position.X.Offset, target.Position.Y.Offset)
		curX, curY = startPos.X, startPos.Y
		tgtX, tgtY = curX, curY
		if changedConn then changedConn:Disconnect(); changedConn = nil end
		changedConn = input.Changed:Connect(function()
			local st = input.UserInputState
			if (st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel) and active == input then
				finish(st == Enum.UserInputState.Cancel)
			end
		end)
		if not stepConn then stepConn = RunService.RenderStepped:Connect(step) end
	end

	for _, handle in ipairs(cfg.Handles) do
		track(handle.InputBegan:Connect(onBegan))
	end
	reclampFns[#reclampFns + 1] = function()
		if active or moved or not target.Parent then return end
		local x, y = clampToScreen(cfg, target.Position.X.Offset, target.Position.Y.Offset)
		setPos(x, y)
	end
	return {}
end


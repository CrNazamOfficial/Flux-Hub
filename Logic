-- AUTO SKIP + AUTO FACE FORWARD | Toggle drag
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local lp = Players.LocalPlayer
local remote = RS:WaitForChild("JumpFlySkipRequest", 10)

-- SETTING
local HEIGHT_JUMP_LIMIT = 6   -- selisih tinggi per frame yang dianggap tidak wajar
local SKIP_COOLDOWN = 0.05    -- jeda antar skip (detik)

local enabled = false
local pending = false   -- ada perubahan tinggi aneh, menunggu mendarat
local locked = false    -- sedang kunci hadap depan
local lastY, lastSkip = nil, 0

---------------------------------------------------------------- UI
local parent = (gethui and gethui()) or game:GetService("CoreGui")
pcall(function()
    if parent == nil then parent = lp:WaitForChild("PlayerGui") end
end)

local old = parent:FindFirstChild("AutoSkipToggleGui")
if old then old:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "AutoSkipToggleGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 999
gui.Parent = parent

local btn = Instance.new("TextButton")
btn.Size = UDim2.fromOffset(54, 54)
btn.Position = UDim2.new(0, 20, 0.5, 0)
btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
btn.TextColor3 = Color3.new(1, 1, 1)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 14
btn.Text = "OFF"
btn.AutoButtonColor = false
btn.Parent = gui
Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
local stroke = Instance.new("UIStroke", btn)
stroke.Thickness = 2
stroke.Color = Color3.new(1, 1, 1)

local function release()
    locked = false
    pending = false
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = true end
end

local function setState(v)
    enabled = v
    btn.Text = v and "ON" or "OFF"
    btn.BackgroundColor3 = v and Color3.fromRGB(40, 170, 80) or Color3.fromRGB(200, 50, 50)
    if not v then release() end
end

-- drag + klik
local dragging, dragStart, startPos, moved = false, nil, nil, false
btn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging, moved = true, false
        dragStart = input.Position
        startPos = btn.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - dragStart
        if d.Magnitude > 6 then moved = true end
        if moved then
            btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                     startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end
end)
UIS.InputEnded:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch) then
        dragging = false
        if not moved then setState(not enabled) end
    end
end)

---------------------------------------------------------------- AUTO SKIP
local function isShown(obj)
    local o = obj
    while o and o ~= lp.PlayerGui do
        if o:IsA("GuiObject") and not o.Visible then return false end
        if o:IsA("ScreenGui") and not o.Enabled then return false end
        o = o.Parent
    end
    return true
end

local function trySkip()
    local pg = lp:FindFirstChild("PlayerGui")
    local sg = pg and pg:FindFirstChild("JumpFlySkipGui")
    local sb = sg and sg:FindFirstChild("SkipButton", true)
    if sb and isShown(sb) and remote then
        pcall(function() remote:FireServer() end)
    end
end

---------------------------------------------------------------- AUTO HADAP DEPAN
-- user gerak / loncat = lepas kunci
UIS.JumpRequest:Connect(function()
    if enabled then release() end
end)

local function flatLook()
    local cam = workspace.CurrentCamera
    local look = cam.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 0.01 then return nil end
    return flat.Unit
end

RunService.Heartbeat:Connect(function(dt)
    if not enabled then return end

    -- skip super cepat
    local now = os.clock()
    if now - lastSkip >= SKIP_COOLDOWN then
        lastSkip = now
        trySkip()
    end

    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root) then lastY = nil return end

    local y = root.Position.Y
    if lastY then
        local dy = math.abs(y - lastY)
        local expected = math.abs(root.AssemblyLinearVelocity.Y) * dt * 2 + HEIGHT_JUMP_LIMIT
        if dy > expected then
            pending = true -- perubahan tinggi tidak wajar
        end
    end
    lastY = y

    local state = hum:GetState()
    local inAir = state == Enum.HumanoidStateType.Jumping
        or state == Enum.HumanoidStateType.Freefall
        or state == Enum.HumanoidStateType.Flying

    -- user menggerakkan karakter = normal lagi
    if hum.MoveDirection.Magnitude > 0.1 then
        if locked or pending then release() end
        return
    end

    -- aktifkan kunci hanya saat sudah mendarat (bukan animasi loncat)
    if pending and not inAir then
        pending = false
        locked = true
        hum.AutoRotate = false
    end

    if locked and not inAir then
        local dir = flatLook()
        if dir then
            root.CFrame = CFrame.new(root.Position, root.Position + dir)
        end
    end
end)

lp.CharacterAdded:Connect(function()
    lastY = nil
    locked, pending = false, false
end)

		local COLOR_ON = AP_CFG.color
		local COLOR_RING_IDLE = AP_CFG.color
		local COLOR_RING_ACTIVE = AP_CFG.color
		local MAX_ORDER = 2147483647

		local stateAP = { enabled = true, range = AP_CFG.range, visual = AP_CFG.rangeVisual }
		local shuttingDown = false
		local playerConns = {}
		local charData = {}

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer

local ENV = _G
pcall(function()
	if getgenv then ENV = getgenv() end
end)
if ENV.__AutoJumpTP_Cleanup then
	pcall(ENV.__AutoJumpTP_Cleanup)
	ENV.__AutoJumpTP_Cleanup = nil
end

local ZONES = {
	{ y = 229.1,  target = Vector3.new(132.3, 599.6, -3088.7) },
	{ y = 956.1,  target = Vector3.new(-874.9, 1358.6, -5560.9) },
	{ y = 1024.1, target = Vector3.new(-6940.3, 1352.3, -7211.2) },
}

local Y_EXACT = 0.06
local GROUND_MEMORY = 0.4
local Y_LOW_SLACK = 2
local JUMP_ARC = 40
local MAX_DRIFT = 25
local JUMP_COUNT_NEEDED = 3
local JUMP_MIN_GAP = 0.1
local JUMP_MAX_GAP = 0.7
local PROTECT_LOW = 6
local PROTECT_HIGH = 30
local SPEED = 2000
local CRUISE_EXTRA = 150
local COOLDOWN = 0.5
local BUSY_TIMEOUT = 10

local conns = {}
local function track(c)
	conns[#conns + 1] = c
	return c
end

local enabled = false
local teleporting = false
local busySince = 0
local lockedZone = nil
local startPos = nil
local jumpCount = 0
local lastJump = 0
local lastTeleportEnd = 0
local groundY = nil
local groundT = 0

local protectOn = false
local protectOrig = {}
local protectConn = nil
local protectChar = nil
local protectHum = nil
local stateOrig = {}

local PROTECT_STATES = {
	Enum.HumanoidStateType.FallingDown,
	Enum.HumanoidStateType.Ragdoll,
	Enum.HumanoidStateType.Physics,
}

local function resetCounter()
	lockedZone = nil
	startPos = nil
	jumpCount = 0
	lastJump = 0
end

local function getChar()
	local char = player.Character
	if not char then return nil end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return nil end
	if hum.Health <= 0 then return nil end
	return char, root, hum
end

local function guardPart(part)
	if protectOrig[part] == nil then
		local old = true
		pcall(function() old = part.CanTouch end)
		protectOrig[part] = old
	end
	pcall(function() part.CanTouch = false end)
end

local function dropProtect()
	protectOn = false
	if protectConn then
		pcall(function() protectConn:Disconnect() end)
		protectConn = nil
	end
	protectOrig = {}
	stateOrig = {}
	protectChar = nil
	protectHum = nil
end

local function setProtect(on)
	if on == protectOn then return end
	if on then
		local char, _, hum = getChar()
		if not char then return end
		protectOn = true
		protectChar = char
		protectHum = hum
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then guardPart(d) end
		end
		protectConn = char.DescendantAdded:Connect(function(d)
			if protectOn and d:IsA("BasePart") then guardPart(d) end
		end)
		for _, st in ipairs(PROTECT_STATES) do
			pcall(function()
				stateOrig[st] = hum:GetStateEnabled(st)
				hum:SetStateEnabled(st, false)
			end)
		end
	else
		local hum = protectHum
		for part, old in pairs(protectOrig) do
			pcall(function()
				if part and part.Parent then part.CanTouch = old end
			end)
		end
		if hum and hum.Parent then
			for st, old in pairs(stateOrig) do
				pcall(function() hum:SetStateEnabled(st, old) end)
			end
		end
		dropProtect()
	end
end

local function inProtectZone(y)
	for _, z in ipairs(ZONES) do
		if y >= z.y - PROTECT_LOW and y <= z.y + PROTECT_HIGH then
			return true
		end
	end
	return false
end

track(RunService.Heartbeat:Connect(function()
	local char, root, hum = getChar()
	if not char then
		if protectOn then dropProtect() end
		return
	end

	if protectOn and protectChar ~= char then
		dropProtect()
	end

	if not teleporting then
		local grounded = false
		pcall(function()
			grounded = hum.FloorMaterial ~= Enum.Material.Air
		end)
		if grounded then
			groundY = root.Position.Y
			groundT = tick()
		end
	end

	if not enabled then
		if protectOn and not teleporting then setProtect(false) end
		return
	end

	setProtect(teleporting or inProtectZone(root.Position.Y))

	if jumpCount > 0 and (tick() - lastJump) > JUMP_MAX_GAP then
		resetCounter()
	end
end))

local function doTeleport(zone)
	local char, root, hum = getChar()
	if not char then
		teleporting = false
		return
	end
	busySince = tick()
	pcall(function() setProtect(true) end)

	local saved = {}

	local function zeroVel()
		pcall(function()
			root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		end)
	end

	pcall(function()
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(saved, { part = d, collide = d.CanCollide })
				pcall(function() d.CanCollide = false end)
			end
		end
		hum.PlatformStand = true

		local rot = root.CFrame.Rotation
		local p0 = root.Position
		local target = zone.target
		local cruise = math.max(p0.Y, target.Y) + CRUISE_EXTRA

		local waypoints = {
			Vector3.new(p0.X, cruise, p0.Z),
			Vector3.new(target.X, cruise, target.Z),
			target,
		}

		local current = p0
		for _, wp in ipairs(waypoints) do
			while true do
				if not root.Parent or char ~= player.Character or hum.Health <= 0 then
					error("aborted")
				end
				local diff = wp - current
				local dist = diff.Magnitude
				if dist < 0.05 then
					current = wp
					root.CFrame = CFrame.new(current) * rot
					zeroVel()
					break
				end
				local dt = RunService.Heartbeat:Wait()
				if dt > 0.1 then dt = 0.1 end
				local step = SPEED * dt
				if step >= dist then
					current = wp
				else
					current = current + diff.Unit * step
				end
				root.CFrame = CFrame.new(current) * rot
				zeroVel()
				if current == wp then break end
			end
		end

		for _ = 1, 3 do
			root.CFrame = CFrame.new(target) * rot
			zeroVel()
			RunService.Heartbeat:Wait()
		end
	end)

	pcall(function()
		for _, e in ipairs(saved) do
			if e.part and e.part.Parent then
				e.part.CanCollide = e.collide
			end
		end
	end)
	pcall(function()
		if hum and hum.Parent then
			hum.PlatformStand = false
			hum.Jump = false
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
	zeroVel()

	groundY = nil
	groundT = 0
	resetCounter()
	lastTeleportEnd = tick()
	teleporting = false
	if not enabled then
		pcall(function() setProtect(false) end)
	end
end

local function onJump()
	if not enabled then return end
	local now = tick()

	if teleporting then
		if now - busySince > BUSY_TIMEOUT then
			teleporting = false
		else
			return
		end
	end

	if now - lastTeleportEnd < COOLDOWN then return end

	local char, root = getChar()
	if not char then
		resetCounter()
		return
	end
	local pos = root.Position

	if jumpCount > 0 and lockedZone and startPos then
		local gap = now - lastJump
		if gap < JUMP_MIN_GAP then return end

		local dx = pos.X - startPos.X
		local dz = pos.Z - startPos.Z
		local flat = math.sqrt(dx * dx + dz * dz)
		local valid = gap <= JUMP_MAX_GAP
			and pos.Y >= lockedZone.y - Y_LOW_SLACK
			and pos.Y <= lockedZone.y + JUMP_ARC
			and flat <= MAX_DRIFT

		if valid then
			jumpCount = jumpCount + 1
			lastJump = now
			if jumpCount >= JUMP_COUNT_NEEDED then
				local zone = lockedZone
				resetCounter()
				teleporting = true
				busySince = now
				task.spawn(doTeleport, zone)
			end
			return
		end
		resetCounter()
	end

	local refs = { pos.Y }
	if groundY and (now - groundT) <= GROUND_MEMORY then
		refs[#refs + 1] = groundY
	end

	local best = nil
	local bestDiff = math.huge
	for _, z in ipairs(ZONES) do
		for _, ry in ipairs(refs) do
			local diff = math.abs(ry - z.y)
			if diff <= Y_EXACT and diff < bestDiff then
				best = z
				bestDiff = diff
			end
		end
	end
	if not best then return end

	lockedZone = best
	startPos = pos
	jumpCount = 1
	lastJump = now
end

track(UserInputService.JumpRequest:Connect(onJump))

track(UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.Space then
		onJump()
	end
end))

track(player.CharacterAdded:Connect(function()
	teleporting = false
	groundY = nil
	groundT = 0
	resetCounter()
	dropProtect()
end))

local GUI_NAME = "AutoJumpTPGui"
local function getGuiParent()
	local ok, h = pcall(function()
		if gethui then return gethui() end
		return nil
	end)
	if ok and h then return h end
	local ok2 = pcall(function() return CoreGui.Name end)
	if ok2 then return CoreGui end
	return player:WaitForChild("PlayerGui")
end

local parent = getGuiParent()
pcall(function()
	local old = parent:FindFirstChild(GUI_NAME)
	if old then old:Destroy() end
end)

local gui = Instance.new("ScreenGui")
gui.Name = GUI_NAME
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 999
gui.Parent = parent

local btn = Instance.new("TextButton")
btn.Name = "Toggle"
btn.Size = UDim2.new(0, 50, 0, 50)
btn.Position = UDim2.new(0, 20, 0, 200)
btn.AutoButtonColor = false
btn.Text = "Off"
btn.Font = Enum.Font.GothamBold
btn.TextSize = 15
btn.Active = true
btn.Selectable = false
btn.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = btn

local stroke = Instance.new("UIStroke")
stroke.Thickness = 2
stroke.Parent = btn

local function refresh()
	if enabled then
		btn.Text = "On"
		btn.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
		btn.BackgroundTransparency = 0.1
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		stroke.Color = Color3.fromRGB(120, 255, 170)
	else
		btn.Text = "Off"
		btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		btn.BackgroundTransparency = 0.5
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		stroke.Color = Color3.fromRGB(255, 255, 255)
	end
end
refresh()

local function setEnabled(v)
	enabled = v
	resetCounter()
	lastTeleportEnd = 0
	if enabled then
		if teleporting and (tick() - busySince) > 3 then
			teleporting = false
		end
	else
		if not teleporting then
			pcall(function() setProtect(false) end)
		end
	end
	refresh()
end

local function clampXY(x, y)
	local s = gui.AbsoluteSize
	local b = btn.AbsoluteSize
	return math.clamp(x, 0, math.max(0, s.X - b.X)), math.clamp(y, 0, math.max(0, s.Y - b.Y))
end

local function setPos(x, y)
	local cx, cy = clampXY(x, y)
	btn.Position = UDim2.new(0, cx, 0, cy)
end

do
	local abs = btn.AbsolutePosition - gui.AbsolutePosition
	setPos(abs.X, abs.Y)
end

track(gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	local abs = btn.AbsolutePosition - gui.AbsolutePosition
	setPos(abs.X, abs.Y)
end))

local dragging = false
local dragMoved = false
local dragInput = nil
local pressPos = nil
local btnStartX = 0
local btnStartY = 0

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function finishDrag()
	if not dragging then return end
	dragging = false
	dragInput = nil
	local moved = dragMoved
	dragMoved = false
	if not moved then
		setEnabled(not enabled)
	end
end

track(btn.InputBegan:Connect(function(input)
	if isPress(input) and not dragging then
		dragging = true
		dragMoved = false
		dragInput = input
		pressPos = Vector2.new(input.Position.X, input.Position.Y)
		local abs = btn.AbsolutePosition - gui.AbsolutePosition
		btnStartX = abs.X
		btnStartY = abs.Y
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End and dragInput == input then
				finishDrag()
			end
		end)
	end
end))

track(UserInputService.InputChanged:Connect(function(input)
	if not dragging or not dragInput then return end
	local isMouse = dragInput.UserInputType == Enum.UserInputType.MouseButton1
		and input.UserInputType == Enum.UserInputType.MouseMovement
	local isTouch = dragInput.UserInputType == Enum.UserInputType.Touch
		and input == dragInput
	if not (isMouse or isTouch) then return end

	local cur = Vector2.new(input.Position.X, input.Position.Y)
	local delta = cur - pressPos
	if not dragMoved and delta.Magnitude > 8 then
		dragMoved = true
	end
	if dragMoved then
		setPos(btnStartX + delta.X, btnStartY + delta.Y)
	end
end))

track(UserInputService.InputEnded:Connect(function(input)
	if not dragging or not dragInput then return end
	if input == dragInput
		or (dragInput.UserInputType == Enum.UserInputType.MouseButton1
			and input.UserInputType == Enum.UserInputType.MouseButton1) then
		finishDrag()
	end
end))

ENV.__AutoJumpTP_Cleanup = function()
	enabled = false
	pcall(function() setProtect(false) end)
	for _, c in ipairs(conns) do
		pcall(function() c:Disconnect() end)
	end
	conns = {}
	pcall(function() gui:Destroy() end)
end

local ZONES = {
    { y = 229.1,  target = Vector3.new(132.3, 599.6, -3088.7) },
    { y = 956.1,  target = Vector3.new(-874.9, 1358.6, -5560.9) },
    { y = 1024.1, target = Vector3.new(-6940.3, 1352.3, -7211.2) },
}

-- Y_TOLERANCE DIPERKETAT: harus benar-benar pas di salah satu 3 Y zona
local Y_TOLERANCE  = 0.01
local DWELL        = 1.5
local SPEED        = 1200
local CRUISE_EXTRA = 150
local COOLDOWN     = 2.0
local BUSY_TIMEOUT = 10

local MOVE_SPEED_THRESHOLD = 1.5
local MOVE_POS_THRESHOLD   = 0.08

local PROTECT_STATES = {
    Enum.HumanoidStateType.FallingDown,
    Enum.HumanoidStateType.Ragdoll,
    Enum.HumanoidStateType.Physics,
}

local conns = {}
local function track(c) conns[#conns + 1] = c; return c end

local enabled         = false
local teleporting     = false
local busySince       = 0
local lastTeleportEnd = 0
local dwellZone       = nil
local dwellStart      = 0
local lastPos         = nil

local protectOn    = false
local protectOrig  = {}
local protectConn  = nil
local protectChar  = nil
local protectHum   = nil
local stateOrig    = {}

local function getChar()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return nil end
    return char, root, hum
end

local function feetOffset(root, hum)
    local o = 0
    pcall(function() o = hum.HipHeight + root.Size.Y / 2 end)
    return o
end

-- cek Y terhadap 3 zona. Hanya lolos jika Y (atau Y-kaki) benar-benar pas
local function matchZone(root, hum)
    local y = root.Position.Y
    local refs = { y, y - feetOffset(root, hum) }
    local best, bestDiff = nil, math.huge
    for _, z in ipairs(ZONES) do
        for _, ry in ipairs(refs) do
            local diff = math.abs(ry - z.y)
            if diff <= Y_TOLERANCE and diff < bestDiff then
                best, bestDiff = z, diff
            end
        end
    end
    return best
end

-- wood DIBAWAH karakter (bukan sekadar ada wood di sekitar)
local function isWoodBelow(root, char)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    params.IgnoreWater = false
    -- 15 stud ke bawah, harus kena wood/wplanks
    local result = Workspace:Raycast(root.Position, Vector3.new(0, -15, 0), params)
    if not result then return false end
    local m = result.Material
    if not (m == Enum.Material.Wood or m == Enum.Material.WoodPlanks) then
        return false
    end
    -- wood harus tepat di bawah kaki (bukan jauh miring)
    local feetY = root.Position.Y - feetOffset(root, hum)
    local gap = math.abs(result.Position.Y - feetY)
    if gap > 2.0 then return false end
    return true
end

local function isMoving(root, hum, moveDir)
    local v
    pcall(function() v = root.AssemblyLinearVelocity end)
    if v then
        local hv = Vector3.new(v.X, 0, v.Z).Magnitude
        if hv > MOVE_SPEED_THRESHOLD then return true end
    end
    if lastPos then
        local d = (root.Position - lastPos)
        local hd = Vector3.new(d.X, 0, d.Z).Magnitude
        if hd > MOVE_POS_THRESHOLD then return true end
    end
    if moveDir and moveDir.Magnitude > 0.15 then return true end
    return false
end

local function zeroVel(root)
    pcall(function()
        root.AssemblyLinearVelocity  = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function dropProtect()
    protectOn = false
    if protectConn then
        pcall(function() protectConn:Disconnect() end)
        protectConn = nil
    end
    protectOrig = {}
    stateOrig   = {}
    protectChar = nil
    protectHum  = nil
end

local function setProtect(on)
    if on == protectOn then return end
    if on then
        local char, _, hum = getChar()
        if not char then return end
        protectOn   = true
        protectChar = char
        protectHum  = hum
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then
                if protectOrig[d] == nil then
                    local old = true
                    pcall(function() old = d.CanTouch end)
                    protectOrig[d] = old
                end
                pcall(function() d.CanTouch = false end)
            end
        end
        protectConn = char.DescendantAdded:Connect(function(d)
            if protectOn and d:IsA("BasePart") then
                if protectOrig[d] == nil then
                    local old = true
                    pcall(function() old = d.CanTouch end)
                    protectOrig[d] = old
                end
                pcall(function() d.CanTouch = false end)
            end
        end)
        for _, st in ipairs(PROTECT_STATES) do
            pcall(function()
                stateOrig[st] = hum:GetStateEnabled(st)
                hum:SetStateEnabled(st, false)
            end)
        end
    else
        local hum = protectHum
        for part, old in pairs(protectOrig) do
            pcall(function()
                if part and part.Parent then part.CanTouch = old end
            end)
        end
        if hum and hum.Parent then
            for st, old in pairs(stateOrig) do
                pcall(function() hum:SetStateEnabled(st, old) end)
            end
        end
        dropProtect()
    end
end

local function doTeleport(zone)
    local char, root, hum = getChar()
    if not char then
        teleporting = false
        return
    end
    busySince = tick()
    pcall(function() setProtect(true) end)

    local saved = {}
    local oldAutoRotate = true
    pcall(function() oldAutoRotate = hum.AutoRotate end)

    pcall(function()
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then
                table.insert(saved, { part = d, collide = d.CanCollide })
                pcall(function() d.CanCollide = false end)
            end
        end

        hum.AutoRotate    = false
        hum.PlatformStand = true

        local rot    = root.CFrame.Rotation
        local p0     = root.Position
        local target = zone.target
        local cruise = math.max(p0.Y, target.Y) + CRUISE_EXTRA

        local waypoints = {
            Vector3.new(p0.X, cruise, p0.Z),
            Vector3.new(target.X, cruise, target.Z),
            target,
        }

        local current = p0
        for _, wp in ipairs(waypoints) do
            while true do
                if not root.Parent or char ~= player.Character or hum.Health <= 0 then
                    error("aborted")
                end
                local diff = wp - current
                local dist = diff.Magnitude
                if dist < 0.05 then
                    current = wp
                    root.CFrame = CFrame.new(current) * rot
                    zeroVel(root)
                    break
                end
                local dt = RunService.Heartbeat:Wait()
                if dt > 0.1 then dt = 0.1 end
                local step = SPEED * dt
                if step >= dist then
                    current = wp
                else
                    current = current + diff.Unit * step
                end
                root.CFrame = CFrame.new(current) * rot
                zeroVel(root)
                if current == wp then break end
            end
        end

        for _ = 1, 3 do
            root.CFrame = CFrame.new(target) * rot
            zeroVel(root)
            RunService.Heartbeat:Wait()
        end
    end)

    pcall(function()
        for _, e in ipairs(saved) do
            if e.part and e.part.Parent then
                e.part.CanCollide = e.collide
            end
        end
    end)

    pcall(function()
        if hum and hum.Parent then
            hum.PlatformStand = false
            hum.AutoRotate    = oldAutoRotate
            hum.Jump          = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)

    zeroVel(root)

    dwellZone       = nil
    dwellStart      = 0
    lastTeleportEnd = tick()
    teleporting     = false

    if not enabled then
        pcall(function() setProtect(false) end)
    end
end


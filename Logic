    Title("No Cooldown Skill")
    -- ===== FITUR: No Cooldown Skill =====
    -- Logic asli dari No Cooldown Skill [ UDAH TESTING ].txt
    local NCS = { enabled = false, cleanupFn = nil }

    local function NCS_Start()
        if NCS.enabled then return end
        NCS.enabled = true

        local ID_SLASH_ABYSS = "80411309607666"
        local State = {
            Enabled = true, HiddenThread = nil, AbyssConn = nil, SlashConn = nil,
            CorruptHandlerFunc = nil, SlashFunc = nil, CancelFunc = nil,
        }

        local function StartLeapBypass()
            State.HiddenThread = task.spawn(function()
                local leapFunction, m2Function
                for _, v in pairs(getgc(true)) do
                    if type(v) == "function" and islclosure(v) then
                        local info = debug.getinfo(v)
                        if info.name == "tryActivate" then leapFunction = v end
                        if info.name == "playM2Animation" then m2Function = v end
                        if leapFunction and m2Function then break end
                    end
                end
                if not leapFunction and not m2Function then return end
                while task.wait(0.1) do
                    if not State.Enabled then break end
                    for _, fn in pairs({ leapFunction, m2Function }) do
                        if fn then
                            for i, val in pairs(debug.getupvalues(fn)) do
                                if type(val) == "boolean" and val == true then
                                    debug.setupvalue(fn, i, false)
                                end
                            end
                        end
                    end
                end
            end)
        end
        local function StartCooldownBypass()
            if not State.CorruptHandlerFunc then
                for _, v in pairs(getgc(true)) do
                    if type(v) == "function" and islclosure(v) then
                        local constants = debug.getconstants(v)
                        if table.find(constants, "corrupt") and table.find(constants, "Immobile") then
                            State.CorruptHandlerFunc = v
                            break
                        end
                    end
                end
            end
            if not State.CorruptHandlerFunc then return end
            if State.AbyssConn then State.AbyssConn:Disconnect(); State.AbyssConn = nil end
            State.AbyssConn = RunService.Heartbeat:Connect(function()
                if not State.Enabled then return end
                if State.CorruptHandlerFunc then
                    local upvalues = debug.getupvalues(State.CorruptHandlerFunc)
                    for idx, val in pairs(upvalues) do
                        if type(val) == "boolean" then
                            if val == false then debug.setupvalue(State.CorruptHandlerFunc, idx, true) end
                        end
                    end
                end
            end)
        end
        local function IsSlashPlaying()
            local char = LocalPlayer.Character
            if not char then return false end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then return false end
            local animator = hum:FindFirstChildOfClass("Animator")
            if not animator then return false end
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                if track.IsPlaying and track.Animation
                    and string.find(track.Animation.AnimationId, ID_SLASH_ABYSS) then
                    return true
                end
            end
            return false
        end
        local function FindSlashFunctions()
            for _, v in pairs(getgc(true)) do
                if type(v) == "function" and islclosure(v) then
                    local info = debug.getinfo(v)
                    if info.name == "slashAttackHandler" then State.SlashFunc = v end
                    if info.name == "cancelAttackHold" then State.CancelFunc = v end
                    if State.SlashFunc then break end
                end
            end
        end
        local function StartSlashBypass()
            if not State.SlashFunc then FindSlashFunctions() end
            if not State.SlashFunc then return false end
            if State.SlashConn then State.SlashConn:Disconnect() end
            State.SlashConn = RunService.Heartbeat:Connect(function()
                if not State.Enabled then return end
                if not State.SlashFunc then return end
                local isAttacking = IsSlashPlaying()
                if not isAttacking then
                    for idx, val in pairs(debug.getupvalues(State.SlashFunc)) do
                        if type(val) == "boolean" and val == false then
                            debug.setupvalue(State.SlashFunc, idx, true)
                        end
                    end
                    if State.CancelFunc then
                        for idx, val in pairs(debug.getupvalues(State.CancelFunc)) do
                            if type(val) == "boolean" and val == true then
                                debug.setupvalue(State.CancelFunc, idx, false)
                            end
                        end
                    end
                end
            end)
            return true
        end

        StartLeapBypass()
        StartCooldownBypass()
        StartSlashBypass()

        local charConn = LocalPlayer.CharacterAdded:Connect(function()
            task.wait(0.5)
            if State.Enabled then
                StartLeapBypass()
                StartCooldownBypass()
                StartSlashBypass()
            end
        end)

        NCS.cleanupFn = function()
            State.Enabled = false
            if State.HiddenThread then State.HiddenThread = nil end
            if State.AbyssConn then State.AbyssConn:Disconnect(); State.AbyssConn = nil end
            if State.SlashConn then State.SlashConn:Disconnect(); State.SlashConn = nil end
            pcall(function() charConn:Disconnect() end)
        end
    end

    local function NCS_Stop()
        if not NCS.enabled then return end
        NCS.enabled = false
        if NCS.cleanupFn then pcall(NCS.cleanupFn); NCS.cleanupFn = nil end
    end

    AddFeature("No Cooldown Skill", {
        type = "toggle",
        default = false,
        callback = function(state) if state then NCS_Start() else NCS_Stop() end end,
    })

end)


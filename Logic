		AG_SCOPE = S

		local Enabled = true
		local Mode = string.upper(AG_CFG.mode or "NORMAL")
		local ScourgeMode = (AG_CFG.instant and "INSTANT") or "NORMAL"
		local SUCCESS_MIN, SUCCESS_MAX = 102, 116
		local NEUTRAL_MIN, NEUTRAL_MAX = 116, 159
		local INSTANT_ANGLE = 109
		local TriggerDelay = 0.035
		local LastTrigger = 0
		local SCOURGE_TIMEOUT = 15
		local Alive = true
		local Busy = false
		local ScourgeActive = false
		local ScourgeRound = 0
		local LastVisible = 0
		local PreviousVisible = false
		local Check = nil
		local Line = nil
		local Goal = nil
		local Action = nil

		local function RefreshReferences()
			pcall(function()
				local skillGui = PlayerGui:FindFirstChild("SkillCheckPromptGui")
				local newCheck = skillGui and skillGui:FindFirstChild("Check")
				Check = newCheck
				if newCheck then Line = newCheck:FindFirstChild("Line"); Goal = newCheck:FindFirstChild("Goal") else Line = nil; Goal = nil end
				local survivor = PlayerGui:FindFirstChild("Survivor-mob")
				local controls = survivor and survivor:FindFirstChild("Controls")
				Action = controls and controls:FindFirstChild("action")
			end)
		end
		RefreshReferences()
		S:addThread(task.spawn(function()
			while Alive and S.alive do RefreshReferences(); task.wait(0.5) end
		end))

		local function TriggerAction()
			if not Action or not Action.Parent then RefreshReferences() end
			if not Action then return false end
			local Now = os.clock()
			if Now - LastTrigger < TriggerDelay then return false end
			LastTrigger = Now
			pcall(function() if Action:IsA("GuiButton") then Action:Activate() end end)
			if typeof(firesignal) == "function" then pcall(function() firesignal(Action.MouseButton1Down) end) end
			return true
		end
		local function GetAngle()
			if not Line or not Goal then return nil end
			return tonumber(Line.Rotation) or 0, tonumber(Goal.Rotation) or 0
		end
		local function IsPerfect()
			local LR, GR = GetAngle()
			if not LR then return false end
			return LR >= GR + SUCCESS_MIN and LR <= GR + SUCCESS_MAX
		end
		local function IsNormal()
			local LR, GR = GetAngle()
			if not LR then return false end
			return LR > GR + NEUTRAL_MIN and LR <= GR + NEUTRAL_MAX
		end
		local function InstantNormal()
			if not Check or not Line or not Goal then RefreshReferences() end
			if not Check or not Line or not Goal then return end
			if not Check.Visible then return end
			local GR = tonumber(Goal.Rotation) or 0
			pcall(function() Line.Rotation = GR + INSTANT_ANGLE end)
			TriggerAction()
		end
		local function InstantScourge()
			if not Enabled or not ScourgeActive then return false end
			if not Line or not Goal then RefreshReferences() end
			if not Line or not Goal then return false end
			local GR = tonumber(Goal.Rotation) or 0
			pcall(function() Line.Rotation = GR + INSTANT_ANGLE end)
			local Pressed = TriggerAction()
			if Pressed then ScourgeRound = ScourgeRound + 1 end
			return Pressed
		end
		local function OnScourgeStart() ScourgeActive = true; ScourgeRound = 0; Busy = false; LastVisible = os.clock() end
		local function OnScourgeEnd() ScourgeActive = false; Busy = false end

		S:addThread(task.spawn(function()
			while Alive and S.alive do
				local ok, startRemote, endRemote = pcall(function()
					local remotes = ReplicatedStorage:FindFirstChild("Remotes")
					local perks = remotes and remotes:FindFirstChild("KillerPerks")
					local scourge = perks and perks:FindFirstChild("kingscourge")
					if not scourge then return nil, nil end
					return scourge:FindFirstChild("KingScourgeStart"), scourge:FindFirstChild("KingScourgeEnd")
				end)
				if ok and startRemote and endRemote then
					S:addConn(startRemote.OnClientEvent:Connect(OnScourgeStart))
					S:addConn(endRemote.OnClientEvent:Connect(OnScourgeEnd))
					return
				end
				task.wait(1)
			end
		end))

		S:addConn(RunService.RenderStepped:Connect(function()
			local Now = os.clock()
			if not Check or not Check.Parent then RefreshReferences() end
			local Visible = Check ~= nil and Check.Parent ~= nil and Check.Visible == true
			if Visible then LastVisible = Now
			elseif ScourgeActive and Now - LastVisible > SCOURGE_TIMEOUT then ScourgeActive = false; Busy = false end
			if not Enabled then PreviousVisible = false; return end
			local WasVisible = PreviousVisible
			PreviousVisible = Visible
			if not Visible then return end
			if not WasVisible then
				Busy = false
				if not ScourgeActive and Mode == "INSTANT" then InstantNormal() end
			end
			if not ScourgeActive then
				if not Busy then
					local ShouldTrigger = false
					if Mode == "PERFECT" then ShouldTrigger = IsPerfect()
					elseif Mode == "NORMAL" then ShouldTrigger = IsNormal() end
					if ShouldTrigger then
						Busy = true
						TriggerAction()
						task.delay(0.07, function() Busy = false end)
					end
				end
				return
			end
			if ScourgeMode == "NORMAL" then
				if not Busy and IsNormal() then
					Busy = true
					TriggerAction()
					task.delay(0.06, function() Busy = false end)
				end
			end
		end))

		S:addThread(task.spawn(function()
			local HandledGoal = nil
			while Alive and S.alive do
				if Enabled and ScourgeActive and ScourgeMode == "INSTANT" then
					RefreshReferences()
					if Check and Check.Visible and Goal and Line then
						local CG = tonumber(Goal.Rotation) or 0
						if HandledGoal == nil or math.abs(CG - HandledGoal) > 1 then
							if InstantScourge() then HandledGoal = CG end
						end
					else HandledGoal = nil end
				else HandledGoal = nil end
				task.wait(0.005)
			end
		end))

		S:addConn(LocalPlayer.CharacterAdded:Connect(function()
			Busy = false; ScourgeActive = false; PreviousVisible = false
			task.wait(1)
			RefreshReferences()
		end))

		S.extraCleanup = function()
			Alive = false
			Enabled = false
		end
	else
		if AG_SCOPE then
			if AG_SCOPE.extraCleanup then pcall(AG_SCOPE.extraCleanup) end
			AG_SCOPE:cleanup()
			AG_SCOPE = nil
		end
	end
end)


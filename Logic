            if input.UserInputType == Enum.UserInputType.Touch
                or input.UserInputType == Enum.UserInputType.MouseButton1 then
                pressStart = input.Position
                pressInput = input
                startAbs = btn.AbsolutePosition
                dragMoved = false
                dragging = false
            end
        end))
        table.insert(ButtonConns, UserInputService.InputChanged:Connect(function(input)
            if not pressStart or not pressInput or not startAbs then return end
            if CONFIG.BUTTON_LOCKED then return end
            local t = input.UserInputType
            local valid = false
            if pressInput.UserInputType == Enum.UserInputType.Touch then
                valid = (t == Enum.UserInputType.Touch and input == pressInput)
            else valid = (t == Enum.UserInputType.MouseMovement) end
            if not valid then return end
            local dx = input.Position.X - pressStart.X
            local dy = input.Position.Y - pressStart.Y
            if not dragging then
                if math.sqrt(dx * dx + dy * dy) > MOVE_THRESHOLD then
                    dragging = true; dragMoved = true
                    pressStart = input.Position
                    startAbs = btn.AbsolutePosition
                    dx, dy = 0, 0
                end
            end
            if dragging and btn and btn.Parent then
                local sw, sh = GetScreenSize()
                local maxX = math.max(0, sw - CONFIG.BUTTON_SIZE)
                local maxY = math.max(0, sh - CONFIG.BUTTON_SIZE - 18)
                local nx = math.clamp(startAbs.X + dx, 0, maxX)
                local ny = math.clamp(startAbs.Y + dy, 0, maxY)
                btn.Position = UDim2.fromOffset(nx, ny)
            end
        end))
        table.insert(ButtonConns, UserInputService.InputEnded:Connect(function(input)
            if not pressInput then return end
            local t = input.UserInputType
            local ended = false
            if pressInput.UserInputType == Enum.UserInputType.Touch then
                ended = (t == Enum.UserInputType.Touch and input == pressInput)
            else ended = (t == Enum.UserInputType.MouseButton1) end
            if ended then
                pressStart = nil; pressInput = nil; startAbs = nil; dragging = false
            end
        end))
        local createdAt = os.clock()
        local function UpdateButtonState()
            if not btn or not btn.Parent then return end
            local imageReady = false
            pcall(function() imageReady = btn.IsLoaded == true end)
            fallback.Visible = (not imageReady) and (os.clock() - createdAt > 3)
            if IsBypassRunning then
                btn.ImageColor3 = Color3.fromRGB(255, 255, 255)
                btn.ImageTransparency = 0
                fallback.TextColor3 = Color3.fromRGB(255, 255, 255)
            elseif IsPlayerRepairing() then
                btn.ImageColor3 = Color3.fromRGB(255, 255, 255)
                btn.ImageTransparency = 0
                fallback.TextColor3 = Color3.fromRGB(100, 255, 130)
            else
                btn.ImageColor3 = Color3.fromRGB(255, 255, 255)
                btn.ImageTransparency = 0
                fallback.TextColor3 = Color3.fromRGB(190, 190, 190)
            end
        end
        BypassButton = gui
        GenButtonUpdater = UpdateButtonState
        table.insert(ButtonConns, btn.MouseButton1Click:Connect(function()
            if dragMoved then dragMoved = false; return end
            if IsBypassRunning and (tick() - BypassStartTime > 3) then IsBypassRunning = false end

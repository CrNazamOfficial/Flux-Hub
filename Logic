local ZONES = {
	{ y = 229.1,  target = Vector3.new(132.3, 599.6, -3088.7) },
	{ y = 956.1,  target = Vector3.new(-874.9, 1358.6, -5560.9) },
	{ y = 1024.1, target = Vector3.new(-6940.3, 1352.3, -7211.2) },
}

local TOGGLE_KEY = Enum.KeyCode.Q
local Y_EXACT = 0.12
local DWELL = 0.15
local SPEED = 2000
local CRUISE_EXTRA = 150
local COOLDOWN = 0.5
local BUSY_TIMEOUT = 10

local INVISIBLE_MIN = 0.99
local GROUND_TOL = 1.0
local GROUND_BELOW_TOL = 1.0
local RAY_UP = 1.5
local RAY_LEN = 3.0
local AIR_MIN = 0.08
local JUMP_VY = 12
local JUMP_KEEP = 0.4
local SIDE_OFFSET = 1.2
local RISE_MIN = 1.5
local SETTLE_VY = 2
local PENDING_TIMEOUT = 1.5

local conns = {}
local function track(c)
	conns[#conns + 1] = c
	return c
end

local enabled = false
local teleporting = false
local busySince = 0
local lastTeleportEnd = 0

local airStart = 0
local airborne = false
local jumped = false
local jumpedAt = 0
local pending = false
local pendingSince = 0
local dwellStart = 0
local lastGroundBottom = nil

local protectOn = false
local protectOrig = {}
local protectConn = nil
local protectChar = nil
local protectHum = nil
local stateOrig = {}

local PROTECT_STATES = {
	Enum.HumanoidStateType.FallingDown,
	Enum.HumanoidStateType.Ragdoll,
	Enum.HumanoidStateType.Physics,
}

local FOOT_NAMES = {
	["LeftFoot"] = true,
	["RightFoot"] = true,
	["LeftLowerLeg"] = true,
	["RightLowerLeg"] = true,
	["Left Leg"] = true,
	["Right Leg"] = true,
}

local FLOOR_OFFSETS = {
	Vector3.new(0, 0, 0),
	Vector3.new(SIDE_OFFSET, 0, 0),
	Vector3.new(-SIDE_OFFSET, 0, 0),
	Vector3.new(0, 0, SIDE_OFFSET),
	Vector3.new(0, 0, -SIDE_OFFSET),
}

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
pcall(function() rayParams.RespectCanCollide = true end)

local function resetFlow()
	airStart = 0
	airborne = false
	jumped = false
	jumpedAt = 0
	pending = false
	pendingSince = 0
	dwellStart = 0
	lastGroundBottom = nil
end

local function getChar()
	local char = player.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return nil end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then
		root = nil
		pcall(function() root = hum.RootPart end)
	end
	if not (root and root:IsA("BasePart")) then
		root = char.PrimaryPart
	end
	if not (root and root:IsA("BasePart")) then
		root = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
	end
	if not (root and root:IsA("BasePart")) then return nil end
	if hum.Health <= 0 then return nil end
	return char, root, hum
end

local function feetOffset(root, hum)
	local o = 0
	pcall(function()
		o = hum.HipHeight + root.Size.Y / 2
	end)
	return o
end

local function partBottom(part)
	local cf = part.CFrame
	local s = part.Size
	local half = (math.abs(cf.UpVector.Y) * s.Y + math.abs(cf.RightVector.Y) * s.X + math.abs(cf.LookVector.Y) * s.Z) / 2
	return part.Position.Y - half
end

local function lowestPoint(char, root, hum)
	local best = nil
	pcall(function()
		for _, d in ipairs(char:GetChildren()) do
			if d:IsA("BasePart") and FOOT_NAMES[d.Name] then
				local b = partBottom(d)
				if best == nil or b < best then best = b end
			end
		end
	end)
	if best == nil then
		pcall(function()
			local cf, size = char:GetBoundingBox()
			best = cf.Position.Y - size.Y / 2
		end)
	end
	if best == nil then
		best = root.Position.Y - feetOffset(root, hum)
	end
	return best
end

local function isSolidVisible(inst)
	local result = true
	pcall(function()
		if inst.Transparency >= INVISIBLE_MIN then
			result = false
			return
		end
		if inst.LocalTransparencyModifier >= INVISIBLE_MIN then
			result = false
			return
		end
		if inst.CanCollide == false then
			result = false
			return
		end
	end)
	return result
end

local function castFloor(char, origin)
	local ignore = { char }
	for _ = 1, 8 do
		rayParams.FilterDescendantsInstances = ignore
		local res = workspace:Raycast(origin, Vector3.new(0, -RAY_LEN, 0), rayParams)
		if not res then return nil end
		if isSolidVisible(res.Instance) then return res end
		ignore[#ignore + 1] = res.Instance
	end
	return nil
end

local function readFloor(char, root, bottomY)
	local best = nil
	local p = root.Position
	for _, o in ipairs(FLOOR_OFFSETS) do
		local origin = Vector3.new(p.X + o.X, bottomY + RAY_UP, p.Z + o.Z)
		local res = castFloor(char, origin)
		if res then
			local gap = bottomY - res.Position.Y
			if gap >= -GROUND_BELOW_TOL and gap <= GROUND_TOL then
				if best == nil or res.Position.Y > best.Position.Y then
					best = res
				end
			end
		end
	end
	if best then
		return best.Position.Y, best.Instance
	end
	return nil, nil
end

local function matchZone(root, hum, bottomY, surfaceY)
	local rootY = root.Position.Y
	local refs = { rootY, rootY - feetOffset(root, hum), bottomY }
	if surfaceY then refs[#refs + 1] = surfaceY end
	local best = nil
	local bestDiff = math.huge
	for _, z in ipairs(ZONES) do
		for _, ry in ipairs(refs) do
			local diff = math.abs(ry - z.y)
			if diff <= Y_EXACT and diff < bestDiff then
				best = z
				bestDiff = diff
			end
		end
	end
	return best
end

local function guardPart(part)
	if protectOrig[part] == nil then
		local old = true
		pcall(function() old = part.CanTouch end)
		protectOrig[part] = old
	end
	pcall(function() part.CanTouch = false end)
end

local function dropProtect()
	protectOn = false
	if protectConn then
		pcall(function() protectConn:Disconnect() end)
		protectConn = nil
	end
	protectOrig = {}
	stateOrig = {}
	protectChar = nil
	protectHum = nil
end

local function setProtect(on)
	if on == protectOn then return end
	if on then
		local char, _, hum = getChar()
		if not char then return end
		protectOn = true
		protectChar = char
		protectHum = hum
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then guardPart(d) end
		end
		protectConn = char.DescendantAdded:Connect(function(d)
			if protectOn and d:IsA("BasePart") then guardPart(d) end
		end)
		for _, st in ipairs(PROTECT_STATES) do
			pcall(function()
				stateOrig[st] = hum:GetStateEnabled(st)
				hum:SetStateEnabled(st, false)
			end)
		end
	else
		local hum = protectHum
		for part, old in pairs(protectOrig) do
			pcall(function()
				if part and part.Parent then part.CanTouch = old end
			end)
		end
		if hum and hum.Parent then
			for st, old in pairs(stateOrig) do
				pcall(function() hum:SetStateEnabled(st, old) end)
			end
		end
		dropProtect()
	end
end

local function doTeleport(zone)
	local char, root, hum = getChar()
	if not char then
		teleporting = false
		return
	end
	busySince = tick()
	pcall(function() setProtect(true) end)

	local saved = {}
	local oldAutoRotate = true
	pcall(function() oldAutoRotate = hum.AutoRotate end)

	local function zeroVel()
		pcall(function()
			root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		end)
	end

	pcall(function()
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(saved, { part = d, collide = d.CanCollide })
				pcall(function() d.CanCollide = false end)
			end
		end
		hum.AutoRotate = false
		hum.PlatformStand = true

		local rot = root.CFrame.Rotation
		local p0 = root.Position
		local target = zone.target
		local cruise = math.max(p0.Y, target.Y) + CRUISE_EXTRA

		local waypoints = {
			Vector3.new(p0.X, cruise, p0.Z),
			Vector3.new(target.X, cruise, target.Z),
			target,
		}

		local current = p0
		for _, wp in ipairs(waypoints) do
			while true do
				if not root.Parent or char ~= player.Character or hum.Health <= 0 then
					error("aborted")
				end
				local diff = wp - current
				local dist = diff.Magnitude
				if dist < 0.05 then
					current = wp
					root.CFrame = CFrame.new(current) * rot
					zeroVel()
					break
				end
				local dt = RunService.Heartbeat:Wait()
				if dt > 0.1 then dt = 0.1 end
				local step = SPEED * dt
				if step >= dist then
					current = wp
				else
					current = current + diff.Unit * step
				end
				root.CFrame = CFrame.new(current) * rot
				zeroVel()
				if current == wp then break end
			end
		end

		for _ = 1, 3 do
			root.CFrame = CFrame.new(target) * rot
			zeroVel()
			RunService.Heartbeat:Wait()
		end
	end)

	pcall(function()
		for _, e in ipairs(saved) do
			if e.part and e.part.Parent then
				e.part.CanCollide = e.collide
			end
		end
	end)
	pcall(function()
		if hum and hum.Parent then
			hum.PlatformStand = false
			hum.AutoRotate = oldAutoRotate
			hum.Jump = false
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
	zeroVel()

	resetFlow()
	lastTeleportEnd = tick()
	teleporting = false
	if not enabled then
		pcall(function() setProtect(false) end)
	end
end

track(RunService.Heartbeat:Connect(function()
	local char, root, hum = getChar()
	if not char then
		resetFlow()
		if protectOn then dropProtect() end
		return
	end

	if protectOn and protectChar ~= char then
		dropProtect()
	end

	local now = tick()

	if teleporting and (now - busySince) > BUSY_TIMEOUT then
		teleporting = false
	end

	if not enabled then
		resetFlow()
		if protectOn and not teleporting then setProtect(false) end
		return
	end

	if teleporting then return end

	local bottomY = lowestPoint(char, root, hum)
	local surfaceY = readFloor(char, root, bottomY)
	local grounded = surfaceY ~= nil

	local vy = 0
	pcall(function() vy = root.AssemblyLinearVelocity.Y end)

	local jumpNow = false
	pcall(function()
		if hum:GetState() == Enum.HumanoidStateType.Jumping then
			jumpNow = true
		end
		if grounded and hum.Jump then
			jumpNow = true
		end
		if (not grounded) and vy > JUMP_VY then
			jumpNow = true
		end
	end)
	if (not grounded) and lastGroundBottom and (bottomY - lastGroundBottom) > RISE_MIN then
		jumpNow = true
	end
	if jumpNow then
		jumped = true
		jumpedAt = now
	end

	local looseZone = matchZone(root, hum, bottomY, surfaceY)
	setProtect(looseZone ~= nil)

	if not grounded then
		if airStart == 0 then airStart = now end
		if (now - airStart) >= AIR_MIN and not airborne then
			airborne = true
			pending = false
			dwellStart = 0
		end
		return
	end

	airStart = 0

	local settled = math.abs(vy) < SETTLE_VY
	if settled then
		lastGroundBottom = bottomY
	end

	if airborne then
		airborne = false
		pending = jumped
		jumped = false
		pendingSince = now
		dwellStart = 0
	elseif jumped and (now - jumpedAt) > JUMP_KEEP then
		jumped = false
	end

	if not pending then
		dwellStart = 0
		return
	end

	if (now - pendingSince) > PENDING_TIMEOUT then
		pending = false
		dwellStart = 0
		return
	end

	if (now - lastTeleportEnd) < COOLDOWN then return end

	if not settled then
		dwellStart = 0
		return
	end

	local zone = matchZone(root, hum, bottomY, surfaceY)
	if not zone then
		dwellStart = 0
		return
	end

	if dwellStart == 0 then
		dwellStart = now
		return
	end

	if (now - dwellStart) >= DWELL then
		pending = false
		dwellStart = 0
		teleporting = true
		busySince = now
		task.spawn(doTeleport, zone)
	end
end))

track(player.CharacterAdded:Connect(function()
	teleporting = false
	resetFlow()
	dropProtect()
end))

local GUI_NAME = "AutoJumpTPGui"
local function getGuiParent()
	local ok, h = pcall(function()
		if gethui then return gethui() end
		return nil
	end)
	if ok and h then return h end
	local ok2 = pcall(function() return CoreGui.Name end)
	if ok2 then return CoreGui end
	return player:WaitForChild("PlayerGui")
end

local parent = getGuiParent()
pcall(function()
	local old = parent:FindFirstChild(GUI_NAME)
	if old then old:Destroy() end
end)

local gui = Instance.new("ScreenGui")
gui.Name = GUI_NAME
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 999
gui.Parent = parent

local btn = Instance.new("TextButton")
btn.Name = "Toggle"
btn.Size = UDim2.new(0, 50, 0, 50)
btn.Position = UDim2.new(0, 20, 0, 200)
btn.AutoButtonColor = false
btn.Text = "Off"
btn.Font = Enum.Font.GothamBold
btn.TextSize = 15
btn.Active = true
btn.Selectable = false
btn.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = btn

local stroke = Instance.new("UIStroke")
stroke.Thickness = 2
stroke.Parent = btn

local function refresh()
	if enabled then
		btn.Text = "On"
		btn.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
		btn.BackgroundTransparency = 0.1
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		stroke.Color = Color3.fromRGB(120, 255, 170)
	else
		btn.Text = "Off"
		btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		btn.BackgroundTransparency = 0.5
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		stroke.Color = Color3.fromRGB(255, 255, 255)
	end
end
refresh()

local function setEnabled(v)
	enabled = v
	resetFlow()
	lastTeleportEnd = 0
	if enabled then
		if teleporting and (tick() - busySince) > 3 then
			teleporting = false
		end
	else
		if not teleporting then
			pcall(function() setProtect(false) end)
		end
	end
	refresh()
end

track(UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if input.KeyCode ~= TOGGLE_KEY then return end
	if UserInputService:GetFocusedTextBox() then return end
	setEnabled(not enabled)
end))

local function clampXY(x, y)
	local s = gui.AbsoluteSize
	local b = btn.AbsoluteSize
	return math.clamp(x, 0, math.max(0, s.X - b.X)), math.clamp(y, 0, math.max(0, s.Y - b.Y))
end

local function setPos(x, y)
	local cx, cy = clampXY(x, y)
	btn.Position = UDim2.new(0, cx, 0, cy)
end

do
	local abs = btn.AbsolutePosition - gui.AbsolutePosition
	setPos(abs.X, abs.Y)
end

track(gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	local abs = btn.AbsolutePosition - gui.AbsolutePosition
	setPos(abs.X, abs.Y)
end))

local dragging = false
local dragMoved = false
local dragInput = nil
local pressPos = nil
local btnStartX = 0
local btnStartY = 0

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function finishDrag()
	if not dragging then return end
	dragging = false
	dragInput = nil
	local moved = dragMoved
	dragMoved = false
	if not moved then
		setEnabled(not enabled)
	end
end

track(btn.InputBegan:Connect(function(input)
	if isPress(input) and not dragging then
		dragging = true
		dragMoved = false
		dragInput = input
		pressPos = Vector2.new(input.Position.X, input.Position.Y)
		local abs = btn.AbsolutePosition - gui.AbsolutePosition
		btnStartX = abs.X
		btnStartY = abs.Y
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End and dragInput == input then
				finishDrag()
			end
		end)
	end
end))

track(UserInputService.InputChanged:Connect(function(input)
	if not dragging or not dragInput then return end
	local isMouse = dragInput.UserInputType == Enum.UserInputType.MouseButton1
		and input.UserInputType == Enum.UserInputType.MouseMovement
	local isTouch = dragInput.UserInputType == Enum.UserInputType.Touch
		and input == dragInput
	if not (isMouse or isTouch) then return end

	local cur = Vector2.new(input.Position.X, input.Position.Y)
	local delta = cur - pressPos
	if not dragMoved and delta.Magnitude > 8 then
		dragMoved = true
	end
	if dragMoved then
		setPos(btnStartX + delta.X, btnStartY + delta.Y)
	end
end))

track(UserInputService.InputEnded:Connect(function(input)
	if not dragging or not dragInput then return end
	if input == dragInput
		or (dragInput.UserInputType == Enum.UserInputType.MouseButton1
			and input.UserInputType == Enum.UserInputType.MouseButton1) then
		finishDrag()
	end
end))

ENV.__AutoJumpTP_Cleanup = function()
	enabled = false
	pcall(function() setProtect(false) end)
	for _, c in ipairs(conns) do
		pcall(function() c:Disconnect() end)
	end
	conns = {}
	pcall(function() gui:Destroy() end)
end

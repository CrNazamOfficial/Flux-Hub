		local function waitForGenComplete(genModel, timeout)
			local start = tick()
			while tick() - start < (timeout or 30) do
				if not genModel or not genModel.Parent then return false end
				local char = LocalPlayer.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if not hrp or not hrp.Parent then return false end
				local progress = genModel:GetAttribute("RepairProgress")
				if progress ~= nil and type(progress) == "number" then
					if progress >= 99.5 or progress >= 0.995 then return true end
				end
				if genModel:GetAttribute("Completed") == true or genModel:GetAttribute("IsRepaired") == true then return true end
				task.wait(0.1)
			end
			return false
		end
		local function DoMultiRepairPlain(targetPoint)
			if IsBypassRunning then return end
			if not BypassGenEnabled then return end
			if not targetPoint or not targetPoint.Parent then return end
			local genModel = targetPoint.Parent
			if not genModel then return end
			if ProcessedGens[genModel] then return end
			Injected[targetPoint] = nil
			IsBypassRunning = true
			BypassStartTime = tick()
			UserMovedDuringBypass = false
			pcall(function()
				local re = getRepairEvent()
				if not re then return end
				ProcessedGens[genModel] = true
				local allPoints = GetGeneratorPoints(genModel)
				if #allPoints < CONFIG.MIN_TITIK_REPAIR then ProcessedGens[genModel] = nil; return end
				local char = LocalPlayer.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if not hrp then ProcessedGens[genModel] = nil; return end
				local originalPosition = hrp.Position
				local originalRot = hrp.CFrame - hrp.CFrame.Position
				hrp.Anchored = false
				task.wait(0.03)
				local genBody = genModel:FindFirstChild("GeneratorBody") or genModel.PrimaryPart
				local count = 0
				for _, point in pairs(allPoints) do
					if not BypassGenEnabled or not S.alive then break end
					if not hrp.Parent then break end
					if not point or not point.Parent then count = count + 1; continue end
					count = count + 1
					if count > CONFIG.MAX_TITIK then break end
					if not hrp.Parent then break end
					local lookAt = genBody and genBody.Position or point.Position
					local targetCFrame
					if (lookAt - point.Position).Magnitude > 0.5 then targetCFrame = CFrame.lookAt(point.Position, lookAt)
					else targetCFrame = CFrame.new(point.Position) * originalRot end
					SmoothMoveTo(targetCFrame, CONFIG.SMOOTH_MOVE_DURATION)
					task.wait(CONFIG.SMOOTH_SETTLE_DELAY)

local SAV_SCOPE = nil
local SAV_CFG = { range = 10, snapLine = false, color = Color3.fromRGB(200, 100, 0) }

Hub:Bind("Silent Aim Veil", function(state, extras)
	if state then
		if SAV_SCOPE then return end
		SAV_CFG.range = tonumber(extras.range) or 10
		SAV_CFG.snapLine = extras.snapLine == true
		if typeof(extras.color) == "Color3" then SAV_CFG.color = extras.color end
		local S = newScope()
		SAV_SCOPE = S

		local CONFIG = {
			DEFAULT_SILENT = true, DEFAULT_VISUAL = SAV_CFG.snapLine,
			DEFAULT_FOV = SAV_CFG.range, MIN_FOV = 10, MAX_FOV = 90,
			PROJECTILE_GRAVITY = 96, AIM_OFFSET_Y = 0, PREDICT_MOVEMENT = true,
			MAX_PREDICT_SPEED = 60, MAX_TARGET_DISTANCE = 260,
			TARGET_STALE_TIME = 0.3, TARGET_HYSTERESIS = 3,
			LEAD_PING_MULT = 2.2, EXTRA_LEAD = 0.12, VELOCITY_SMOOTH = 0.25,
			ZIGZAG_WINDOW = 0.5, ZIGZAG_DEADZONE = 0.35, ZIGZAG_FULL = 1.2,
			ZIGZAG_LEAD_MIN = 0.4, AUTO_CALIBRATE = false,
			CALIB_MIN_SAMPLES = 5, CALIB_MIN_SPAN = 0.15, CALIB_MAX_RMS = 3,
			STEER_DELAY = 0.35, STEER_MAX_TIME = 4, STEER_TURN_RATE = 18,
			STEER_NEAR_DIST = 60, STEER_STOP_DIST = 2.5, MIN_SPEED_RATIO = 0.4,
			WEAK_THROW_RATIO = 0.45, SNAP_ORIGIN = "Bottom", SNAP_THICKNESS = 2,
			SNAP_TRANSPARENCY = 0.1,
		}
		local COLOR_SEL = SAV_CFG.color

		local gv = (getgenv and getgenv()) or _G
		local calib = gv.__SILENTAIM_CALIB
		if type(calib) ~= "table" then
			calib = { g = nil, speedScale = 1, count = 0 }
			gv.__SILENTAIM_CALIB = calib
		end

		local stateV = { silent = true, visual = CONFIG.DEFAULT_VISUAL, fov = CONFIG.DEFAULT_FOV }
		local aim = {
			target = nil, prevRoot = nil, updatedAt = 0, list = {}, holding = false,
			job = nil, steer = nil, thrownRoot = nil, thrownName = nil, armedUntil = 0,
		}
		local shuttingDown = false
		local killerCache = setmetatable({}, { __mode = "k" })
		local tracker = setmetatable({}, { __mode = "k" })
		local usedParts = setmetatable({}, { __mode = "k" })
		local recent = {}
		local ping = 0
		local spearRemote = nil
		local vfxRemote = nil
		local hookInstalled = false
		local oldNamecall = nil

		local function refreshPing()
			local ok, v = pcall(function() return LocalPlayer:GetNetworkPing() end)
			if ok and type(v) == "number" then ping = math.clamp(v, 0, 0.4) end
		end
		local function findRemotes()
			local remotes = ReplicatedStorage:FindFirstChild("Remotes")
			local killers = remotes and remotes:FindFirstChild("Killers")
			local veil = killers and killers:FindFirstChild("Veil")
			if veil then
				spearRemote = veil:FindFirstChild("Spearthrow")
				vfxRemote = veil:FindFirstChild("vfx")
			end
		end
		local function isKillerChar(char, now)
			local c = killerCache[char]
			if c then
				if c.isKiller then return true end
				if now - c.t < 2 then return false end
			end
			local found = char:FindFirstChild("Lookscriptkiller", true) ~= nil
			killerCache[char] = { isKiller = found, t = now }
			return found
		end
		local function isCharacterPart(p)
			local m = p:FindFirstAncestorOfClass("Model")
			return m ~= nil and m:FindFirstChildOfClass("Humanoid") ~= nil
		end
		local function currentGravity() if CONFIG.PROJECTILE_GRAVITY ~= nil then return CONFIG.PROJECTILE_GRAVITY end; if calib.g ~= nil then return calib.g end; return workspace.Gravity end
		local function resolveOrigin(origin)
			if typeof(origin) ~= "Vector3" then return nil end
			local char = LocalPlayer.Character
			local mr = char and char:FindFirstChild("HumanoidRootPart")
			if mr and (origin - mr.Position).Magnitude > 25 then return mr.Position + Vector3.new(0, 1.5, 0) end
			return origin
		end
		local function analyzeMotion(tr, now)
			local h = tr.hist
			local cutoff = now - CONFIG.ZIGZAG_WINDOW
			while #h > 0 and h[1].t < cutoff do table.remove(h, 1) end
			local n = #h
			if n < 4 or (h[n].t - h[1].t) < 0.2 then return nil, 1 end
			local t0, x0, z0 = h[1].t, h[1].x, h[1].z
			local st, stt, sx, stx, sz, stz = 0, 0, 0, 0, 0, 0
			for i = 1, n do
				local t = h[i].t - t0
				local x = h[i].x - x0
				local z = h[i].z - z0
				st = st + t; stt = stt + t * t
				sx = sx + x; stx = stx + t * x
				sz = sz + z; stz = stz + t * z
			end
			local D = n * stt - st * st
			if math.abs(D) < 1e-9 then return nil, 1 end
			local bx = (n * stx - st * sx) / D
			local bz = (n * stz - st * sz) / D
			local ax = (sx - bx * st) / n
			local az = (sz - bz * st) / n
			local sq = 0
			for i = 1, n do
				local t = h[i].t - t0
				local ex = (h[i].x - x0) - (ax + bx * t)
				local ez = (h[i].z - z0) - (az + bz * t)
				sq = sq + ex * ex + ez * ez
			end
			local rms = math.sqrt(sq / n)
			local span = math.max(CONFIG.ZIGZAG_FULL - CONFIG.ZIGZAG_DEADZONE, 0.01)
			local stable = math.clamp(1 - (rms - CONFIG.ZIGZAG_DEADZONE) / span, 0, 1)
			return Vector3.new(bx, 0, bz), stable
		end
		local function trackVelocity(root, now)
			local pos = root.Position
			local tr = tracker[root]
			if not tr then tr = { pos = pos, t = now, vel = Vector3.new(0, 0, 0), hist = {}, pred = nil, stable = 1 }; tracker[root] = tr end
			local jump = (pos - tr.pos).Magnitude
			if jump > 15 then
				tr.hist = { { t = now, x = pos.X, z = pos.Z } }
				tr.vel = Vector3.new(0, 0, 0); tr.pred = nil; tr.stable = 1; tr.pos = pos; tr.t = now
				return tr.vel
			end
			table.insert(tr.hist, { t = now, x = pos.X, z = pos.Z })
			tr.pred, tr.stable = analyzeMotion(tr, now)
			if jump < 0.001 then
				if now - tr.t > 0.15 then tr.vel = Vector3.new(0, 0, 0) end
				return tr.vel
			end
			local dt = now - tr.t
			if dt <= 0 or dt > 0.35 then tr.vel = Vector3.new(0, 0, 0)
			else
				local raw = (pos - tr.pos) / dt
				if raw.Magnitude > 180 then tr.vel = Vector3.new(0, 0, 0)
				else tr.vel = tr.vel:Lerp(raw, CONFIG.VELOCITY_SMOOTH) end
			end
			tr.pos = pos; tr.t = now
			return tr.vel
		end
		local function solveDirection(origin, speed, base, hv, g, lead)
			local t = (base - origin).Magnitude / speed
			local dirOut = nil
			local aimPos = base
			for _ = 1, 6 do
				aimPos = base + hv * (t + lead)
				local d = aimPos - origin
				local hd = Vector3.new(d.X, 0, d.Z)
				local x = hd.Magnitude
				local y = d.Y
				if x < 0.01 then dirOut = Vector3.new(0, y >= 0 and 1 or -1, 0); t = math.abs(y) / speed
				elseif g <= 0 then dirOut = d.Unit; t = d.Magnitude / speed
				else
					local v2 = speed * speed
					local disc = v2 * v2 - g * (g * x * x + 2 * y * v2)
					local theta
					if disc >= 0 then theta = math.atan((v2 - math.sqrt(disc)) / (g * x))
					else theta = math.rad(45) end
					local hdir = hd / x
					dirOut = hdir * math.cos(theta) + Vector3.new(0, math.sin(theta), 0)
					local vx = speed * math.cos(theta)
					if vx > 0.01 then t = x / vx end
				end
			end
			if not dirOut or dirOut.X ~= dirOut.X then return nil end
			return dirOut, aimPos
		end
		local function computeSpearDirection(args)
			if not stateV.silent then return nil end
			local t = aim.target
			if not t then return nil end
			if os.clock() - aim.updatedAt > CONFIG.TARGET_STALE_TIME then return nil end
			local root = t.root
			if not (root and root.Parent) then return nil end
			local speed = args[2]
			local origin = resolveOrigin(args[3])
			if not origin or type(speed) ~= "number" or speed <= 1 then return nil end
			speed = speed * calib.speedScale
			local g = currentGravity()
			local stable = t.stable or 1
			local lead = (ping * CONFIG.LEAD_PING_MULT + CONFIG.EXTRA_LEAD) * (CONFIG.ZIGZAG_LEAD_MIN + (1 - CONFIG.ZIGZAG_LEAD_MIN) * stable)
			local base = root.Position + Vector3.new(0, CONFIG.AIM_OFFSET_Y, 0)
			local hv = t.hv or Vector3.new(0, 0, 0)
			local dir = solveDirection(origin, speed, base, hv, g, lead)
			if not dir then return nil end
			aim.thrownRoot = root
			aim.thrownName = t.name
			return dir
		end
		local function installHook()
			if not getnamecallmethod then return end
			local setNm = setnamecallmethod
			local function isExploitCaller() if checkcaller then return checkcaller() end; return false end
			local function handler(self, ...)
				local method = getnamecallmethod()
				if method == "FireServer" and not shuttingDown and S.alive then
					if self == spearRemote and not isExploitCaller() then
						local args = table.pack(...)
						aim.thrownRoot = nil; aim.thrownName = nil
						local ok, newDir = pcall(computeSpearDirection, args)
						if ok and newDir then args[1] = newDir end
						if setNm then pcall(setNm, method) end
						return oldNamecall(self, table.unpack(args, 1, args.n))
					elseif self == vfxRemote and not isExploitCaller() then
						local _, _, a3 = ...
						if type(a3) == "boolean" then aim.holding = a3; aim.armedUntil = os.clock() + 3 end
						if setNm then pcall(setNm, method) end
						return oldNamecall(self, ...)
					end
				end
				return oldNamecall(self, ...)
			end
			local wrapped = handler
			if newcclosure then local ok, w = pcall(newcclosure, handler); if ok and w then wrapped = w end end
			if hookmetamethod then
				local ok, old = pcall(hookmetamethod, game, "__namecall", wrapped)
				if ok and old then oldNamecall = old; hookInstalled = true; return end
			end
			if getrawmetatable then
				pcall(function()
					local mt = getrawmetatable(game)
					local old = mt.__namecall
					if setreadonly then setreadonly(mt, false) end
					oldNamecall = old
					mt.__namecall = wrapped
					hookInstalled = true
				end)
			end
		end
		local function pickPart(job, now)
			for i = 1, #recent do
				local e = recent[i]
				local p = e.part
				if p and p.Parent and e.t >= job.t0 - 0.5 and not usedParts[p] and not job.cands[p] and not isCharacterPart(p) then
					if (p.Position - job.origin).Magnitude <= 40 then job.cands[p] = { pos = p.Position, t = now } end
				end
			end
			local best, bestSpeed = nil, 0
			for p, c in pairs(job.cands) do
				if not p.Parent then job.cands[p] = nil
				else
					local age = now - c.t
					if age >= 0.1 then
						local sp = (p.Position - c.pos).Magnitude / age
						if sp > bestSpeed then bestSpeed = sp; best = p end
					end
				end
			end
			if best and bestSpeed >= job.speed * 0.3 then return best end
			return nil
		end
		local function stepJob(now)
			for i = #recent, 1, -1 do if now - recent[i].t > 4 then table.remove(recent, i) end end
			local job = aim.job
			if not job then return end
			if not job.part then
				if now - job.t0 > 1.5 then aim.job = nil; return end
				local p = pickPart(job, now)
				if not p then return end
				job.part = p; job.firstT = now; usedParts[p] = true
				return
			end
			local p = job.part
			if not p.Parent then aim.job = nil; return end
			if now - job.firstT >= CONFIG.STEER_DELAY then aim.job = nil end
		end
		local function stepSteer(now, dt)
			local st = aim.steer
			if not st then return end
			local p, root = st.part, st.root
			if not (p and p.Parent and root and root.Parent) then aim.steer = nil; return end
			if now - st.t0 > CONFIG.STEER_MAX_TIME then aim.steer = nil; return end
			if not stateV.silent then aim.steer = nil; return end
			local pos = p.Position
			local dist = (root.Position - pos).Magnitude
			if dist <= CONFIG.STEER_STOP_DIST then aim.steer = nil; return end
			local hv = Vector3.new(0, 0, 0)
			local stable = 1
			local tr = tracker[root]
			if CONFIG.PREDICT_MOVEMENT and tr then
				hv = Vector3.new(tr.vel.X, 0, tr.vel.Z)
				stable = tr.stable or 1
				if tr.pred then hv = tr.pred:Lerp(hv, stable) end
				if hv.Magnitude > CONFIG.MAX_PREDICT_SPEED then hv = hv.Unit * CONFIG.MAX_PREDICT_SPEED end
			end
			local lead = (ping * CONFIG.LEAD_PING_MULT + CONFIG.EXTRA_LEAD) * (CONFIG.ZIGZAG_LEAD_MIN + (1 - CONFIG.ZIGZAG_LEAD_MIN) * stable)
			local aimPos = root.Position + Vector3.new(0, CONFIG.AIM_OFFSET_Y, 0) + hv * (dist / math.max(st.speed, 1) + lead)
			local want = aimPos - pos
			if want.Magnitude < 0.001 then return end
			want = want.Unit
			local anchored = p.Anchored
			local cur = nil
			local sp = st.speed
			if not anchored then
				cur = p.AssemblyLinearVelocity
				sp = cur.Magnitude
				if sp < st.minSpeed then return end
			end
			local newDir = want
			if cur then
				local curDir = cur.Unit
				local ang = math.acos(math.clamp(curDir:Dot(want), -1, 1))
				local maxTurn = CONFIG.STEER_TURN_RATE * dt
				if dist > CONFIG.STEER_NEAR_DIST and ang > maxTurn and ang > 0 then
					local mix = curDir:Lerp(want, maxTurn / ang)
					if mix.Magnitude > 0.001 then newDir = mix.Unit end
				end
			end
			if anchored then
				local step = math.min(sp * dt, dist)
				local np = pos + newDir * step
				p.CFrame = CFrame.new(np, np + newDir)
			else
				p.AssemblyLinearVelocity = newDir * sp
			end
		end
		local function refreshTargets(now)
			local list = aim.list
			for i = #list, 1, -1 do list[i] = nil end
			local cam = workspace.CurrentCamera
			if not cam then aim.target = nil; return end
			local camCF = cam.CFrame
			local camPos = camCF.Position
			local look = camCF.LookVector
			local best, bestAngle = nil, math.huge
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer then
					local char = p.Character
					if char then
						local root = char:FindFirstChild("HumanoidRootPart")
						local hum = char:FindFirstChildOfClass("Humanoid")
						if root and hum and hum.Health > 0 and not isKillerChar(char, now) then
							if not p:GetAttribute("IsDead") and not char:GetAttribute("IsCarried") and not char:GetAttribute("IsHooked") then
								local v = root.Position - camPos
								local dist = v.Magnitude
								if dist > 0.5 and dist <= CONFIG.MAX_TARGET_DISTANCE then
									local dot = look:Dot(v / dist)
									local angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
									local vel = trackVelocity(root, now)
									local tr = tracker[root]
									local stable = (tr and tr.stable) or 1
									local hv = Vector3.new(vel.X, 0, vel.Z)
									if tr and tr.pred then hv = tr.pred:Lerp(hv, stable) end
									if not CONFIG.PREDICT_MOVEMENT then hv = Vector3.new(0, 0, 0)
									elseif hv.Magnitude > CONFIG.MAX_PREDICT_SPEED then hv = hv.Unit * CONFIG.MAX_PREDICT_SPEED end
									local entry = { root = root, name = p.Name, dist = dist, angle = angle, hv = hv, stable = stable }
									table.insert(list, entry)
									if angle <= stateV.fov and angle < bestAngle then bestAngle = angle; best = entry end
								end
							end
						end
					end
				end
			end
			if best then aim.target = best; aim.prevRoot = best.root; aim.updatedAt = now
			else aim.target = nil end
		end

		findRemotes()
		installHook()
		S:addConn(workspace.DescendantAdded:Connect(function(inst)
			local now = os.clock()
			if now > aim.armedUntil then return end
			if inst:IsA("BasePart") then
				table.insert(recent, { part = inst, t = now })
				if #recent > 200 then table.remove(recent, 1) end
			end
		end))
		local lastPingT, lastRemoteT = 0, 0
		S:addConn(RunService.Heartbeat:Connect(function(dt)
			if not S.alive then return end
			local now = os.clock()
			if now - lastPingT >= 0.5 then lastPingT = now; refreshPing() end
			if now - lastRemoteT >= 1 then
				lastRemoteT = now
				if not (spearRemote and spearRemote.Parent) or not (vfxRemote and vfxRemote.Parent) then findRemotes() end
			end
			if aim.holding then aim.armedUntil = now + 2 end
			if stateV.silent then refreshTargets(now)
			else aim.target = nil; for i = #aim.list, 1, -1 do aim.list[i] = nil end end
			pcall(stepJob, now)
			pcall(stepSteer, now, dt)
		end))
		S.extraCleanup = function()
			shuttingDown = true
			aim.target = nil; aim.job = nil; aim.steer = nil
		end
	else
		if SAV_SCOPE then
			if SAV_SCOPE.extraCleanup then pcall(SAV_SCOPE.extraCleanup) end
			SAV_SCOPE:cleanup()
			SAV_SCOPE = nil
		end
	end
end)


    Title("Fov Killer Outline")
    -- ===== FITUR: Fov Killer Outline =====
    -- Logic asli dari FOV KILLER OUTLINE [ UDAH TESTING ].txt
    local FKO = { enabled = false, cleanupFn = nil }

    local function FKO_Start()
        if FKO.enabled then return end
        FKO.enabled = true

        local CONFIG = {
            RADIUS = 14.5, ANGLE = 90, ARC_SEGMENTS = 16, EFFECT_SEGMENTS = 36,
            THICKNESS = 0.12, TRANSPARENCY = 0.15,
            COLOR = Color3.fromRGB(255, 255, 255),
            GROUND_OFFSET = 0.12, STEP_HEIGHT = 1, MAX_DEVIATION = 2,
            MAX_DISTANCE = 100,
        }

        local killerCache = setmetatable({}, { __mode = "k" })
        local fovObjs = {}
        local fovScanT, rayFilterT, lastErrT = 0, 0, 0

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.RespectCanCollide = true

        local conns = {}

        local function isKillerChar(char, now)
            local c = killerCache[char]
            if c then
                if c.isKiller then return true end
                if now - c.t < 2 then return false end
            end
            local found = char:FindFirstChild("Lookscriptkiller", true) ~= nil
            killerCache[char] = { isKiller = found, t = now }
            return found
        end
        local function destroyFovObj(char)
            local o = fovObjs[char]
            if not o then return end
            fovObjs[char] = nil
            for _, b in ipairs(o.boxes) do pcall(function() b:Destroy() end) end
        end
        local function destroyAllFov()
            for char in pairs(fovObjs) do destroyFovObj(char) end
        end
        local function hideFovObj(o)
            if o.shown then
                o.shown = false
                for _, b in ipairs(o.boxes) do b.Visible = false end
            end
        end
        local function createFovObj(root, cam)
            local N = CONFIG.ARC_SEGMENTS
            local R = CONFIG.RADIUS
            local half = math.rad(CONFIG.ANGLE / 2)
            local xz = {}
            xz[1] = Vector3.new(0, 0, 0)
            for k = 0, N do
                local phi = -half + (2 * half) * (k / N)
                xz[2 + k] = Vector3.new(math.sin(phi) * R, 0, -math.cos(phi) * R)
            end
            local boxes = {}
            for i = 1, CONFIG.EFFECT_SEGMENTS do
                local b = Instance.new("BoxHandleAdornment")
                b.Name = "KF"
                b.Adornee = root
                b.AlwaysOnTop = false
                b.ZIndex = 1
                b.Color3 = CONFIG.COLOR
                b.Transparency = CONFIG.TRANSPARENCY
                b.Size = Vector3.new(CONFIG.THICKNESS, 0.06, 1)
                b.Visible = false
                b.Parent = cam
                boxes[i] = b
            end
            return { root = root, boxes = boxes, xz = xz, gy = nil, lastSample = 0, shown = false }
        end
        local function groundY(x, z, topY)
            local res = workspace:Raycast(Vector3.new(x, topY, z), Vector3.new(0, -40, 0), rayParams)
            if res then return res.Position.Y end
            return nil
        end
        local function setSeg(b, a, c)
            local d = c - a
            local len = d.Magnitude
            if len < 0.01 then b.Visible = false; return end
            local mid = (a + c) / 2
            b.Size = Vector3.new(CONFIG.THICKNESS, 0.06, len + CONFIG.THICKNESS)
            b.CFrame = CFrame.new(mid, mid + d)
            b.Visible = true
        end
        local function updateFovObj(o, cam, now)
            local root = o.root
            if not (root and root.Parent) then hideFovObj(o); return end
            local char = root.Parent
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then hideFovObj(o); return end
            local rpos = root.Position
            if (rpos - cam.CFrame.Position).Magnitude > CONFIG.MAX_DISTANCE then hideFovObj(o); return end
            local xz = o.xz
            local total = #xz
            if (not o.gy) or now - o.lastSample >= 0.1 then
                o.lastSample = now
                local hip = hum.HipHeight
                if hip < 0.1 then hip = 2 end
                local fallback = rpos.Y - hip - root.Size.Y / 2
                local gy = o.gy or {}
                local apex = groundY(rpos.X, rpos.Z, rpos.Y + 1) or fallback
                gy[1] = apex
                local cf = root.CFrame
                local topY = apex + CONFIG.STEP_HEIGHT
                for i = 2, total do
                    local wp = cf:PointToWorldSpace(xz[i])
                    local y = groundY(wp.X, wp.Z, topY)
                    if (not y) or math.abs(y - apex) > CONFIG.MAX_DEVIATION then y = apex end
                    gy[i] = y
                end
                o.gy = gy
            end
            local gy = o.gy
            local lp = {}
            for i = 1, total do
                lp[i] = Vector3.new(xz[i].X, gy[i] - rpos.Y + CONFIG.GROUND_OFFSET, xz[i].Z)
            end
            local path = lp
            local cumulative = { 0 }
            local pathLength = 0
            for i = 1, #path do
                local a = path[i]
                local b = path[(i % #path) + 1]
                pathLength = pathLength + (b - a).Magnitude
                cumulative[i + 1] = pathLength
            end
            if pathLength < 0.01 then hideFovObj(o); return end
            local function pointAtDistance(distance)
                distance = distance % pathLength
                for i = 1, #path do
                    local aDist = cumulative[i]
                    local bDist = cumulative[i + 1]
                    if distance <= bDist or i == #path then
                        local a = path[i]
                        local b = path[(i % #path) + 1]
                        local edgeLength = bDist - aDist
                        if edgeLength <= 0.001 then return a end
                        return a:Lerp(b, math.clamp((distance - aDist) / edgeLength, 0, 1))
                    end
                end
                return path[1]
            end
            local boxes = o.boxes
            local slotLength = pathLength / #boxes
            local segmentLength = slotLength * 0.62
            local gapOffset = (slotLength - segmentLength) * 0.5
            for i, b in ipairs(boxes) do
                local startDistance = (i - 1) * slotLength + gapOffset
                local endDistance = startDistance + segmentLength
                local a = pointAtDistance(startDistance)
                local c = pointAtDistance(endDistance)
                setSeg(b, a, c)
            end
            o.shown = true
        end
        local function updateKillerFov(now)
            if not FKO.enabled then destroyAllFov(); return end
            local cam = workspace.CurrentCamera
            if not cam then return end
            if now - rayFilterT >= 1 then
                rayFilterT = now
                local list = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character then table.insert(list, p.Character) end
                end
                rayParams.FilterDescendantsInstances = list
            end
            if now - fovScanT >= 0.25 then
                fovScanT = now
                local seen = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then
                        local char = p.Character
                        if char and char.Parent and isKillerChar(char, now) then
                            local root = char:FindFirstChild("HumanoidRootPart")
                            if root then
                                seen[char] = true
                                local o = fovObjs[char]
                                if (not o) or o.root ~= root or (not o.boxes[1])
                                    or o.boxes[1].Parent ~= cam then
                                    if o then destroyFovObj(char) end
                                    fovObjs[char] = createFovObj(root, cam)
                                end
                            end
                        end
                    end
                end
                for char in pairs(fovObjs) do
                    if not seen[char] then destroyFovObj(char) end
                end
            end
            for _, o in pairs(fovObjs) do updateFovObj(o, cam, now) end
        end

        local hbConn = RunService.Heartbeat:Connect(function()
            local now = os.clock()
            local ok, err = pcall(updateKillerFov, now)
            if not ok and now - lastErrT > 2 then
                lastErrT = now
            end
        end)
        table.insert(conns, hbConn)

        FKO.cleanupFn = function()
            destroyAllFov()
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            conns = {}
        end
    end

    local function FKO_Stop()
        if not FKO.enabled then return end
        FKO.enabled = false
        if FKO.cleanupFn then pcall(FKO.cleanupFn); FKO.cleanupFn = nil end
    end

    AddFeature("Fov Killer Outline", {
        type = "toggle",
        default = false,
        callback = function(state) if state then FKO_Start() else FKO_Stop() end end,
        color = {
            default = Color3.fromRGB(255, 255, 255),
            callback = function(c) end,
        },
    })

    Title("Generator ESP + Progress")
    -- ===== FITUR: Generator ESP + Progress =====
    -- Logic asli dari GENERATOR ESP + PROGRES [ UDAH TESTING ].txt
    local GESP = { enabled = false, cleanupFn = nil, tracked = {} }

    local function GESP_Start()
        if GESP.enabled then return end
        GESP.enabled = true

        local HIGHLIGHT_OUTLINE = Color3.fromRGB(139, 69, 19)
        local HIGHLIGHT_FILL = Color3.fromRGB(180, 110, 50)
        local BG_COLOR = Color3.fromRGB(15, 15, 15)
        local BORDER_COLOR = Color3.fromRGB(60, 60, 60)
        local TEXT_COLOR = Color3.fromRGB(255, 255, 255)
        local COLOR_START = Color3.fromRGB(235, 94, 40)
        local COLOR_MID = Color3.fromRGB(247, 197, 65)
        local COLOR_END = Color3.fromRGB(38, 194, 129)

        local trackedObjects = {}

        local function getSmoothColor(percentage)
            if percentage < 0.5 then return COLOR_START:Lerp(COLOR_MID, percentage * 2)
            else return COLOR_MID:Lerp(COLOR_END, (percentage - 0.5) * 2) end
        end
        local function getGenProgress(generator)
            local val = generator:FindFirstChild("Progress", true)
                or generator:FindFirstChild("Repair", true)
                or generator:FindFirstChild("Charge", true)
            if val and (val:IsA("NumberValue") or val:IsA("IntValue")) then
                return math.clamp(val.Value, 0, 100)
            end
            local prompt = generator:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and prompt.HoldDuration > 0 then
                local current = prompt:GetAttribute("CurrentTime")
                if current then return math.floor((current / prompt.HoldDuration) * 100) end
            end
            local attr = generator:GetAttribute("Progress")
                or generator:GetAttribute("Repair")
                or generator:GetAttribute("RepairProgress")
            if attr then return math.clamp(math.floor(attr), 0, 100) end
            return nil
        end
        local function GetAdorneePart(model)
            local candidates = {}
            for _, p in ipairs(model:GetDescendants()) do
                if p:IsA("BasePart") then
                    if p.Transparency < 0.9 then
                        local vol = p.Size.X * p.Size.Y * p.Size.Z
                        if vol < 5000 then table.insert(candidates, p) end
                    end
                end
            end
            if #candidates == 0 then
                return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
            end
            local topPart, topY = nil, -math.huge
            for _, p in ipairs(candidates) do
                if p.Position.Y > topY then topY = p.Position.Y; topPart = p end
            end
            return topPart
        end
        local function applyGeneratorESP(obj)
            if not (obj:IsA("Model") and (string.find(string.lower(obj.Name), "generator")
                or string.find(string.lower(obj.Name), "gen"))) then return end
            if trackedObjects[obj] then return end
            local oldHl = obj:FindFirstChild("GenESP_Outline")
            if oldHl then oldHl:Destroy() end
            local oldTag = obj:FindFirstChild("GenESP_Tag")
            if oldTag then oldTag:Destroy() end

            local highlight = Instance.new("Highlight")
            highlight.Name = "GenESP_Outline"
            highlight.FillColor = HIGHLIGHT_FILL
            highlight.FillTransparency = 0.7
            highlight.OutlineColor = HIGHLIGHT_OUTLINE
            highlight.OutlineTransparency = 0
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Parent = obj

            local adorneePart = GetAdorneePart(obj)
            local bbgui = Instance.new("BillboardGui")
            bbgui.Name = "GenESP_Tag"
            bbgui.Size = UDim2.new(0, 100, 0, 10)
            bbgui.AlwaysOnTop = true
            bbgui.ResetOnSpawn = false
            bbgui.LightInfluence = 0
            bbgui.DistanceLowerLimit = 0
            bbgui.DistanceUpperLimit = math.huge
            bbgui.MaxDistance = math.huge
            if adorneePart then
                bbgui.Adornee = adorneePart
                bbgui.StudsOffset = Vector3.new(0, (adorneePart.Size.Y / 2) + 0.5, 0)
            else
                bbgui.Adornee = obj
                bbgui.StudsOffset = Vector3.new(0, 3, 0)
            end
            bbgui.Parent = obj

            local backgroundFrame = Instance.new("Frame")
            backgroundFrame.Name = "MainFrame"
            backgroundFrame.Size = UDim2.new(1, 0, 1, 0)
            backgroundFrame.BackgroundColor3 = BG_COLOR
            backgroundFrame.BorderSizePixel = 1
            backgroundFrame.BorderColor3 = BORDER_COLOR
            backgroundFrame.Parent = bbgui

            local barContainer = Instance.new("Frame")
            barContainer.Name = "BarContainer"
            barContainer.Size = UDim2.new(1, 0, 1, 0)
            barContainer.BackgroundTransparency = 1
            barContainer.ClipsDescendants = true
            barContainer.Parent = backgroundFrame

            local progressBar = Instance.new("Frame")
            progressBar.Name = "ProgressBar"
            progressBar.Size = UDim2.new(0, 0, 1, 0)
            progressBar.BorderSizePixel = 0
            progressBar.BackgroundColor3 = COLOR_START
            progressBar.Parent = barContainer

            local textLabel = Instance.new("TextLabel")
            textLabel.Name = "ProgressText"
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.ZIndex = 3
            textLabel.Font = Enum.Font.GothamBold
            textLabel.TextSize = 10
            textLabel.TextColor3 = TEXT_COLOR
            textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            textLabel.TextStrokeTransparency = 0.3
            textLabel.Parent = backgroundFrame

            local alive = true
            trackedObjects[obj] = true
            task.spawn(function()
                local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Linear)
                local isFinished = false
                while obj and obj.Parent and not isFinished and alive do
                    local progress = getGenProgress(obj) or 0
                    local clampedProgress = math.clamp(progress, 0, 100)
                    local percentage = clampedProgress / 100
                    local targetColor = getSmoothColor(percentage)
                    if clampedProgress >= 100 then
                        isFinished = true
                        progressBar.BackgroundColor3 = COLOR_END
                        textLabel.Text = "100%"
                        TweenService:Create(progressBar, tweenInfo, { Size = UDim2.new(1, 0, 1, 0) }):Play()
                        task.wait(0.3)
                        backgroundFrame.Visible = false
                        if highlight then highlight.Enabled = false end
                    else
                        backgroundFrame.Visible = true
                        if highlight then highlight.Enabled = true end
                        textLabel.Text = string.format("%d%%", clampedProgress)
                        local targetSize = UDim2.new(percentage, 0, 1, 0)
                        TweenService:Create(progressBar, tweenInfo, {
                            Size = targetSize,
                            BackgroundColor3 = targetColor,
                        }):Play()
                    end
                    task.wait(0.15)
                end
            end)
        end

        local addedConn
        local descAddedConn = Workspace.DescendantAdded:Connect(function(desc)
            task.wait(0.3)
            if GESP.enabled and desc:IsA("Model") then applyGeneratorESP(desc) end
        end)

        for _, object in ipairs(Workspace:GetDescendants()) do applyGeneratorESP(object) end

        GESP.cleanupFn = function()
            pcall(function() descAddedConn:Disconnect() end)
            for obj in pairs(trackedObjects) do
                if obj and obj.Parent then
                    local hl = obj:FindFirstChild("GenESP_Outline")
                    if hl then hl:Destroy() end
                    local tag = obj:FindFirstChild("GenESP_Tag")
                    if tag then tag:Destroy() end
                end
            end
            trackedObjects = {}
        end
    end

    local function GESP_Stop()
        if not GESP.enabled then return end
        GESP.enabled = false
        if GESP.cleanupFn then pcall(GESP.cleanupFn); GESP.cleanupFn = nil end
    end

    AddFeature("Generator Esp + Progress", {
        type = "toggle",
        default = false,
        callback = function(state) if state then GESP_Start() else GESP_Stop() end end,
        color = {
            default = Color3.fromRGB(180, 110, 50),
            callback = function(c) end,
        },
    })


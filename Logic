	end
end)

-- ============================================================
-- SPEED BOOST
-- ============================================================
local SB_SCOPE = nil
local SB_CFG = { amount = 0.50 }

Hub:Bind("Speed Boost", function(state, extras)
	if state then
		if SB_SCOPE then return end
		SB_CFG.amount = math.max(tonumber(extras.amount) or 0.50, 0.50)
		local S = newScope()
		SB_SCOPE = S
		local boostEnabled = true
		local additionalSpeed = SB_CFG.amount
		local speedConn = nil

		local function monitorSpeed(character)
			local humanoid = character:WaitForChild("Humanoid", 5)
			if not humanoid then return end
			if speedConn then speedConn:Disconnect(); speedConn = nil end
			local lastBaseSpeed = humanoid.WalkSpeed
			local lastAppliedAdditional = 0
			speedConn = RunService.Heartbeat:Connect(function()
				if not humanoid or not humanoid.Parent then return end
				if not S.alive then return end
				if additionalSpeed < 0.50 then additionalSpeed = 0.50 end
				local st = humanoid:GetState()
				if st == Enum.HumanoidStateType.Climbing or st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Ragdoll then
					if lastAppliedAdditional > 0 then humanoid.WalkSpeed = lastBaseSpeed; lastAppliedAdditional = 0 end
					return
				end
				local currentWS = humanoid.WalkSpeed
				if not boostEnabled then
					if lastAppliedAdditional > 0 then humanoid.WalkSpeed = lastBaseSpeed; lastAppliedAdditional = 0 end
					return
				end
				if currentWS == (lastBaseSpeed + lastAppliedAdditional) then
					if additionalSpeed ~= lastAppliedAdditional then
						lastAppliedAdditional = additionalSpeed
						if lastBaseSpeed >= 10.10 then humanoid.WalkSpeed = lastBaseSpeed + additionalSpeed end
					end
				else
					local gameSpeed = currentWS
					if gameSpeed >= 10.10 then
						lastBaseSpeed = gameSpeed
						lastAppliedAdditional = additionalSpeed
						humanoid.WalkSpeed = gameSpeed + additionalSpeed
					else
						lastBaseSpeed = gameSpeed
						lastAppliedAdditional = 0
					end
				end
			end)
			S:addConn(speedConn)
		end
		local function onCharacterAdded(char) if char then task.wait(1); if S.alive then monitorSpeed(char) end end end
		if LocalPlayer.Character then onCharacterAdded(LocalPlayer.Character) end
		S:addConn(LocalPlayer.CharacterAdded:Connect(onCharacterAdded))

		S.extraCleanup = function()
			boostEnabled = false
			if speedConn then pcall(function() speedConn:Disconnect() end); speedConn = nil end
			local char = LocalPlayer.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then pcall(function() hum.WalkSpeed = 16 end) end
		end
	else
		if SB_SCOPE then
			if SB_SCOPE.extraCleanup then pcall(SB_SCOPE.extraCleanup) end
			SB_SCOPE:cleanup()
			SB_SCOPE = nil
		end
	end
end)


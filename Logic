    -- ===== FITUR: Infinite Lunge =====
    -- Logic asli dari Infinite Lunge [ UDAH TESTING ].txt
    local IL = { enabled = false, cleanupFn = nil, frenzyToken = 0, pursuitToken = 0 }

    local function IL_Start()
        if IL.enabled then return end
        IL.enabled = true

        local FLAGS = genv.VD_INF_FLAGS
        if type(FLAGS) ~= "table" then
            FLAGS = { Frenzy = false, Pursuit = false }
            genv.VD_INF_FLAGS = FLAGS
        end

        local hookOk = genv.VD_INF_HOOKED == true
        if not hookOk then
            local ok = pcall(function()
                local rawMT = getrawmetatable(game)
                local oldNamecall = rawMT.__namecall
                setreadonly(rawMT, false)
                rawMT.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    local mine = false
                    if checkcaller then mine = checkcaller() end
                    if not mine and method == "FireServer" then
                        local F = genv.VD_INF_FLAGS
                        local okName, name = pcall(function() return self.Name end)
                        if okName then
                            if F.Frenzy and (name == "Deactivatefromclient" or name == "PowerDoneDeactivating") then
                                return nil
                            end
                            if F.Pursuit and name == "Pursuit" then
                                local a = ...
                                if a == false then return nil end
                            end
                        end
                    end
                    return oldNamecall(self, ...)
                end)
                setreadonly(rawMT, true)
            end)
            if ok then genv.VD_INF_HOOKED = true end
        end

        FLAGS.Frenzy = true
        FLAGS.Pursuit = true

        local conns = {}
        local alive = true

        local function enableLunge()
            local char = LocalPlayer.Character
            if char then char:SetAttribute("lungeboost", 999) end
        end
        local function disableLunge()
            local char = LocalPlayer.Character
            if char then char:SetAttribute("lungeboost", 1) end
        end

        enableLunge()
        table.insert(conns, LocalPlayer.CharacterAdded:Connect(function(newChar)
            task.wait(0.8)
            if alive and IL.enabled and newChar then newChar:SetAttribute("lungeboost", 999) end
        end))

        local function startFrenzy()
            IL.frenzyToken = IL.frenzyToken + 1
            local my = IL.frenzyToken
            task.spawn(function()
                while alive and FLAGS.Frenzy and my == IL.frenzyToken do
                    pcall(function()
                        local char = LocalPlayer.Character
                        if char and char:GetAttribute("Frenzy") ~= true then
                            char:SetAttribute("Frenzy", true)
                        end
                    end)
                    task.wait(0.1)
                end
            end)
        end
        local function stopFrenzy()
            IL.frenzyToken = IL.frenzyToken + 1
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:GetAttribute("Frenzy") == true then
                    char:SetAttribute("Frenzy", false)
                    local killer = ReplicatedStorage:FindFirstChild("Remotes")
                        and ReplicatedStorage.Remotes:FindFirstChild("Killers")
                        and ReplicatedStorage.Remotes.Killers:FindFirstChild("Killer")
                    if killer then
                        local deact = killer:FindFirstChild("Deactivatefromclient")
                        if deact then deact:FireServer() end
                    end
                end
            end)
        end
        local function startPursuit()
            IL.pursuitToken = IL.pursuitToken + 1
            local my = IL.pursuitToken
            task.spawn(function()
                while alive and FLAGS.Pursuit and my == IL.pursuitToken do
                    pcall(function()
                        local char = LocalPlayer.Character
                        if char and char:GetAttribute("Pursuit") ~= true then
                            char:SetAttribute("Pursuit", true)
                        end
                    end)
                    task.wait(0.1)
                end
            end)
        end
        local function stopPursuit()
            IL.pursuitToken = IL.pursuitToken + 1
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:GetAttribute("Pursuit") == true then
                    char:SetAttribute("Pursuit", false)
                    local jason = ReplicatedStorage:FindFirstChild("Remotes")
                        and ReplicatedStorage.Remotes:FindFirstChild("Killers")
                        and ReplicatedStorage.Remotes.Killers:FindFirstChild("Jason")
                    if jason then
                        local deact = jason:FindFirstChild("Deactivatefromclient")
                        if deact then deact:FireServer() end
                    end
                end
            end)
        end

        startFrenzy()
        startPursuit()

        IL.cleanupFn = function()
            alive = false
            disableLunge()
            FLAGS.Frenzy = false
            stopFrenzy()
            FLAGS.Pursuit = false
            stopPursuit()
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            conns = {}
        end
    end

    local function IL_Stop()
        if not IL.enabled then return end
        IL.enabled = false
        if IL.cleanupFn then pcall(IL.cleanupFn); IL.cleanupFn = nil end
    end


			local ok = pcall(function() remote:FireServer("success", CONFIG.RESULT_VALUE, gen, point) end)
			Shared.Sending = false
			if ok then Sent = Sent + 1 end
			return ok
		end
		local function OnSkillCheck(...)
			if not Alive or not BypassGenEnabled or not IsAutoActive() then return end
			LastEventTime = os.clock()
			Received = Received + 1
			local gen, point = ExtractTarget(...)
			if not gen or not point then return end
			if CONFIG.SEND_DELAY > 0 then
				task.delay(CONFIG.SEND_DELAY, function() if Alive and BypassGenEnabled and IsAutoActive() then SendSuccess(gen, point) end end)
			else SendSuccess(gen, point) end
		end
		local function OnValidated() if Alive and BypassGenEnabled and IsAutoActive() then Valid = Valid + 1 end end
		local function GetCheckParts()
			for _, name in ipairs(SKILL_GUI_NAMES) do
				local gui = PlayerGui:FindFirstChild(name)
				local check = gui and gui:FindFirstChild("Check")
				if check then return check, check:FindFirstChild("Goal") end
			end
			return nil, nil
		end
		local function FallbackStep()
			if not BypassGenEnabled or not IsAutoActive() then PrevVisible = false; PrevGoal = nil; return end
			local check, goal = GetCheckParts()
			local visible = false
			local goalRotation = nil
			if check then
				local ok, value = pcall(function() return check.Visible end)
				visible = ok and value == true
				if goal then
					local ok2, rotation = pcall(function() return goal.Rotation end)
					if ok2 then goalRotation = rotation end
				end
			end
			local isNew = false
			if visible then
				if not PrevVisible then isNew = true
				elseif goalRotation and PrevGoal and math.abs(goalRotation - PrevGoal) > 0.5 then isNew = true end
			end
			PrevVisible = visible
			PrevGoal = goalRotation
			if not isNew then return end
			if os.clock() - LastEventTime < CONFIG.FALLBACK_WINDOW then return end
			if IsHealing() then return end
			local point = NearestOf(CollectPoints())
			if point and point.Parent then
				if SendSuccess(point.Parent, point) then Fallback = Fallback + 1 end
			end
		end
		local function SendScourgeHit(session)
			local remote = HitRemote
			if not remote or not remote.Parent then return false end
			Shared.Sending = true
			local ok = pcall(function() remote:FireServer(session, "success") end)
			Shared.Sending = false
			if ok then ScourgeSent = ScourgeSent + 1 end
			return ok
		end
		local function OnScourgeStart(p1, p2, p3)
			if not Alive or not BypassGenEnabled or not IsAutoActive() then return end
			local now = os.clock()
			if now - LastScourgeTime < CONFIG.SCOURGE_RETRIGGER then return end
			LastScourgeTime = now
			ScourgeToken = ScourgeToken + 1
			local token = ScourgeToken
			local session = p2
			local total = tonumber(p3) or 1
			if total < 1 then total = 1 end
			ScourgeActive = true
			S:addThread(task.spawn(function()
				for _ = 1, total do
					if not Alive or not S.alive or not BypassGenEnabled or not IsAutoActive() or token ~= ScourgeToken then break end
					task.wait(CONFIG.SCOURGE_PRE_DELAY)
					if not Alive or not S.alive or token ~= ScourgeToken then break end
					SendScourgeHit(session)
					task.wait(CONFIG.SCOURGE_GAP + math.random(1, CONFIG.SCOURGE_GAP_RANDOM) / 100)
				end
				task.wait(0.2)
				if token == ScourgeToken then ScourgeActive = false end
			end))
		end
		local function Link()
			local newEvent = FindRemote("Generator", "SkillCheckEvent")
			local newResult = FindRemote("Generator", "SkillCheckResultEvent")
			local newValid = FindRemote("Generator", "Skillcheckvalidated")
			local newScourge = FindRemoteDeep("KillerPerks", "kingscourge", "KingScourgeStart")
			local newHit = FindRemoteDeep("KillerPerks", "kingscourge", "KingScourgeHit")
			if newResult and not newResult:IsA("RemoteEvent") then newResult = nil end
			ResultRemote = newResult
			Shared.Remote = newResult
			if newEvent ~= EventRemote then
				if EventConn then pcall(function() EventConn:Disconnect() end); EventConn = nil end
				EventRemote = newEvent
				if newEvent and newEvent:IsA("RemoteEvent") then
					EventConn = newEvent.OnClientEvent:Connect(OnSkillCheck)
					S:addConn(EventConn)
				end
			end
			if newValid ~= ValidRemote then
				if ValidConn then pcall(function() ValidConn:Disconnect() end); ValidConn = nil end

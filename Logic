local function notify(t, s, i, h) pcall(function() Hub:Notify(t, s, i, h) end) end

-- helper: scope per fitur, cleanup beres
local function newScope()
	local s = { conns = {}, threads = {}, instances = {}, alive = true }
	function s:addConn(c) self.conns[#self.conns + 1] = c; return c end
	function s:addThread(t) self.threads[#self.threads + 1] = t; return t end
	function s:addInst(i) self.instances[#self.instances + 1] = i; return i end
	function s:cleanup()
		self.alive = false
		for _, t in ipairs(self.threads) do pcall(function() task.cancel(t) end) end
		self.threads = {}
		for _, c in ipairs(self.conns) do pcall(function() c:Disconnect() end) end
		self.conns = {}
		for _, i in ipairs(self.instances) do pcall(function() i:Destroy() end) end
		self.instances = {}
	end
	return s
end

-- ============================================================
-- SILENT AIM [ TOF ]
-- ============================================================
local SA_TOF_SCOPE = nil
local SA_TOF_CFG = { targetMode = "Killer", hitSound = "Hit", snapLine = false, color = Color3.fromRGB(255,255,255) }

Hub:Bind("Silent Aim [ TOF ]", function(state, extras)
	if state then
		if SA_TOF_SCOPE then return end
		SA_TOF_CFG.targetMode = extras.targetMode or "Killer"
		SA_TOF_CFG.hitSound = extras.hitSound or "Hit"
		SA_TOF_CFG.snapLine = extras.snapLine == true
		if typeof(extras.color) == "Color3" then SA_TOF_CFG.color = extras.color end

		local S = newScope()
		SA_TOF_SCOPE = S

		local PLAYER = LocalPlayer
		local GUI = PlayerGui

		local gv = (getgenv and getgenv()) or _G
		local SHARED = gv.__AIM_SHARED
		if type(SHARED) ~= "table" then
			SHARED = { hooked = false, gen = 0, remote = nil, aim = nil }
			gv.__AIM_SHARED = SHARED
		end
		SHARED.gen = (SHARED.gen or 0) + 1
		local MY_GEN = SHARED.gen

		local KILLER_MARKER_NAME = "Lookscriptkiller"
		local AUTO_AIM_ENABLED = true
		local TOOL_NAME = "Twist of Fate"
		local EXACT_GUN_NAME = "EmperorGun"
		local ARM_NAMES = { "Right Arm", "RightArm", "Right Hand", "RightHand" }
		local GUN_KEYWORDS = { "gun", "pistol", "revolver", "blaster", "firearm", "weapon", "rifle", "sniper", "awm" }
		local SNIPER_KEYWORDS = { "awm", "sniper", "rifle", "barrett", "scope" }
		local PART_WORDS = { "handle", "mesh", "barrel", "muzzle", "attachment", "bullet", "flash", "effect", "sound", "trigger", "magazine", "clip", "sight", "glow", "light", "emitter", "beam", "trail", "scope" }
		local LIMB_LIST = { "right arm", "rightarm", "left arm", "leftarm", "right hand", "righthand", "left hand", "lefthand", "right leg", "rightleg", "left leg", "leftleg", "torso", "uppertorso", "lowertorso", "head", "humanoidrootpart", "rightupperarm", "rightlowerarm", "leftupperarm", "leftlowerarm" }
		local PROJECTILE_SPEED = 260
		local HIT_WATCH_TIME = 2.5
		local HIT_DEBOUNCE = 0.5
		local STUN_SPEED_RATIO = 0.3
		local HIT_SOUNDS = { Hit = "5276754334", Yareu = "72500584153933", Quack = "9068554227" }
		local HIT_SOUND_ENABLED = true
		local HIT_SOUND_VOLUME = 2
		local targetMode = (SA_TOF_CFG.targetMode == "Survivor") and "Survivors" or SA_TOF_CFG.targetMode
		local hitSoundId = HIT_SOUNDS[SA_TOF_CFG.hitSound] or HIT_SOUNDS.Hit
		local LASER_ENABLED = SA_TOF_CFG.snapLine
		local LASER_COLOR = SA_TOF_CFG.color

		local FireRemote = ReplicatedStorage:FindFirstChild("Remotes")
		FireRemote = FireRemote and FireRemote:FindFirstChild("Items")
		FireRemote = FireRemote and FireRemote:FindFirstChild(TOOL_NAME)
		FireRemote = FireRemote and FireRemote:FindFirstChild("Fire")
		if not FireRemote then
			warn("[FluxLogic] Silent Aim TOF: FireRemote tidak ada, fitur tidak aktif.")
			SA_TOF_SCOPE = nil
			S:cleanup()
			return
		end

		local LIMB_NAMES = {}
		for _, n in ipairs(LIMB_LIST) do LIMB_NAMES[n] = true end
		local ARM_SET = {}
		for _, n in ipairs(ARM_NAMES) do ARM_SET[string.lower(n)] = true end

		local function GetCharacter() return PLAYER.Character end
		local function GetLookVector() local cam = workspace.CurrentCamera; return cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1) end
		local function MatchAny(name, list)
			local lowered = string.lower(name)
			for _, k in ipairs(list) do if string.find(lowered, k, 1, true) then return true end end
			return false
		end

		local track = { body = nil, pos = Vector3.new(0, 0, 0), t = 0, vel = Vector3.new(0, 0, 0) }
		local function ResetTrack() track.body = nil; track.pos = Vector3.new(0, 0, 0); track.t = 0; track.vel = Vector3.new(0, 0, 0) end
		local function UpdateVelocity(body)
			local now = tick()
			local curPos = body.Position
			if track.body ~= body then
				track.body = body; track.pos = curPos; track.t = now; track.vel = Vector3.new(0, 0, 0); return track.vel
			end
			local dt = now - track.t
			if dt > 0.5 then track.pos = curPos; track.t = now; track.vel = Vector3.new(0, 0, 0); return track.vel end
			if dt >= 0.03 then track.vel = (curPos - track.pos) / dt; track.pos = curPos; track.t = now end
			return track.vel
		end
		local function GetVelocity(body)
			local vel = Vector3.new(0, 0, 0)
			if track.body == body then vel = track.vel end
			if vel.Magnitude < 1 then
				local ok, av = pcall(function() return body.AssemblyLinearVelocity end)
				if ok and av and av.Magnitude >= 1 then vel = av end
			end
			return vel
		end

		local PREDICT_BIAS = 0.15
		local function PredictPosition(fromPos, body)
			local targetPos = body.Position
			local vel = GetVelocity(body)
			local dist = (targetPos - fromPos).Magnitude
			local tFlight = dist / PROJECTILE_SPEED
			for _ = 1, 2 do
				local predicted = targetPos + vel * (tFlight + PREDICT_BIAS)
				dist = (predicted - fromPos).Magnitude
				tFlight = dist / PROJECTILE_SPEED
			end
			local finalPos = targetPos + vel * (tFlight + PREDICT_BIAS)
			local offset = finalPos - targetPos
			if offset.Magnitude > 3.5 then finalPos = targetPos + offset.Unit * 3.5 end
			return finalPos
		end

		local function GetKillerBody(character)
			if not character then return nil end
			local body = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("LowerTorso")
			if body then return body end
			return character:FindFirstChild("HumanoidRootPart")
		end

		local SCPCache = {}
		local SCPCacheTimer = 0
		local function GetSCPs()
			if tick() - SCPCacheTimer < 0.5 then return SCPCache end
			local newTargets = {}
			local mapFolder = workspace:FindFirstChild("Map")
			if mapFolder then
				for _, container in ipairs(mapFolder:GetDescendants()) do
					if container:IsA("Model") and not Players:GetPlayerFromCharacter(container) then
						local attributes = container:GetAttributes()
						if container:GetAttribute("CorpseCreated0492") or next(attributes) ~= nil then
							local root = container:FindFirstChild("HumanoidRootPart")
							if root then table.insert(newTargets, root) end
						end
					end
				end
			end
			SCPCache = newTargets
			SCPCacheTimer = tick()
			return SCPCache
		end

		local function GetTarget()
			local myChar = GetCharacter()
			local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
			if not myHRP then return nil, nil end
			if targetMode == "Killer" then
				local nearestBody, nearestName, nearestDistance = nil, nil, math.huge
				for _, player in ipairs(Players:GetPlayers()) do
					if player ~= PLAYER then
						local char = player.Character
						if char and char:FindFirstChild(KILLER_MARKER_NAME, true) then
							local body = GetKillerBody(char)
							if body then
								local distance = (body.Position - myHRP.Position).Magnitude
								if distance < nearestDistance then
									nearestDistance = distance; nearestBody = body; nearestName = player.Name
								end
							end
						end
					end
				end
				return nearestBody, nearestName
			end
			local cam = workspace.CurrentCamera
			if not cam then return nil, nil end
			local camPos = cam.CFrame.Position
			local camLook = cam.CFrame.LookVector
			local bestBody, bestName, bestDot = nil, nil, -math.huge
			if targetMode == "Survivors" then
				for _, player in ipairs(Players:GetPlayers()) do
					if player ~= PLAYER and player.Team and player.Character then
						local tn = player.Team.Name
						if tn == "Survivors" or tn == "Survivor" then
							local body = GetKillerBody(player.Character)
							if body then
								local dir = body.Position - camPos
								if dir.Magnitude > 0.001 then
									local dot = camLook:Dot(dir.Unit)
									if dot > 0.5 and dot > bestDot then bestDot = dot; bestBody = body; bestName = player.Name end
								end
							end
						end
					end
				end
			elseif targetMode == "SCP" then
				for _, root in ipairs(GetSCPs()) do
					if root and root.Parent then
						local dir = root.Position - camPos
						if dir.Magnitude > 0.001 then
							local dot = camLook:Dot(dir.Unit)
							if dot > 0.5 and dot > bestDot then bestDot = dot; bestBody = root; bestName = root.Parent.Name end
						end
					end
				end
			end
			return bestBody, bestName
		end

		local targetBody, targetName = nil, nil
		local myRootRef = nil
		local function RefreshTarget()
			local char = GetCharacter()
			local root = char and char:FindFirstChild("HumanoidRootPart")
			myRootRef = root
			if root then
				local body, name = GetTarget()
				targetBody = body; targetName = name
				if body then UpdateVelocity(body) end
			else
				targetBody = nil; targetName = nil
			end
		end

		local hitWatch = nil
		local lastHitAt = 0
		local function PlayHitSound()
			if not HIT_SOUND_ENABLED then return end
			pcall(function()
				local snd = Instance.new("Sound")
				snd.Name = "TOF_HitSound"
				snd.SoundId = "rbxassetid://" .. tostring(hitSoundId)
				snd.Volume = HIT_SOUND_VOLUME
				snd.Parent = SoundService
				snd:Play()
				Debris:AddItem(snd, 8)
			end)
		end
		local function StunAttributeActive(char)
			local ok, attrs = pcall(function() return char:GetAttributes() end)
			if not ok or type(attrs) ~= "table" then return false end
			for name, value in pairs(attrs) do
				if string.find(string.lower(tostring(name)), "stun", 1, true) then
					if value ~= nil and value ~= false and value ~= 0 then return true end
				end
			end
			return false
		end
		local function MarkShot(body)
			if not body or not body.Parent then return end
			local char = body.Parent
			local hum = char:FindFirstChildOfClass("Humanoid")
			if not hum then hitWatch = nil; return end
			hitWatch = { char = char, hum = hum, t0 = os.clock(), hp = hum.Health, ws = hum.WalkSpeed, stun = StunAttributeActive(char) }
		end
		local function StepHit()
			local w = hitWatch
			if not w then return end
			local now = os.clock()
			if now - w.t0 > HIT_WATCH_TIME or not w.char.Parent or not w.hum.Parent then hitWatch = nil; return end
			local hum = w.hum
			local why = nil
			if hum.Health < w.hp - 0.01 then why = "damage"
			elseif w.ws > 0 and hum.WalkSpeed <= w.ws * STUN_SPEED_RATIO then why = "stun"
			elseif not w.stun and StunAttributeActive(w.char) then why = "stun" end
			if hum.Health > w.hp then w.hp = hum.Health end
			if hum.WalkSpeed > w.ws then w.ws = hum.WalkSpeed end
			if why then
				hitWatch = nil
				if now - lastHitAt >= HIT_DEBOUNCE then lastHitAt = now; PlayHitSound() end
			end
		end

		S:addThread(task.spawn(function()
			while S.alive and SHARED.gen == MY_GEN do
				pcall(StepHit)
				task.wait(0.03)
			end
		end))

		local function SilentDirection()
			if not AUTO_AIM_ENABLED then return nil end
			local root = myRootRef
			if not root or root.Parent == nil then
				local char = GetCharacter()
				root = char and char:FindFirstChild("HumanoidRootPart")
			end
			local body = targetBody
			if not body or body.Parent == nil then body = GetTarget() end
			if not body or not root then return nil end
			if body.Parent == nil or root.Parent == nil then return nil end
			local fromPos = root.Position
			local predictedPos = PredictPosition(fromPos, body)
			local d = predictedPos - fromPos
			local m = d.Magnitude
			if m < 0.001 then return nil end
			pcall(MarkShot, body)
			return d / m
		end

		SHARED.remote = FireRemote
		SHARED.aim = SilentDirection

		local function InstallHook()
			if SHARED.hooked then return true end
			if not (hookmetamethod and getnamecallmethod and setnamecallmethod and newcclosure) then return false end
			local ok = pcall(function()
				local old
				old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
					local method = getnamecallmethod()
					if method == "FireServer" and self == SHARED.remote then
						local mine = false
						if checkcaller then mine = checkcaller() end
						if not mine then
							local fn = SHARED.aim
							if fn then
								local gun, dir = ...
								if typeof(gun) == "Instance" and typeof(dir) == "Vector3" then
									local okAim, newDir = pcall(fn)
									if okAim and typeof(newDir) == "Vector3" then
										setnamecallmethod("FireServer")
										return old(self, gun, newDir, select(3, ...))
									end
								end
							end
						end
						setnamecallmethod("FireServer")
						return old(self, ...)
					end
					return old(self, ...)
				end))
			end)
			if ok then SHARED.hooked = true end
			return ok
		end
		local silentMode = InstallHook()

		S:addThread(task.spawn(function()
			while S.alive and SHARED.gen == MY_GEN do
				pcall(RefreshTarget)
				task.wait(0.1)
			end
		end))

		local gunCache = { char = nil, gun = nil }
		local scopedCache = setmetatable({}, { __mode = "k" })
		local function IsCandidate(inst) return inst:IsA("BasePart") or inst:IsA("Model") or inst:IsA("Accessory") end
		local function GetTwist(char) return char:FindFirstChild(TOOL_NAME) or char:FindFirstChild(TOOL_NAME, true) end
		local function FindArm(twist)
			for _, name in ipairs(ARM_NAMES) do local arm = twist:FindFirstChild(name, true); if arm then return arm end end
			return nil
		end
		local function ScoreCandidate(inst, depth)
			local lowered = string.lower(inst.Name)
			if LIMB_NAMES[lowered] then return nil end
			local score = 0
			if inst.Name == EXACT_GUN_NAME then score = score + 1000 end
			for _, k in ipairs(GUN_KEYWORDS) do if string.find(lowered, k, 1, true) then score = score + 60; break end end
			for _, w in ipairs(PART_WORDS) do if string.find(lowered, w, 1, true) then score = score - 40; break end end
			if inst:IsA("Model") then score = score + 15 end
			local parent = inst.Parent
			if parent and ARM_SET[string.lower(parent.Name)] then score = score + 20 end
			return score - depth * 4
		end
		local function Collect(root, depth, best)
			for _, child in ipairs(root:GetChildren()) do
				if IsCandidate(child) then
					local s = ScoreCandidate(child, depth)
					if s and s > best.score then best.score = s; best.inst = child end
				end
				if depth < 6 then Collect(child, depth + 1, best) end
			end
		end
		local function FindGun(twist)
			local exact = twist:FindFirstChild(EXACT_GUN_NAME, true)
			if exact then return exact end
			local best = { score = -math.huge, inst = nil }
			Collect(twist, 0, best)
			if best.inst then return best.inst end
			return FindArm(twist) or twist
		end
		local function GetGun(char)
			if gunCache.char == char and gunCache.gun and gunCache.gun.Parent and gunCache.gun:IsDescendantOf(char) then return gunCache.gun end
			gunCache.char = nil; gunCache.gun = nil
			local twist = GetTwist(char)
			if not twist then return nil end
			local gun = FindGun(twist)
			if not gun then return nil end
			gunCache.char = char; gunCache.gun = gun
			return gun
		end
		local function IsScopedWeapon(char)
			local twist = GetTwist(char)
			if not twist then return false end
			if scopedCache[twist] then return true end
			local result = MatchAny(twist.Name, SNIPER_KEYWORDS)
			if not result then
				for _, inst in ipairs(twist:GetDescendants()) do
					if MatchAny(inst.Name, SNIPER_KEYWORDS) then result = true; break end
				end
			end
			if result then scopedCache[twist] = true end
			return result
		end

		local function GetAimDirectionDirect(myHRP)
			if AUTO_AIM_ENABLED then
				local body = targetBody
				if not body or body.Parent == nil then body = GetTarget() end
				if body then
					local fromPos = myHRP.Position
					local predictedPos = PredictPosition(fromPos, body)
					local d = predictedPos - fromPos
					if d.Magnitude > 0.001 then return d.Unit end
				end
			end
			return GetLookVector()
		end
		local function Shoot()
			local char = GetCharacter()
			if not char then return end
			local myHRP = char:FindFirstChild("HumanoidRootPart")
			if not myHRP then return end
			local gun = GetGun(char)
			if not gun then return end
			local direction = GetAimDirectionDirect(myHRP)
			pcall(MarkShot, targetBody)
			pcall(function() FireRemote:FireServer(gun, direction) end)
		end

		local pending = nil
		local function Release(p)
			if pending ~= p then return end
			pending = nil
			Shoot()
		end
		local function OnPress(input, kind)
			if silentMode or SHARED.gen ~= MY_GEN then return end
			local char = GetCharacter()
			if not char then return end
			if IsScopedWeapon(char) then
				local p = { input = input, kind = kind }
				pending = p
				if kind == "touch" then
					local c
					c = input.Changed:Connect(function()
						local s = input.UserInputState
						if s == Enum.UserInputState.End or s == Enum.UserInputState.Cancel then
							if c then c:Disconnect() end
							Release(p)
						end
					end)
				end
			else
				Shoot()
			end
		end

		S:addConn(UserInputService.InputEnded:Connect(function(input)
			if silentMode or SHARED.gen ~= MY_GEN then return end
			local p = pending
			if not p then return end
			if p.kind == "mouse" then
				if input.UserInputType == Enum.UserInputType.MouseButton1 then Release(p) end
			elseif input == p.input then
				Release(p)
			end
		end))

		local aimHeld, aimInput, aimKind = false, nil, nil
		local function EndAim() aimHeld = false; aimInput = nil; aimKind = nil end
		local function BeginAim(input, kind)
			local char = GetCharacter()
			if not char or not GetTwist(char) then return end
			aimHeld = true; aimInput = input; aimKind = kind
			if kind == "touch" then
				local c
				c = input.Changed:Connect(function()
					local s = input.UserInputState
					if s == Enum.UserInputState.End or s == Enum.UserInputState.Cancel then
						if c then c:Disconnect() end
						if aimInput == input then EndAim() end
					end
				end)
			end
		end

		S:addConn(UserInputService.InputEnded:Connect(function(input)
			if SHARED.gen ~= MY_GEN then return end
			if aimHeld and aimKind == "mouse" and input.UserInputType == Enum.UserInputType.MouseButton1 then EndAim() end
		end))

		-- Laser
		local oldLaser = workspace:FindFirstChild("AimLaser")
		if oldLaser then oldLaser:Destroy() end
		local LaserBeam = nil
		local laserToolCache = nil
		local function updateLaser(originPos, targetPos)
			if not LaserBeam or not LaserBeam.Parent then
				LaserBeam = Instance.new("Part")
				LaserBeam.Name = "AimLaser"
				LaserBeam.Anchored = true
				LaserBeam.CanCollide = false
				pcall(function() LaserBeam.CanTouch = false end)
				pcall(function() LaserBeam.CanQuery = false end)
				pcall(function() LaserBeam.Massless = true end)
				LaserBeam.CastShadow = false
				LaserBeam.Material = Enum.Material.Neon
				LaserBeam.Color = LASER_COLOR
				LaserBeam.Transparency = 1
				LaserBeam.Size = Vector3.new(0.05, 0.05, 0.05)
				LaserBeam.Parent = workspace
			end
			local dist = (targetPos - originPos).Magnitude
			if dist < 0.01 then LaserBeam.Transparency = 1; return end
			LaserBeam.Size = Vector3.new(0.05, 0.05, dist)
			LaserBeam.CFrame = CFrame.new((originPos + targetPos) / 2, targetPos)
			LaserBeam.Transparency = 0
		end
		local function hideLaser() if LaserBeam then LaserBeam.Transparency = 1 end end
		local function clearLaser() if LaserBeam then LaserBeam:Destroy(); LaserBeam = nil end end
		local function GetLaserOrigin(char, root)
			if char:GetAttribute("IsCarried") then return root.Position + root.CFrame.LookVector * 2 end
			local tool = laserToolCache
			if not tool or tool.Parent == nil or not tool:IsDescendantOf(char) then
				tool = char:FindFirstChild(TOOL_NAME, true)
				laserToolCache = tool
			end
			if tool then
				local gun = tool:FindFirstChild(EXACT_GUN_NAME, true) or FindArm(tool) or tool
				local part = nil
				if gun:IsA("BasePart") then part = gun else part = gun:FindFirstChildWhichIsA("BasePart", true) end
				if part then return part.Position end
			end
			return Vector3.new(root.Position.X, root.Position.Y + 1.5, root.Position.Z)
		end
		local function UpdateLaser()
			if not LASER_ENABLED or not AUTO_AIM_ENABLED then hideLaser(); return end

        end))
        local pressStart, pressInput, startAbs = nil, nil, nil
        local dragMoved, dragging = false, false
        local MOVE_THRESHOLD = 8
        local function GetScreenSize()
            local w, h = 0, 0
            pcall(function()
                local cam = workspace.CurrentCamera
                if cam then w = cam.ViewportSize.X; h = cam.ViewportSize.Y end
            end)
            if w <= 0 or h <= 0 then
                pcall(function() w = gui.AbsoluteSize.X; h = gui.AbsoluteSize.Y end)
            end
            if w <= 0 or h <= 0 then w, h = 1280, 720 end
            return w, h

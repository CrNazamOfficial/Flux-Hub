            if not BypassGenEnabled then return end
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local bestPoint, bestDist = nil, math.huge
            for _, gen in pairs(GetAllGenerators()) do
                for _, point in pairs(GetGeneratorPoints(gen)) do
                    if point and point.Parent then
                        local d = (hrp.Position - point.Position).Magnitude
                        if d < bestDist then bestDist = d; bestPoint = point end
                    end
                end
            end
            if bestPoint and bestDist <= 8 then
                local genModel = bestPoint.Parent
                if genModel and ProcessedGens[genModel] then ProcessedGens[genModel] = nil end
                task.spawn(function() DoMultiRepairPlain(bestPoint) end)
            end
        end))
        UpdateButtonState()
    end


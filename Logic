            table.insert(conns, player:GetAttributeChangedSignal("IsKiller"):Connect(updateKillerStatus))
        end
        for _, p in ipairs(Players:GetPlayers()) do applyKillerESP(p) end
        local addedConn = Players.PlayerAdded:Connect(applyKillerESP)

        KESP.cleanupFn = function()
            pcall(function() addedConn:Disconnect() end)
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            conns = {}
            for char in pairs(tracked) do
                if char and char.Parent then
                    local hl = char:FindFirstChild("KillerESP_Chams")
                    if hl then hl:Destroy() end
                end
            end
            tracked = {}
        end
    end

    local function KESP_Stop()
        if not KESP.enabled then return end
        KESP.enabled = false
        if KESP.cleanupFn then pcall(KESP.cleanupFn); KESP.cleanupFn = nil end
    end


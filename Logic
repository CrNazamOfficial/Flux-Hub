                            aim.armedUntil = os.clock() + 3
                        end
                        if setNm then pcall(setNm, method) end
                        return oldNamecall(self, ...)
                    end
                end
                return oldNamecall(self, ...)
            end
            local wrapped = handler
            if newcclosure then
                local ok, w = pcall(newcclosure, handler)
                if ok and w then wrapped = w end
            end
            if hookmetamethod then
                local ok, old = pcall(hookmetamethod, game, "__namecall", wrapped)
                if ok and old then
                    oldNamecall = old; hookInstalled = true; return
                end
            end
            if getrawmetatable then
                pcall(function()
                    local mt = getrawmetatable(game)
                    local old = mt.__namecall
                    if setreadonly then setreadonly(mt, false)
                    elseif make_writeable then make_writeable(mt) end
                    oldNamecall = old
                    mt.__namecall = wrapped
                    hookInstalled = true
                end)
            end
        end
        local function polyFit1(ts, vs, n)
            local st, sv, stt, stv = 0, 0, 0, 0
            for i = 1, n do
                local t, v = ts[i], vs[i]
                st = st + t; sv = sv + v; stt = stt + t * t; stv = stv + t * v
            end
            local D = n * stt - st * st
            if math.abs(D) < 1e-12 then return nil end
            local b = (n * stv - st * sv) / D
            local a = (sv - b * st) / n
            return a, b
        end
        local function det3(a, b, c, d, e, f, g, h, i)
            return a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)
        end
        local function polyFit2(ts, vs, n)
            local s1, s2, s3, s4 = 0, 0, 0, 0
            local r0, r1, r2 = 0, 0, 0
            for i = 1, n do
                local t, v = ts[i], vs[i]
                local t2 = t * t
                s1 = s1 + t; s2 = s2 + t2; s3 = s3 + t2 * t; s4 = s4 + t2 * t2
                r0 = r0 + v; r1 = r1 + v * t; r2 = r2 + v * t2
            end
            local D = det3(n, s1, s2, s1, s2, s3, s2, s3, s4)
            if math.abs(D) < 1e-12 then return nil end
            local a = det3(r0, s1, s2, r1, s2, s3, r2, s3, s4) / D
            local b = det3(n, r0, s2, s1, r1, s3, s2, r2, s4) / D
            local c = det3(n, s1, r0, s1, s2, r1, s2, s3, r2) / D
            return a, b, c
        end
        local function finishJob(job, now)
            local s = job.samples
            local n = #s
            local avg = nil
            if n >= 2 then
                local span = s[n].t - s[1].t
                if span > 0.05 then avg = (s[n].pos - s[1].pos).Magnitude / span end
            end
            if state.silent and job.root and job.root.Parent and job.part and job.part.Parent then
                local expected = job.speed * calib.speedScale
                if avg and avg < expected * CONFIG.WEAK_THROW_RATIO then
                    aim.steerText = "Homing: lemparan lemah (jatuh normal)"
                    return
                end
                aim.steer = {
                    part = job.part, root = job.root, name = job.name,
                    t0 = now, speed = avg or expected,
                    minSpeed = expected * CONFIG.MIN_SPEED_RATIO, slow = 0,
                }
                aim.steerText = "Homing: aktif -> " .. tostring(job.name)
            end
        end
        local function pickPart(job, now)
            for i = 1, #recent do
                local e = recent[i]
                local p = e.part
                if p and p.Parent and e.t >= job.t0 - 0.5 and not usedParts[p]
                    and not job.cands[p] and not isCharacterPart(p) then
                    if (p.Position - job.origin).Magnitude <= 40 then
                        job.cands[p] = { pos = p.Position, t = now }
                    end
                end
            end
            local best, bestSpeed = nil, 0
            for p, c in pairs(job.cands) do
                if not p.Parent then job.cands[p] = nil
                else
                    local age = now - c.t
                    if age >= 0.1 then
                        local sp = (p.Position - c.pos).Magnitude / age
                        if sp > bestSpeed then bestSpeed = sp; best = p end
                    end
                end
            end
            if best and bestSpeed >= job.speed * 0.3 then return best end
            return nil
        end
        local function stepJob(now)
            for i = #recent, 1, -1 do
                if now - recent[i].t > 4 then table.remove(recent, i) end
            end

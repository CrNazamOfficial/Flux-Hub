-- ANTI FALL DAMAGE
-- ============================================================
local AFD_SCOPE = nil

Hub:Bind("Anti Fall Damage", function(state, extras)
	if state then
		if AFD_SCOPE then return end
		local S = newScope()
		AFD_SCOPE = S
		local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
		local Mechanics = Remotes and Remotes:FindFirstChild("Mechanics")
		local FallEvent = Mechanics and Mechanics:FindFirstChild("Fall")
		if not FallEvent then
			warn("[FluxLogic] Anti Fall Damage: remote Fall tidak ada.")
			AFD_SCOPE = nil
			S:cleanup()
			return
		end
		local enabled = true
		if not getrawmetatable then
			warn("[FluxLogic] Anti Fall Damage: executor tidak mendukung hook.")
			AFD_SCOPE = nil
			S:cleanup()
			return
		end
		local mt = getrawmetatable(game)
		local oldNamecall = mt.__namecall
		local function handler(self, ...)
			if enabled and self == FallEvent and (getnamecallmethod() == "FireServer" or getnamecallmethod() == "fireServer") then
				local args = {...}
				args[1] = 0
				return oldNamecall(self, unpack(args))
			end
			return oldNamecall(self, ...)
		end
		if newcclosure then local ok, w = pcall(newcclosure, handler); if ok and w then handler = w end end
		setreadonly(mt, false)
		mt.__namecall = handler
		setreadonly(mt, true)
		S.extraCleanup = function()
			enabled = false
			pcall(function()
				setreadonly(mt, false)
				if mt.__namecall == handler then mt.__namecall = oldNamecall end
				setreadonly(mt, true)
			end)
		end
	else
		if AFD_SCOPE then
			if AFD_SCOPE.extraCleanup then pcall(AFD_SCOPE.extraCleanup) end
			AFD_SCOPE:cleanup()
			AFD_SCOPE = nil
		end
	end
end)


    local function NearestOf(list)
        if #list == 0 then return nil end
        local root = GetRoot()
        if not root then return list[1] end
        local best, bestDist = nil, math.huge
        for _, point in ipairs(list) do
            if point.Parent then
                local d = (point.Position - root.Position).Magnitude
                if d < bestDist then bestDist = d; best = point end
            end
        end
        return best
    end
    local function ExtractTarget(...)
        local count = select("#", ...)
        local args = { ... }
        local a, b = args[1], args[2]
        if typeof(a) == "Instance" and typeof(b) == "Instance" then return a, b end
        local gen, point = nil, nil
        for i = 1, count do
            local v = args[i]
            if typeof(v) == "Instance" then
                if IsPointName(v.Name) then if not point then point = v end
                elseif not gen then gen = v end
            end
        end
        if point and (not gen or gen == point) then gen = point.Parent end
        if gen and not point then point = NearestOf(GetPointsDeep(gen)) end
        if gen and point then return gen, point end
        return nil, nil
    end

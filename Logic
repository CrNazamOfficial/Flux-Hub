            local Now = os.clock()
            if not Check or not Check.Parent then RefreshReferences() end
            local Visible = Check ~= nil and Check.Parent ~= nil and Check.Visible == true
            if Visible then LastVisible = Now
            elseif ScourgeActive and Now - LastVisible > SCOURGE_TIMEOUT then
                ScourgeActive = false; Busy = false
            end
            if not Enabled then PreviousVisible = false; return end
            local WasVisible = PreviousVisible

            if not WasVisible then
                Busy = false
                if not ScourgeActive and Mode == "INSTANT" then InstantNormal() end
            end
            if not ScourgeActive then
                if not Busy then
                    local ShouldTrigger = false
                    if Mode == "PERFECT" then ShouldTrigger = IsPerfect()

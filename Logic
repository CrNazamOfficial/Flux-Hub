    local function StartAutoRepairLoop(genModel)
        AutoCurrentGenModel = genModel
        if AutoRepairThread then task.cancel(AutoRepairThread); AutoRepairThread = nil end
        StopAutoRepair()
        AutoRepairThread = task.spawn(function()
            while Alive and AutoRepairEnabled and BypassGenEnabled do
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then task.wait(0.1); continue end
                local foundPoint = nil
                for _, gen in pairs(GetAllGenerators()) do
                    for _, point in pairs(GetGeneratorPoints(gen)) do
                        if point and point.Parent
                            and (hrp.Position - point.Position).Magnitude <= CONFIG.AUTO_SEARCH_RADIUS then
                            foundPoint = point; break
                        end
                    end
                    if foundPoint then break end
                end
                if foundPoint then
                    AutoCurrentPoint = foundPoint
                    local now = tick()
                    if now - LastFireTime >= CONFIG.AUTO_FIRE_INTERVAL then
                        local re = getRepairEvent()
                        if re then
                            PlayRepairAnim()
                            LastFireTime = tick()
                            pcall(function() re:FireServer(foundPoint, true) end)
                        end
                    end
                else
                    if AutoCurrentPoint then
                        StopAutoRepair()
                        AutoRepairEnabled = false
                        if AutoCurrentGenModel then ProcessedGens[AutoCurrentGenModel] = nil; AutoCurrentGenModel = nil end
                        break
                    end
                end
                task.wait(0.1)
            end
            StopAutoRepair()
        end)
    end

    local function clearProcessedOnLeave(genModel, targetPoint)
        if not targetPoint or not targetPoint.Parent then ProcessedGens[genModel] = nil; return end
        local c1, c2
        c1 = targetPoint:GetAttributeChangedSignal("IsRepairing"):Connect(function()
            if not targetPoint or not targetPoint.Parent then
                ProcessedGens[genModel] = nil
                if c1 then c1:Disconnect() end
                if c2 then c2:Disconnect() end
                return
            end
            if targetPoint:GetAttribute("IsRepairing") == false then
                ProcessedGens[genModel] = nil
                if c1 then c1:Disconnect() end
                if c2 then c2:Disconnect() end
            end
        end)
        c2 = targetPoint.AncestryChanged:Connect(function()
            if not targetPoint.Parent then
                ProcessedGens[genModel] = nil
                if c1 then c1:Disconnect() end
                if c2 then c2:Disconnect() end
            end
        end)
    end
    local function waitForGenComplete(genModel, timeout)
        local start = tick()
        while tick() - start < (timeout or 30) do
            if not genModel or not genModel.Parent then return false end
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp or not hrp.Parent then return false end
            local progress = genModel:GetAttribute("RepairProgress")
            if progress ~= nil and type(progress) == "number" then
                if progress >= 99.5 or progress >= 0.995 then return true end
            end
            if genModel:GetAttribute("Completed") == true or genModel:GetAttribute("IsRepaired") == true then return true end
            task.wait(0.1)
        end
        return false
    end

    local function DoMultiRepairPlain(targetPoint)
        if IsBypassRunning then return end
        if not BypassGenEnabled then return end
        if not targetPoint or not targetPoint.Parent then return end
        local genModel = targetPoint.Parent
        if not genModel then return end
        if ProcessedGens[genModel] then return end
        Injected[targetPoint] = nil
        IsBypassRunning = true
        BypassStartTime = tick()
        UserMovedDuringBypass = false
        RefreshButton()
        local ok, err = pcall(function()
            local re = getRepairEvent()
            if not re then return end
            ProcessedGens[genModel] = true
            clearProcessedOnLeave(genModel, targetPoint)
            local allPoints = GetGeneratorPoints(genModel)
            if #allPoints < CONFIG.MIN_TITIK_REPAIR then ProcessedGens[genModel] = nil; return end
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then ProcessedGens[genModel] = nil; return end
            local originalPosition = hrp.Position
            local originalRot = hrp.CFrame - hrp.CFrame.Position
            hrp.Anchored = false
            task.wait(0.03)
            local genBody = genModel:FindFirstChild("GeneratorBody") or genModel.PrimaryPart
            local count = 0
            for _, point in pairs(allPoints) do
                if not BypassGenEnabled then break end
                if not hrp.Parent then break end
                if not point or not point.Parent then count = count + 1; continue end
                count = count + 1
                if count > CONFIG.MAX_TITIK then break end
                if not hrp.Parent then break end
                local lookAt = genBody and genBody.Position or point.Position
                local targetCFrame
                if (lookAt - point.Position).Magnitude > 0.5 then
                    targetCFrame = CFrame.lookAt(point.Position, lookAt)
                else targetCFrame = CFrame.new(point.Position) * originalRot end
                SmoothMoveTo(targetCFrame, CONFIG.SMOOTH_MOVE_DURATION)
                task.wait(CONFIG.SMOOTH_SETTLE_DELAY)
                MarkInjected(point)
                pcall(function() re:FireServer(point, true) end)
                if not waitForRepairing(point, CONFIG.CONFIRM_TIMEOUT) then
                    pcall(function() re:FireServer(point, false) end)
                    task.wait(CONFIG.TP_DELAY)
                    if hrp.Parent and point.Parent then
                        SmoothMoveTo(targetCFrame, CONFIG.SMOOTH_MOVE_DURATION)
                        task.wait(CONFIG.SMOOTH_SETTLE_DELAY)
                    end
                    MarkInjected(point)
                    pcall(function() re:FireServer(point, true) end)
                    waitForRepairing(point, CONFIG.RETRY_TIMEOUT)
                end
            end
            if hrp.Parent then
                hrp.Anchored = false
                SmoothMoveTo(CFrame.new(originalPosition) * originalRot, CONFIG.SMOOTH_MOVE_DURATION)
            end
            waitForGenComplete(genModel, 10)
            pcall(function() re:FireServer(targetPoint, false) end)
            StandUpCleanly()
            if hrp.Parent then pcall(function() hrp.Anchored = false end) end
            task.wait(CONFIG.STAND_UP_DELAY)
            if CONFIG.AUTO_REPAIR_AFTER_BYPASS and BypassGenEnabled and not UserMovedDuringBypass then
                AutoRepairEnabled = true
                StartAutoRepairLoop(genModel)
            end
        end)
        if not ok then dbg("Bypass error: " .. tostring(err)) end
        local char2 = LocalPlayer.Character
        local hrp2 = char2 and char2:FindFirstChild("HumanoidRootPart")
        if hrp2 and hrp2.Parent then pcall(function() hrp2.Anchored = false end) end
        IsBypassRunning = false
        RefreshButton()
    end


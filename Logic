		end
		local function waitForRepairing(point, timeout)
			local start = tick()
			while tick() - start < (timeout or 1) do
				if not point or not point.Parent then return false end
				if point:GetAttribute("IsRepairing") == true then return true end
				task.wait(CONFIG.CONFIRM_POLL)
			end
			return false
		end
		local function SmoothMoveTo(targetCFrame, duration)
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp or not hrp.Parent then return end
			local startCFrame = hrp.CFrame
			local elapsed = 0
			local hbConn
			local function step(dt)
				if not hrp or not hrp.Parent then if hbConn then hbConn:Disconnect() end; return end
				elapsed = elapsed + dt
				local alpha = math.min(elapsed / duration, 1)
				hrp.CFrame = startCFrame:lerp(targetCFrame, alpha)
				pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero end)
				if alpha >= 1 then if hbConn then hbConn:Disconnect() end end
			end
			hbConn = RunService.Heartbeat:Connect(step)
			while elapsed < duration do task.wait() end
			if hbConn then hbConn:Disconnect() end
		end
		local function ForceRelease()
			local char = LocalPlayer.Character
			if not char then return end
			local hrp = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChildOfClass("Humanoid")
			local interact = char:FindFirstChild("CheckInterractable")
			local re = getRepairEvent()
			if re then
				for _ = 1, 2 do
					for _, gen in pairs(GetAllGenerators()) do

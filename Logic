		local S = newScope()
		NCS_SCOPE = S
		local ID_SLASH_ABYSS = "80411309607666"
		local State = { Enabled = true, CorruptHandlerFunc = nil, SlashFunc = nil, CancelFunc = nil }

		S:addThread(task.spawn(function()
			local leapFunction, m2Function
			for _, v in pairs(getgc(true)) do
				if type(v) == "function" and islclosure(v) then
					local info = debug.getinfo(v)
					if info.name == "tryActivate" then leapFunction = v end
					if info.name == "playM2Animation" then m2Function = v end
					if leapFunction and m2Function then break end
				end
			end
			if not leapFunction and not m2Function then
				warn("[No Cooldown] Function tryActivate/playM2Animation tidak ditemukan.")
				return
			end
			while State.Enabled and S.alive do
				for _, fn in pairs({leapFunction, m2Function}) do
					if fn then
						for i, val in pairs(debug.getupvalues(fn)) do
							if type(val) == "boolean" and val == true then debug.setupvalue(fn, i, false) end
						end
					end
				end
				task.wait(0.1)
			end
		end))

		for _, v in pairs(getgc(true)) do
			if type(v) == "function" and islclosure(v) then
				local constants = debug.getconstants(v)
				if table.find(constants, "corrupt") and table.find(constants, "Immobile") then
					State.CorruptHandlerFunc = v
					break
				end
			end
		end
		if State.CorruptHandlerFunc then
			S:addConn(RunService.Heartbeat:Connect(function()
				if not State.Enabled or not S.alive then return end
				local upvalues = debug.getupvalues(State.CorruptHandlerFunc)
				for idx, val in pairs(upvalues) do
					if type(val) == "boolean" and val == false then debug.setupvalue(State.CorruptHandlerFunc, idx, true) end
				end
			end))
		else
			warn("[No Cooldown] corruptHandler tidak ditemukan.")
		end

		local function IsSlashPlaying()
			local char = LocalPlayer.Character
			if not char then return false end
			local hum = char:FindFirstChildOfClass("Humanoid")
			local animator = hum and hum:FindFirstChildOfClass("Animator")
			if not animator then return false end
			for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
				if track.IsPlaying and track.Animation and string.find(track.Animation.AnimationId, ID_SLASH_ABYSS) then return true end
			end
			return false
		end
		for _, v in pairs(getgc(true)) do
			if type(v) == "function" and islclosure(v) then
				local info = debug.getinfo(v)
				if info.name == "slashAttackHandler" then State.SlashFunc = v end
				if info.name == "cancelAttackHold" then State.CancelFunc = v end
				if State.SlashFunc then break end
			end
		end
		if State.SlashFunc then
			S:addConn(RunService.Heartbeat:Connect(function()
				if not State.Enabled or not S.alive or not State.SlashFunc then return end
				local isAttacking = IsSlashPlaying()
				if not isAttacking then
					for idx, val in pairs(debug.getupvalues(State.SlashFunc)) do
						if type(val) == "boolean" and val == false then debug.setupvalue(State.SlashFunc, idx, true) end
					end
					if State.CancelFunc then
						for idx, val in pairs(debug.getupvalues(State.CancelFunc)) do
							if type(val) == "boolean" and val == true then debug.setupvalue(State.CancelFunc, idx, false) end
						end
					end
				end
			end))
		else
			warn("[No Cooldown] slashAttackHandler tidak ditemukan.")
		end

		S:addConn(LocalPlayer.CharacterAdded:Connect(function()
			task.wait(0.5)
		end))
		S.extraCleanup = function()
			State.Enabled = false
		end
	else
		if NCS_SCOPE then
			if NCS_SCOPE.extraCleanup then pcall(NCS_SCOPE.extraCleanup) end
			NCS_SCOPE:cleanup()
			NCS_SCOPE = nil
		end
	end
end)

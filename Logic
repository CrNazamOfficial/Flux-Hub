local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local lp = Players.LocalPlayer

local SCENARIOS = {
    { triggerY = 229.1,  target = Vector3.new(132.3, 599.6, -3088.7) },
    { triggerY = 956.1,  target = Vector3.new(-874.9, 1358.6, -5560.9) },
    { triggerY = 1024.1, target = Vector3.new(-6940.3, 1352.3, -7211.2) },
}

local Y_TOLERANCE      = 8.0
local COOLDOWN         = 3.0
local RISE_HEIGHT      = 55
local RISE_TIME        = 0.16
local SHIFT_TIME       = 0.20
local ARC_HEIGHT       = 18
local DIVE_TIME        = 0.22
local RESTORE_DELAY    = 0.40
local TRAIL_LIFETIME   = 0.30

local enabled       = false
local lastTeleport  = 0
local isTeleporting = false

local gui = Instance.new("ScreenGui")
gui.Name = "WoodTPToggle"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = game:GetService("CoreGui")

local btn = Instance.new("TextButton")
btn.Size = UDim2.new(0, 48, 0, 48)
btn.Position = UDim2.new(0, 30, 0, 200)
btn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
btn.BackgroundTransparency = 0.1
btn.BorderSizePixel = 0
btn.Text = "OFF"
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.Font = Enum.Font.GothamBold
btn.TextSize = 13
btn.AutoButtonColor = false
btn.Active = true
btn.Parent = gui

Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)

local stroke = Instance.new("UIStroke", btn)
stroke.Color = Color3.fromRGB(255, 255, 255)
stroke.Thickness = 2
stroke.Transparency = 0.4

local function updateVisual()
    if enabled then
        btn.BackgroundColor3 = Color3.fromRGB(60, 220, 120)
        btn.Text = "ON"
        stroke.Color = Color3.fromRGB(180, 255, 200)
    else
        btn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
        btn.Text = "OFF"
        stroke.Color = Color3.fromRGB(255, 200, 200)
    end
end

local function toggle()
    enabled = not enabled
    updateVisual()
end

btn.MouseButton1Click:Connect(toggle)

local dragging, dragInput, dragStart, startPos

btn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = btn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

btn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        btn.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Q then toggle() end
end)

local function getHRP()
    local char = lp.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    return hrp, hum
end

local function getGroundInfo(hrp)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {lp.Character}
    params.IgnoreWater = false
    return Workspace:Raycast(hrp.Position, Vector3.new(0, -15, 0), params)
end

local function findMatchingScenario(yPos)
    local best, bestDiff = nil, math.huge
    for _, sc in ipairs(SCENARIOS) do
        local diff = math.abs(yPos - sc.triggerY)
        if diff <= Y_TOLERANCE and diff < bestDiff then
            best, bestDiff = sc, diff
        end
    end
    return best
end

local function spawnRiseEffect(position)
    local ring = Instance.new("Part")
    ring.Shape = Enum.PartType.Cylinder
    ring.Material = Enum.Material.SmoothPlastic
    ring.Color = Color3.fromRGB(0, 0, 0)
    ring.Size = Vector3.new(1, 6, 6)
    ring.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
    ring.Anchored = true
    ring.CanCollide = false
    ring.CanQuery = false
    ring.CanTouch = false
    ring.CastShadow = false
    ring.Transparency = 0.45
    ring.Parent = Workspace

    TweenService:Create(ring,
        TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = Vector3.new(1, 18, 18), Transparency = 1 }
    ):Play()

    task.delay(0.45, function()
        if ring then ring:Destroy() end
    end)
end

local function attachTrail(hrp)
    local a0 = Instance.new("Attachment", hrp)
    local a1 = Instance.new("Attachment", hrp)
    a1.Position = Vector3.new(0, 2, 0)

    local trail = Instance.new("Trail", hrp)
    trail.Attachment0 = a0
    trail.Attachment1 = a1
    trail.Lifetime = TRAIL_LIFETIME
    trail.MinLength = 0
    trail.Color = ColorSequence.new(Color3.fromRGB(0, 0, 0))
    trail.Transparency = NumberSequence.new(0.25, 1)
    trail.LightEmission = 0
    trail.Parent = hrp

    return trail, a0, a1
end

local function bezierPoint(p0, p1, p2, p3, t)
    local u = 1 - t
    return p0 * (u^3)
        + p1 * (3 * u^2 * t)
        + p2 * (3 * u * t^2)
        + p3 * (t^3)
end

local function tweenBezier(hrp, p0, p1, p2, p3, duration, easing)
    local startTime = tick()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not hrp or not hrp.Parent then
            conn:Disconnect()
            return
        end
        local elapsed = tick() - startTime
        local t = math.clamp(elapsed / duration, 0, 1)
        local eased = easing(t)
        local pos = bezierPoint(p0, p1, p2, p3, eased)
        hrp.CFrame = CFrame.new(pos)
        if t >= 1 then
            conn:Disconnect()
        end
    end)
    task.wait(duration + 0.01)
end

local easingQuartOut = function(t)
    return 1 - (1 - t)^4
end

local function doTeleport(hrp, humanoid, targetPos)
    if isTeleporting then return end
    isTeleporting = true

    local startPos = hrp.Position

    humanoid.AutoRotate = false
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.JumpHeight = 0

    hrp.Anchored = true

    spawnRiseEffect(startPos)
    local trail, a0, a1 = attachTrail(hrp)

    local skyStart = Vector3.new(startPos.X, startPos.Y + RISE_HEIGHT, startPos.Z)
    local skyDest  = Vector3.new(targetPos.X, targetPos.Y + RISE_HEIGHT + ARC_HEIGHT, targetPos.Z)

    local ctrl1 = startPos + Vector3.new(0, RISE_HEIGHT * 1.4, 0)
    local ctrl2 = Vector3.new(
        (startPos.X + targetPos.X) * 0.5,
        math.max(startPos.Y, targetPos.Y) + RISE_HEIGHT * 1.6,
        (startPos.Z + targetPos.Z) * 0.5
    )

    tweenBezier(hrp, startPos, ctrl1, ctrl2, skyDest, RISE_TIME + SHIFT_TIME, easingQuartOut)

    local ctrlDive1 = skyDest + Vector3.new(0, -ARC_HEIGHT * 0.3, 0)
    local ctrlDive2 = Vector3.new(
        (skyDest.X + targetPos.X) * 0.5,
        (skyDest.Y + targetPos.Y) * 0.5 + ARC_HEIGHT,
        (skyDest.Z + targetPos.Z) * 0.5
    )
    local dropEnd = Vector3.new(targetPos.X, targetPos.Y, targetPos.Z)

    tweenBezier(hrp, skyDest, ctrlDive1, ctrlDive2, dropEnd, DIVE_TIME, easingQuartOut)

    hrp.CFrame = CFrame.new(targetPos)
    spawnRiseEffect(targetPos)

    if trail then trail.Enabled = false end
    task.delay(TRAIL_LIFETIME + 0.1, function()
        if trail then trail:Destroy() end
        if a0 then a0:Destroy() end
        if a1 then a1:Destroy() end
    end)

    task.delay(RESTORE_DELAY, function()
        humanoid.WalkSpeed = 16
        humanoid.JumpPower = 50
        humanoid.JumpHeight = 7.2
        humanoid.AutoRotate = true
        isTeleporting = false
    end)
end

RunService.Heartbeat:Connect(function()
    if not enabled or isTeleporting then return end
    if tick() - lastTeleport < COOLDOWN then return end

    local hrp, hum = getHRP()
    if not hrp then return end

    local result = getGroundInfo(hrp)
    if not result then return end

    local mat = result.Material
    if mat ~= Enum.Material.Wood and mat ~= Enum.Material.WoodPlanks then return end

    local sc = findMatchingScenario(hrp.Position.Y)
    if not sc then return end

    lastTeleport = tick()
    doTeleport(hrp, hum, sc.target)
end)

lp.CharacterAdded:Connect(function(char)
    char:WaitForChild("HumanoidRootPart", 10)
    isTeleporting = false
    lastTeleport = 0
    task.wait(1)
end)

updateVisual()

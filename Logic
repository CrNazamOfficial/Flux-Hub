        end
        local function installHook()
            if not getnamecallmethod then return end
            local setNm = setnamecallmethod
            local function isExploitCaller()
                if checkcaller then return checkcaller() end
                return false
            end
            local function handler(self, ...)
                local method = getnamecallmethod()
                if method == "FireServer" and not shuttingDown then
                    if self == spearRemote and not isExploitCaller() then
                        local args = table.pack(...)
                        aim.thrownRoot = nil; aim.thrownName = nil

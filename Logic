        if LocalPlayer.Character then onCharacterAdded(LocalPlayer.Character) end
        local playerAddedConn = Players.PlayerAdded:Connect(function(plr)
            if plr.Character then protectGui(plr.Character) end
            plr.CharacterAdded:Connect(onCharacterAdded)
        end)

        local oldGetThumb = Players.GetUserThumbnailAsync
        Players.GetUserThumbnailAsync = newcclosure(function(self, userId, ...)
            return IMAGES[1], true
        end)

        HP.cleanupFn = function()
            pcall(function() loopConn:Disconnect() end)
            pcall(function() charConn:Disconnect() end)
            pcall(function() playerAddedConn:Disconnect() end)
            Players.GetUserThumbnailAsync = oldGetThumb
        end

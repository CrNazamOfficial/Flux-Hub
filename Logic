-- SELF HEAL
-- ============================================================
local SH_SCOPE = nil

Hub:Bind("Self Heal", function(state, extras)
	if state then
		if SH_SCOPE then return end
		local S = newScope()
		SH_SCOPE = S
		local HEAL_ANIM_ID = "95836365038528"
		local BUSY_ATTRS = { "isVaulting", "isRepairing", "isUnhooking", "isHealing", "isSliding" }
		local isOn = true
		local loopId = 0
		local animConn = nil

		local function isKiller()
			local team = LocalPlayer.Team
			return team ~= nil and team.Name == "Killer"
		end
		local function blockHealAnimation()
			local char = LocalPlayer.Character
			if not char then return end
			local hum = char:FindFirstChildOfClass("Humanoid")
			local animator = hum and hum:FindFirstChildOfClass("Animator")
			if not animator then return end
			for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
				local anim = track.Animation
				if anim and string.find(anim.AnimationId, HEAL_ANIM_ID, 1, true) then
					pcall(function() track:Stop(0) end)
				end
			end
		end
		local function healStep()
			if isKiller() then return end
			local char = LocalPlayer.Character
			if not char then return end
			local root = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChildOfClass("Humanoid")
			if not root or not hum then return end
			if hum.Health <= 0 or hum.Health >= hum.MaxHealth then return end
			local st = char:FindFirstChild("CheckInterractable")
			if st then
				for _, attr in ipairs(BUSY_ATTRS) do
					if st:GetAttribute(attr) then return end
				end
			end
			pcall(function()
				local remotes = ReplicatedStorage:FindFirstChild("Remotes")
				local healing = remotes and remotes:FindFirstChild("Healing")
				local event = healing and healing:FindFirstChild("HealEvent")
				if event then event:FireServer(root, true) end
			end)
		end

		animConn = RunService.Heartbeat:Connect(function() if S.alive then pcall(blockHealAnimation) end end)
		S:addConn(animConn)
		local myId = loopId + 1
		loopId = myId
		S:addThread(task.spawn(function()
			while isOn and S.alive and myId == loopId do
				pcall(healStep)
				task.wait(3)
			end
		end))
		S.extraCleanup = function()
			isOn = false
			loopId = loopId + 1
			if animConn then pcall(function() animConn:Disconnect() end); animConn = nil end
		end
	else
		if SH_SCOPE then
			if SH_SCOPE.extraCleanup then pcall(SH_SCOPE.extraCleanup) end
			SH_SCOPE:cleanup()
			SH_SCOPE = nil
		end
	end
end)


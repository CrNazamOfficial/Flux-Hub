            if not job then return end
            if not job.part then
                if now - job.t0 > 1.5 then
                    aim.job = nil
                    if job.root then aim.steerText = "Homing: proyektil tidak ditemukan" end
                    return
                end
                local p = pickPart(job, now)
                if not p then return end
                job.part = p; job.firstT = now
                usedParts[p] = true
                table.insert(job.samples, { t = 0, pos = p.Position })
                return
            end
            local p = job.part
            if not p.Parent then
                aim.job = nil; finishJob(job, now); return
            end
            local pos = p.Position
            local last = job.samples[#job.samples]
            if (pos - last.pos).Magnitude > 0.001 then
                table.insert(job.samples, { t = now - job.firstT, pos = pos })
            end
            if now - job.firstT >= CONFIG.STEER_DELAY then
                aim.job = nil; finishJob(job, now)
            end
        end
        local function stopSteer(text) aim.steer = nil; aim.steerText = text end
        local function stepSteer(now, dt)
            local st = aim.steer
            if not st then return end
            local p, root = st.part, st.root
            if not (p and p.Parent and root and root.Parent) then
                stopSteer("Homing: selesai"); return
            end
            if now - st.t0 > CONFIG.STEER_MAX_TIME then stopSteer("Homing: waktu habis"); return end
            if not state.silent then stopSteer("Homing: dimatikan"); return end
            local pos = p.Position
            local dist = (root.Position - pos).Magnitude
            if dist <= CONFIG.STEER_STOP_DIST then stopSteer("Homing: dekat target"); return end
            local hv = Vector3.new()
            local stable = 1
            local tr = tracker[root]
            if CONFIG.PREDICT_MOVEMENT and tr then
                hv = Vector3.new(tr.vel.X, 0, tr.vel.Z)
                stable = tr.stable or 1
                if tr.pred then hv = tr.pred:Lerp(hv, stable) end
                if hv.Magnitude < 1.0 and stable > 0.6 then
                    local ok, av = pcall(function() return root.AssemblyLinearVelocity end)
                    if ok and typeof(av) == "Vector3" then
                        local avH = Vector3.new(av.X, 0, av.Z)
                        hv = avH:Lerp(hv, 0.3)
                    end
                end
                if hv.Magnitude > CONFIG.MAX_PREDICT_SPEED then
                    hv = hv.Unit * CONFIG.MAX_PREDICT_SPEED
                end
            end
            local anchored = p.Anchored
            local cur = nil
            local sp = st.speed
            if not anchored then
                cur = p.AssemblyLinearVelocity
                sp = cur.Magnitude
                if sp < st.minSpeed then
                    st.slow = st.slow + dt
                    if st.slow > 0.25 then stopSteer("Homing: berhenti (jatuh)") end
                    return
                end
                st.slow = 0
            end
            local lead = (ping * CONFIG.LEAD_PING_MULT + CONFIG.EXTRA_LEAD)
                * (CONFIG.ZIGZAG_LEAD_MIN + (1 - CONFIG.ZIGZAG_LEAD_MIN) * stable)
            local aimPos = root.Position + Vector3.new(0, CONFIG.AIM_OFFSET_Y, 0)
                + hv * (dist / math.max(sp, 1) + lead)
            local want = aimPos - pos
            if want.Magnitude < 0.001 then return end
            want = want.Unit
            local newDir = want
            if cur then
                local curDir = cur.Unit
                local ang = math.acos(math.clamp(curDir:Dot(want), -1, 1))
                local maxTurn = CONFIG.STEER_TURN_RATE * dt
                if dist > CONFIG.STEER_NEAR_DIST and ang > maxTurn and ang > 0 then
                    local mix = curDir:Lerp(want, maxTurn / ang)
                    if mix.Magnitude > 0.001 then newDir = mix.Unit end
                end
            end
            if anchored then
                local step = math.min(sp * dt, dist)
                local np = pos + newDir * step
                p.CFrame = CFrame.new(np, np + newDir)
            else
                p.AssemblyLinearVelocity = newDir * sp
            end
        end
        local function refreshTargets(now)
            local list = aim.list
            for i = #list, 1, -1 do list[i] = nil end
            local cam = workspace.CurrentCamera
            if not cam then aim.target = nil; return end
            local camCF = cam.CFrame
            local camPos = camCF.Position
            local look = camCF.LookVector
            local best, bestAngle = nil, math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local char = p.Character
                    if char then
                        local root = char:FindFirstChild("HumanoidRootPart")
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if root and hum and hum.Health > 0 and not isKillerChar(char, now) then
                            if not p:GetAttribute("IsDead") and not char:GetAttribute("IsCarried")
                                and not char:GetAttribute("IsHooked") then
                                local v = root.Position - camPos
                                local dist = v.Magnitude
                                if dist > 0.5 and dist <= CONFIG.MAX_TARGET_DISTANCE then
                                    local dot = look:Dot(v / dist)
                                    local angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
                                    local vel = trackVelocity(root, now)
                                    local tr = tracker[root]
                                    local stable = (tr and tr.stable) or 1
                                    local hv = Vector3.new(vel.X, 0, vel.Z)
                                    if tr and tr.pred then hv = tr.pred:Lerp(hv, stable) end
                                    if hv.Magnitude < 1.0 and stable > 0.6 then
                                        local av = root.AssemblyLinearVelocity
                                        local avH = Vector3.new(av.X, 0, av.Z)
                                        hv = avH:Lerp(hv, 0.3)
                                    end
                                    if not CONFIG.PREDICT_MOVEMENT then hv = Vector3.new()
                                    elseif hv.Magnitude > CONFIG.MAX_PREDICT_SPEED then
                                        hv = hv.Unit * CONFIG.MAX_PREDICT_SPEED
                                    end
                                    local entry = {
                                        root = root, name = p.Name, dist = dist,
                                        angle = angle, hv = hv, stable = stable,
                                    }
                                    table.insert(list, entry)
                                    if angle <= state.fov and angle < bestAngle then
                                        bestAngle = angle; best = entry
                                    end
                                end
                            end
                        end
                    end
                end
            end
            local prevRoot = aim.prevRoot
            if best and prevRoot and best.root ~= prevRoot then
                for i = 1, #list do
                    local e = list[i]
                    if e.root == prevRoot and e.angle <= state.fov
                        and (e.angle - bestAngle) < CONFIG.TARGET_HYSTERESIS then
                        best = e; break
                    end
                end
            end
            if best then
                aim.target = best
                aim.prevRoot = best.root
                aim.updatedAt = now
            else aim.target = nil end
        end

        findRemotes()
        installHook()

        local heartConn = RunService.Heartbeat:Connect(function(dt)
            local now = os.clock()
            if now % 1 < 0.05 then refreshPing() end
            if not (spearRemote and spearRemote.Parent) or not (vfxRemote and vfxRemote.Parent) then
                findRemotes()
            end
            if aim.holding then aim.armedUntil = now + 2 end
            if state.silent then refreshTargets(now)
            else aim.target = nil; for i = #aim.list, 1, -1 do aim.list[i] = nil end end
            pcall(stepJob, now)
            pcall(stepSteer, now, dt)
        end)

        local addedConn = workspace.DescendantAdded:Connect(function(inst)
            local now = os.clock()
            if now > aim.armedUntil then return end
            if inst:IsA("BasePart") then
                table.insert(recent, { part = inst, t = now })
                if #recent > 200 then table.remove(recent, 1) end
            end
        end)

        SAV.cleanupFn = function()
            shuttingDown = true
            pcall(function() heartConn:Disconnect() end)
            pcall(function() addedConn:Disconnect() end)
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            conns = {}
            aim.target = nil; aim.job = nil; aim.steer = nil
        end
        SAV.setFov = function(v) if SAV.state then SAV.state.fov = v end end
    end

    local function SAV_Stop()
        if not SAV.enabled then return end
        SAV.enabled = false
        if SAV.cleanupFn then pcall(SAV.cleanupFn); SAV.cleanupFn = nil end
        SAV.state = nil
    end


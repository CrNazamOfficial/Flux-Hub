				local re = getRepairEvent()
				if re then pcall(function() re:FireServer(p2, false) end) end
			end
		end
		local function StartAutoRepairLoop(genModel)
			AutoCurrentGenModel = genModel
			if AutoRepairThread then pcall(function() task.cancel(AutoRepairThread) end); AutoRepairThread = nil end
			StopAutoRepair()
			AutoRepairThread = task.spawn(function()
				while Alive and S.alive and AutoRepairEnabled and BypassGenEnabled do
					local char = LocalPlayer.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					if not hrp then task.wait(0.1); continue end
					local foundPoint = nil
					for _, gen in pairs(GetAllGenerators()) do
						for _, point in pairs(GetGeneratorPoints(gen)) do
							if point and point.Parent and (hrp.Position - point.Position).Magnitude <= CONFIG.AUTO_SEARCH_RADIUS then foundPoint = point; break end
						end
						if foundPoint then break end
					end
					if foundPoint then
						AutoCurrentPoint = foundPoint
						if tick() - LastFireTime >= CONFIG.AUTO_FIRE_INTERVAL then
							local re = getRepairEvent()
							if re then PlayRepairAnim(); LastFireTime = tick(); pcall(function() re:FireServer(foundPoint, true) end) end
						end
					else
						if AutoCurrentPoint then
							StopAutoRepair()
							AutoRepairEnabled = false
							if AutoCurrentGenModel then ProcessedGens[AutoCurrentGenModel] = nil; AutoCurrentGenModel = nil end
							break
						end
					end
					task.wait(0.1)
				end

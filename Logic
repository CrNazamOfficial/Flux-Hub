                names[plr.Name] = true
                names[plr.DisplayName] = true
            end
            return names
        end
        local function processObject(v, names)
            if v:IsA("TextLabel") or v:IsA("TextButton") then
                local txt = v.Text
                if txt and txt ~= "" and txt ~= REPLACE_NAME then
                    if names[txt] then v.Text = REPLACE_NAME
                    else
                        for name in pairs(names) do
                            if name ~= "" and string.find(txt, name, 1, true) then
                                txt = string.gsub(txt, escape(name), REPLACE_NAME)
                                v.Text = txt
                            end
                        end
                    end
                end
            elseif v:IsA("ImageLabel") or v:IsA("ImageButton") then
                local img = v.Image or ""
                if img ~= "" and not isOurImage(img) and looksLikeAvatar(img) then
                    applyImage(v)
                end
            end
        end
        local function walk(inst, names)
            if genv.FLUX_IGNORE[inst] then return end
            if string.sub(inst.Name, 1, 5) == "FLUX_" then return end
            processObject(inst, names)
            for _, child in ipairs(inst:GetChildren()) do walk(child, names) end
        end
        local function processGui(root)

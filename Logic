    Title("Window ESP")
    -- ===== FITUR: Window ESP =====
    -- Logic asli dari WINDOW ESP [ UDAH TESTING ].txt
    local WESP = { enabled = false, showHL = true, cleanupFn = nil, tracked = {} }

    local function WESP_Start()
        if WESP.enabled then return end
        WESP.enabled = true

        local C_WINDOW = Color3.fromRGB(255, 255, 255)
        local WindowObjects = {}
        local ScannedObjects = {}
        local Connections = {}
        local ScanConn = nil

        local function GetMap() return workspace:FindFirstChild("Map") end
        local function RemoveWindowESP(winModel)
            local data = WindowObjects[winModel]
            if not data then return end
            if data.box then pcall(function() data.box:Destroy() end) end
            if data.hl then pcall(function() data.hl:Destroy() end) end
            if data.bottomPart and data.bottomPart.Parent then
                pcall(function()
                    local orig = data.bottomPart:GetAttribute("ESP_OrigTrans")
                    if orig ~= nil then
                        data.bottomPart.Transparency = orig
                        data.bottomPart:SetAttribute("ESP_OrigTrans", nil)
                    end
                end)
            end
            WindowObjects[winModel] = nil
            ScannedObjects[winModel] = nil
        end
        local function HandleWindowObject(child)
            if not WESP.enabled then return end
            if child.Name ~= "VaultTrigger" then return end
            local winModel = child.Parent
            if not winModel then return end
            if not winModel:IsA("Model") then return end
            if ScannedObjects[winModel] or WindowObjects[winModel] then return end
            ScannedObjects[winModel] = true
            local bottomPart = winModel:FindFirstChild("Bottom")
            if not bottomPart or not bottomPart:IsA("BasePart") then
                local bestSize = 0
                for _, p in ipairs(winModel:GetChildren()) do
                    if p:IsA("BasePart") and p.Name ~= "VaultTrigger"
                        and p.Name ~= "inviswall" and p.Size.Magnitude > bestSize then
                        bestSize = p.Size.Magnitude; bottomPart = p
                    end
                end
            end
            if not bottomPart then return end
            if bottomPart:GetAttribute("ESP_OrigTrans") == nil then
                bottomPart:SetAttribute("ESP_OrigTrans", bottomPart.Transparency)
            end
            if bottomPart.Transparency > 0.5 then bottomPart.Transparency = 0.5 end
            local box = Instance.new("BoxHandleAdornment")
            box.Name = "WindowBox"
            box.Adornee = bottomPart
            box.Size = bottomPart.Size
            box.Color3 = C_WINDOW
            box.Transparency = 0.3
            box.AlwaysOnTop = true
            box.ZIndex = 5
            box.Parent = bottomPart
            local hl = Instance.new("Highlight")
            hl.Adornee = winModel
            hl.FillColor = C_WINDOW
            hl.FillTransparency = 0.9
            hl.OutlineColor = C_WINDOW
            hl.OutlineTransparency = 0.1
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Enabled = WESP.showHL
            hl.Parent = winModel
            WindowObjects[winModel] = { box = box, bottomPart = bottomPart, hl = hl }
        end
        local function ScanMap()
            if not WESP.enabled then return end
            local map = GetMap()
            if not map then return end
            for _, desc in ipairs(map:GetDescendants()) do
                if desc.Name == "VaultTrigger" then HandleWindowObject(desc) end
            end
        end
        local function StartWatcher()
            if ScanConn then ScanConn:Disconnect() end
            local map = GetMap()
            if not map then
                local mapWatch
                mapWatch = workspace.ChildAdded:Connect(function(child)
                    if child.Name == "Map" then
                        if mapWatch then mapWatch:Disconnect() end
                        task.wait(0.2)
                        if WESP.enabled then ScanMap(); StartWatcher() end
                    end
                end)
                table.insert(Connections, mapWatch)
                return
            end
            ScanConn = map.DescendantAdded:Connect(function(desc)
                if not WESP.enabled then return end
                if desc.Name == "VaultTrigger" then
                    task.wait(0.05)
                    HandleWindowObject(desc)
                end
            end)
            table.insert(Connections, ScanConn)
        end

        ScanMap()
        StartWatcher()

        WESP.cleanupFn = function()
            for winModel in pairs(WindowObjects) do RemoveWindowESP(winModel) end
            WindowObjects = {}
            ScannedObjects = {}
            if ScanConn then ScanConn:Disconnect(); ScanConn = nil end
            for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
            Connections = {}
        end
        WESP._setHL = function(on)
            for _, data in pairs(WindowObjects) do
                if data.hl then data.hl.Enabled = on end
            end
        end
    end

    local function WESP_Stop()
        if not WESP.enabled then return end
        WESP.enabled = false
        if WESP.cleanupFn then pcall(WESP.cleanupFn); WESP.cleanupFn = nil end
    end

    AddFeature("Window Esp", {
        type = "toggle",
        default = false,
        callback = function(state) if state then WESP_Start() else WESP_Stop() end end,
        color = {
            default = Color3.fromRGB(255, 255, 255),
            callback = function(c) end,
        },
        extra = {
            { type = "check", label = "Highlight", default = true,
              callback = function(v)
                  WESP.showHL = v
                  if WESP._setHL then WESP._setHL(v) end
              end },
        },
    })

    Title("Hook ESP")
    -- ===== FITUR: Hook ESP =====
    -- Logic asli dari Hook ESP [ UDAH TESTING ].txt
    local HESP = { enabled = false, cleanupFn = nil, tracked = {} }

    local function HESP_Start()
        if HESP.enabled then return end
        HESP.enabled = true

        local camera = workspace.CurrentCamera
        local map = workspace:FindFirstChild("Map")
        if not map then
            HESP.enabled = false
            return
        end

        local highlights = {}
        local labels = {}
        local trackedRoots = {}
        local conns = {}

        local function getHookRoot(inst)
            local m = inst:IsA("Model") and inst or inst:FindFirstAncestorOfClass("Model")
            while m do
                local lname = m.Name:lower()
                if lname == "hook" then return m end
                local parent = m.Parent
                if parent and parent:IsA("Model") then m = parent
                else m = nil end
            end
            return nil
        end
        local function setupHook(root)
            if trackedRoots[root] then return end
            local attach = nil
            if root.PrimaryPart and root.PrimaryPart:IsA("BasePart") then
                attach = root.PrimaryPart
            else
                local hitbox = root:FindFirstChild("HitBox", true)
                if hitbox and hitbox:IsA("BasePart") then attach = hitbox
                else attach = root:FindFirstChildWhichIsA("BasePart", true) end
            end
            if not attach then return end
            local hl = Instance.new("Highlight")
            hl.Parent = camera
            hl.Adornee = root
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillTransparency = 0.6
            hl.FillColor = Color3.fromRGB(255, 80, 80)
            hl.OutlineColor = Color3.fromRGB(255, 0, 0)
            highlights[root] = hl
            local bill = Instance.new("BillboardGui")
            bill.Parent = camera
            bill.Adornee = attach
            bill.Size = UDim2.new(0, 120, 0, 28)
            bill.StudsOffset = Vector3.new(0, 4, 0)
            bill.AlwaysOnTop = true
            local txt = Instance.new("TextLabel")
            txt.Parent = bill
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.BackgroundTransparency = 1
            txt.TextScaled = false
            txt.TextSize = 14
            txt.Font = Enum.Font.SourceSansSemibold
            txt.TextStrokeTransparency = 0.4
            txt.TextStrokeColor3 = Color3.new(0, 0, 0)
            txt.TextColor3 = Color3.fromRGB(255, 100, 100)
            txt.Text = "Hook"
            labels[root] = txt
            trackedRoots[root] = true
        end
        local function cleanup(root)
            if highlights[root] then highlights[root]:Destroy(); highlights[root] = nil end
            if labels[root] then
                local bill = labels[root].Parent
                if bill then bill:Destroy() end
                labels[root] = nil
            end
            trackedRoots[root] = nil
        end

        local descRemConn = map.DescendantRemoving:Connect(function(child)
            local root = getHookRoot(child)
            if root and trackedRoots[root] then cleanup(root) end
        end)
        table.insert(conns, descRemConn)

        for _, inst in ipairs(map:GetDescendants()) do
            local root = getHookRoot(inst)
            if root then setupHook(root) end
        end
        local descAddedConn = map.DescendantAdded:Connect(function(inst)
            if not HESP.enabled then return end
            local root = getHookRoot(inst)
            if root then setupHook(root) end
        end)
        table.insert(conns, descAddedConn)

        HESP.cleanupFn = function()
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            conns = {}
            for root in pairs(trackedRoots) do cleanup(root) end
            trackedRoots = {}
        end
    end

    local function HESP_Stop()
        if not HESP.enabled then return end
        HESP.enabled = false
        if HESP.cleanupFn then pcall(HESP.cleanupFn); HESP.cleanupFn = nil end
    end

    AddFeature("Hook Esp", {
        type = "toggle",
        default = false,
        callback = function(state) if state then HESP_Start() else HESP_Stop() end end,
        color = {
            default = Color3.fromRGB(255, 80, 80),
            callback = function(c) end,
        },
    })

end)


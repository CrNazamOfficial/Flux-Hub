	local function SilentDirection()
		if not AUTO_AIM_ENABLED then
			return nil
		end

		local root = myRootRef
		if not root or root.Parent == nil then
			local char = GetCharacter()
			root = char and char:FindFirstChild("HumanoidRootPart")
		end

		local body = GetTarget()
		if not body or body.Parent == nil then
			body = targetBody
		end

		if not body or not root then
			return nil
		end

		if body.Parent == nil or root.Parent == nil then
			return nil
		end

		pcall(UpdateVelocity, body)

		local fromPos = GetMuzzlePos(root)

		local okPoint, point = pcall(GetAimPoint, fromPos, body)
		if not okPoint or typeof(point) ~= "Vector3" then
			point = body.Position
		end

		local predicted = PredictPoint(fromPos, point, body)

		pcall(MarkShot, body)

		local d = predicted - fromPos
		local m = d.Magnitude

		if m < 0.001 then
			return nil
		end

		return d / m
	end


			if SB.Additional < 0.50 then SB.Additional = 0.50 end
			local st = hum:GetState()
			if st == Enum.HumanoidStateType.Climbing or st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Ragdoll then
				if SB.LastApplied > 0 then hum.WalkSpeed = SB.LastBase; SB.LastApplied = 0 end
				return
			end
			local cur = hum.WalkSpeed
			if not SB.Enabled then
				if SB.LastApplied > 0 then hum.WalkSpeed = SB.LastBase; SB.LastApplied = 0 end
				return
			end
			if cur == SB.LastBase + SB.LastApplied then
				if SB.Additional ~= SB.LastApplied then
					SB.LastApplied = SB.Additional
					if SB.LastBase >= 10.10 then hum.WalkSpeed = SB.LastBase + SB.Additional end

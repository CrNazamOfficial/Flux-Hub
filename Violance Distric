		end
	end
	if #cands == 0 then return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart") end
	local top, topY = nil, -math.huge
	for _, p in ipairs(cands) do if p.Position.Y > topY then topY = p.Position.Y; top = p end end
	return top
end
local function GE_Cleanup(obj)
	local o = GE.Objs[obj]
	if not o then return end
	GE.Objs[obj] = nil
	pcall(function() o.hl:Destroy() end)
	pcall(function() o.tag:Destroy() end)
end
local function GE_Apply(obj)
	if not GE_IsGeneratorModel(obj) then return end
	GE_Cleanup(obj)

	local adornee = GE_Adornee(obj) or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
	if not adornee then return end


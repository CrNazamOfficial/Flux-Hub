		make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, list)
		make("UIPadding", { PaddingRight = UDim.new(0, 4) }, list)
		local optionButtons = {}
		local api = { Listeners = {} }
		local isOpen = false
		local token = 0
		local function refresh()
			for name, ob in pairs(optionButtons) do
				local selected = (name == current)
				ob.Button.BackgroundColor3 = selected and C.TabActive or C.Button
				ob.Button.BackgroundTransparency = selected and 0.2 or 0.6
				ob.Label.TextColor3 = selected and C.Text or C.TextDim
			end
			valueLabel.Text = tostring(current)
		end
		local function close()
			if not isOpen then return end
			isOpen = false
			token = token + 1
			local mine = token
			if self.Close == close then self.Close = nil end
			self.OpenExtra = 0
			self:Relayout(true)
			tw(arrow, 0.18, { Rotation = 0 })
			tw(btnStroke, 0.18, { Transparency = 0.3 })
			task.delay(0.2, function() if mine == token and not isOpen then list.Visible = false end end)
		end
		local function open()
			if isOpen or #options == 0 then return end
			if self.Close and self.Close ~= close then self.Close() end
			self.Close = close
			isOpen = true
			token = token + 1
			list.Visible = true
			self.OpenExtra = 2 + listH + 8
			self:Relayout(true)
			tw(arrow, 0.2, { Rotation = 180 })
			tw(btnStroke, 0.2, { Transparency = 0 })
		end
		for i, name in ipairs(options) do
			local ob = make("TextButton", { Name = "Option_" .. tostring(name), Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = C.Button, BackgroundTransparency = 1, BorderSizePixel = 0, AutoButtonColor = false, Text = "", LayoutOrder = i, ZIndex = 6 }, list)

	if cur then
		local cd = cur.Unit; local ang = math.acos(math.clamp(cd:Dot(want), -1, 1)); local maxTurn = CONFIG.STEER_TURN_RATE * dt
		if dist > CONFIG.STEER_NEAR_DIST and ang > maxTurn and ang > 0 then local mix = cd:Lerp(want, maxTurn / ang); if mix.Magnitude > 0.001 then newDir = mix.Unit end end
	end
	if anchored then local step = math.min(sp * dt, dist); local np = pos + newDir * step; p.CFrame = CFrame.new(np, np + newDir)
	else p.AssemblyLinearVelocity = newDir * sp end
end
local function SAV_RefreshTargets(now)
	for i = #aim.list, 1, -1 do aim.list[i] = nil end
	local cam = workspace.CurrentCamera; if not cam then aim.target = nil; return end
	local cp = cam.CFrame.Position; local look = cam.CFrame.LookVector
	local best, bestAngle = nil, math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= Players.LocalPlayer then
			local char = p.Character
			if char then
				local root = char:FindFirstChild("HumanoidRootPart")
				local hum = char:FindFirstChildOfClass("Humanoid")
				if root and hum and hum.Health > 0 and not SAV_IsKillerChar(char, now) then
					if not p:GetAttribute("IsDead") and not char:GetAttribute("IsCarried") and not char:GetAttribute("IsHooked") then
						local v = root.Position - cp; local dist = v.Magnitude
						if dist > 0.5 and dist <= CONFIG.MAX_TARGET_DISTANCE then
							local dot = look:Dot(v / dist)
							local angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
							local vel = SAV_TrackVelocity(root, now)
							local tr = tracker[root]; local stable = (tr and tr.stable) or 1
							local hv = Vector3.new(vel.X, 0, vel.Z)
							if tr and tr.pred then hv = tr.pred:Lerp(hv, stable) end
							if not CONFIG.PREDICT_MOVEMENT then hv = Vector3.new()
							elseif hv.Magnitude > CONFIG.MAX_PREDICT_SPEED then hv = hv.Unit * CONFIG.MAX_PREDICT_SPEED end
							local entry = { root = root, name = p.Name, dist = dist, angle = angle, hv = hv, stable = stable }
							table.insert(aim.list, entry)
							if angle <= state.fov and angle < bestAngle then bestAngle = angle; best = entry end
						end
					end
				end
			end
		end
	end

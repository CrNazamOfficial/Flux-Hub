        make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, tag)
        make("TextLabel", { Position = UDim2.new(0, 56, 0, 0), Size = UDim2.new(1, -56, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = tostring(entry[2]), TextColor3 = C.Text, Font = Enum.Font.GothamMedium, TextSize = 11, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 6 }, item)
    end

    local frames = 0
    track(RunService.RenderStepped:Connect(function() frames = frames + 1 end))
    local startClock = os.clock()
    task.spawn(function()
        local last = os.clock()
        while gui.Parent do
            task.wait(0.5)
            local now = os.clock()
            local dt = math.max(now - last, 0.001)
            last = now
            local fps = math.floor(frames / dt + 0.5)
            frames = 0
            if p.Visible and root.Visible then
                setStat(statFps, tostring(fps), C.Text)
                local okPing, ping = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
                if okPing and type(ping) == "number" then setStat(statPing, math.floor(ping + 0.5) .. " ms", C.Text)
                else setStat(statPing, "N/A", C.TextDim) end
                local okMem, mem = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
                if okMem and type(mem) == "number" then setStat(statMem, string.format("%d MB", math.floor(mem + 0.5)), C.Text)
                else setStat(statMem, "N/A", C.TextDim) end
                local count = #Players:GetPlayers()
                local maxPlayers = Players.MaxPlayers
                setStat(statPlayers, count .. " / " .. tostring(maxPlayers), C.Text)
                if playersLbl then playersLbl.Text = count .. " / " .. tostring(maxPlayers) end
                if serverAgeLbl then serverAgeLbl.Text = fmtDuration(workspace.DistributedGameTime) end
                if uptimeLbl then uptimeLbl.Text = fmtDuration(now - startClock) end
                if resLbl then local v = (workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize) or Vector2.new(1280, 720); resLbl.Text = string.format("%d x %d", math.floor(v.X), math.floor(v.Y)) end
            end
        end
    end)
end)


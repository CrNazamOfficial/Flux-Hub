	function self:Toggle(default, callback)
		local state = default and true or false
		local btn = make("TextButton", { Name = "Toggle", Size = UDim2.new(0, 36, 0, 20), BackgroundColor3 = C.ButtonHover, BackgroundTransparency = 0.85, BorderSizePixel = 0, AutoButtonColor = false, Text = "", LayoutOrder = nextCtrl(), ZIndex = 6 }, controls)

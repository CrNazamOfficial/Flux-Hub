	local function AB2_chooseTarget()
		local cam = workspace.CurrentCamera
		local myChar = Players.LocalPlayer.Character
		local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local from = myHrp and (myHrp.Position + Vector3.new(0, 1.5, 0)) or (cam and cam.CFrame.Position)
		if not from then return nil end
		local camPos = cam and cam.CFrame.Position
		local look = cam and cam.CFrame.LookVector
		local prev = AB2.Target and AB2.Target.key
		local bestV, bestVs, bestA, bestAs
		for _, c in ipairs(AB2.Cands) do
			local d = (c.hrp.Position - from).Magnitude
			if d <= AB2_CFG.MaxRange then
				local score = d
				if AB2_CFG.TargetMode == "Crosshair" and look and camPos then
					local dir = c.hrp.Position - camPos
					if dir.Magnitude > 0.01 then
						local ang = math.deg(math.acos(math.clamp(AB2_dot(look, dir.Unit), -1, 1)))
						score = ang + d * AB2_CFG.DistWeight
					end
				end
				if prev and c.key == prev then
					score = score - (AB2_CFG.TargetMode == "Crosshair" and AB2_CFG.TargetStick or 3)
				end
				local visible = false
				local ok, res = pcall(function()
					local ignore = { c.key }
					if myChar then ignore[#ignore + 1] = myChar end
					if cam then ignore[#ignore + 1] = cam end
					return workspace:Raycast(from, c.hrp.Position - from, AB2_makeParams(ignore))
				end)
				if ok and res == nil then visible = true end
				if visible then
					if not bestVs or score < bestVs then bestV, bestVs = c, score end
				else
					if not bestAs or score < bestAs then bestA, bestAs = c, score end
				end
			end
		end
		return bestV or bestA
	end

	local function AB2_aimFromSnap(snap, origin)
		local pos = snap.pos
		local hrp = snap.hrp
		if hrp and hrp.Parent then pos = hrp.Position + Vector3.new(0, AB2_CFG.AimHeightOffset, 0) end
		local vel, factor, lead = snap.vel, snap.factor, snap.lead
		local travel = (pos - origin).Magnitude / AB2_CFG.ProjectileSpeed
		local aim = pos
		local prevAim
		for _ = 1, 6 do
			local tt = math.min(travel + lead, AB2_CFG.MaxPredictTime)
			aim = pos + vel * (tt * factor)
			if snap.airborne then
				local y = pos.Y + snap.vy * tt - 0.5 * workspace.Gravity * tt * tt
				if snap.floorY and y < snap.floorY then y = snap.floorY end
				aim = Vector3.new(aim.X, y, aim.Z)
			end
			travel = (aim - origin).Magnitude / AB2_CFG.ProjectileSpeed
			if prevAim and (aim - prevAim).Magnitude < 0.05 then break end
			prevAim = aim
		end
		return aim
	end

	local function AB2_limitDir(orig, want, maxDeg)
		local o = want
		if orig.Magnitude > 0.001 then o = orig.Unit end
		local c = math.clamp(AB2_dot(o, want), -1, 1)
		local ang = math.deg(math.acos(c))
		if ang <= maxDeg then return want end
		local perp = want - o * c
		if perp.Magnitude < 0.0001 then return want end
		perp = perp.Unit
		local r = math.rad(maxDeg)
		return o * math.cos(r) + perp * math.sin(r)
	end

	local function AB2_copyArgs(args)
		local out = {}
		for i = 1, args.n do out[i] = args[i] end

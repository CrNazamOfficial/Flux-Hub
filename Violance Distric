	local WS = { Enabled = false, Tracked = {}, OwnSky = nil, GlobalConns = {}, Heartbeat = nil, Enforcing = false }
	local WS_Lighting = game:GetService("Lighting")
	local WS_FACES = { "SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp" }
	local WS_TEX = { SkyboxBk = "rbxasset://textures/sky/sky512_bk.tex", SkyboxDn = "rbxasset://textures/sky/sky512_dn.tex", SkyboxFt = "rbxasset://textures/sky/sky512_ft.tex", SkyboxLf = "rbxasset://textures/sky/sky512_lf.tex", SkyboxRt = "rbxasset://textures/sky/sky512_rt.tex", SkyboxUp = "rbxasset://textures/sky/sky512_up.tex" }
	local WS_BRIGHT = { Brightness = 2, ClockTime = 14, ExposureCompensation = 0, FogStart = 100000, FogEnd = 100000, Ambient = Color3.fromRGB(170, 170, 170), OutdoorAmbient = Color3.fromRGB(170, 170, 170) }
	local function WS_Enforce(sky)
		if WS.Enforcing then return end
		WS.Enforcing = true
		for _, f in ipairs(WS_FACES) do pcall(function() if sky[f] ~= WS_TEX[f] then sky[f] = WS_TEX[f] end end) end
		pcall(function() if sky.CelestialBodiesShown ~= false then sky.CelestialBodiesShown = false end; if sky.StarCount ~= 0 then sky.StarCount = 0 end end)
		WS.Enforcing = false
	end
	local function WS_EnforceLight()
		for p, v in pairs(WS_BRIGHT) do pcall(function() if WS_Lighting[p] ~= v then WS_Lighting[p] = v end end) end
		pcall(function()
			for _, i in ipairs(WS_Lighting:GetChildren()) do
				if i:IsA("Atmosphere") then if i.Density ~= 0 then i.Density = 0 end; if i.Haze ~= 0 then i.Haze = 0 end; if i.Glare ~= 0 then i.Glare = 0 end end
			end
		end)
	end
	local function WS_Untrack(sky)
		local c = WS.Tracked[sky]
		if c then for _, x in ipairs(c) do pcall(function() x:Disconnect() end) end; WS.Tracked[sky] = nil end
	end
	local function WS_Track(sky)
		if not WS.Enabled or WS.Tracked[sky] then return end
		local c = {}; WS.Tracked[sky] = c; WS_Enforce(sky)
		for _, f in ipairs(WS_FACES) do
			local ok, sig = pcall(function() return sky:GetPropertyChangedSignal(f) end)
			if ok and sig then table.insert(c, sig:Connect(function() WS_Enforce(sky) end)) end
		end
		table.insert(c, sky.AncestryChanged:Connect(function() if not sky:IsDescendantOf(game) then WS_Untrack(sky) end end))
	end
	local function WS_EnsureSky()
		if WS.OwnSky == nil or WS.OwnSky.Parent ~= WS_Lighting then
			if WS.OwnSky then WS_Untrack(WS.OwnSky); WS.OwnSky = nil end
			local ex = WS_Lighting:FindFirstChild("FullBrightSky")
			if ex and ex:IsA("Sky") then WS.OwnSky = ex
			else local s = Instance.new("Sky"); s.Name = "FullBrightSky"; pcall(function() s.Parent = WS_Lighting end); if s.Parent == WS_Lighting then WS.OwnSky = s end end
		end
		if WS.OwnSky then WS_Track(WS.OwnSky) end
	end
	local function WS_Scan(root)
		local ok, list = pcall(function() return root:GetDescendants() end)
		if ok and list then for _, i in ipairs(list) do if i:IsA("Sky") then WS_Track(i) end end end
	end
	local function WS_EnforceAll() for sky in pairs(WS.Tracked) do WS_Enforce(sky) end end
	local WS_Row = Add("World Setting")
	WS_Row:Toggle(false, function(state)
		WS.Enabled = state
		if state then
			WS_EnsureSky(); WS_Scan(WS_Lighting); WS_Scan(workspace); WS_EnforceLight()
			table.insert(WS.GlobalConns, WS_Lighting.DescendantAdded:Connect(function(i) if i:IsA("Sky") then WS_Track(i) end end))
			table.insert(WS.GlobalConns, workspace.DescendantAdded:Connect(function(i) if i:IsA("Sky") then WS_Track(i) end end))
			table.insert(WS.GlobalConns, WS_Lighting.ChildRemoved:Connect(function() WS_EnsureSky() end))
			local elapsed = 0
			WS.Heartbeat = RunService.Heartbeat:Connect(function(dt)
				if not WS.Enabled then return end
				pcall(function() WS_EnsureSky(); WS_EnforceAll(); WS_EnforceLight(); elapsed = elapsed + dt; if elapsed >= 2 then elapsed = 0; WS_Scan(WS_Lighting) end end)
			end)
		else
			if WS.Heartbeat then pcall(function() WS.Heartbeat:Disconnect() end); WS.Heartbeat = nil end
			for _, c in ipairs(WS.GlobalConns) do pcall(function() c:Disconnect() end) end
			WS.GlobalConns = {}
			for sky in pairs(WS.Tracked) do WS_Untrack(sky) end
			if WS.OwnSky then pcall(function() WS.OwnSky:Destroy() end); WS.OwnSky = nil end
		end
	end)
end)


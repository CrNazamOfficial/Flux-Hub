local function SAV_TrackVelocity(root, now)
	local pos = root.Position
	local tr = tracker[root]
	if not tr then tr = { pos = pos, t = now, vel = Vector3.new(), hist = {}, pred = nil, stable = 1 }; tracker[root] = tr end
	local jump = (pos - tr.pos).Magnitude
	if jump > 15 then tr.hist = { { t = now, x = pos.X, z = pos.Z } }; tr.vel = Vector3.new(); tr.pred = nil; tr.stable = 1; tr.pos = pos; tr.t = now; return tr.vel end
	table.insert(tr.hist, { t = now, x = pos.X, z = pos.Z })
	tr.pred, tr.stable = SAV_AnalyzeMotion(tr, now)
	if jump < 0.001 then if now - tr.t > 0.15 then tr.vel = Vector3.new() end; return tr.vel end
	local dt = now - tr.t
	if dt <= 0 or dt > 0.35 then tr.vel = Vector3.new()
	else local raw = (pos - tr.pos) / dt; if raw.Magnitude > 180 then tr.vel = Vector3.new() else tr.vel = tr.vel:Lerp(raw, CONFIG.VELOCITY_SMOOTH) end end
	tr.pos = pos; tr.t = now

	return dist
end
local function AP_DistCheck(kroot)
	if not (AP.MyRoot and AP.MyRoot.Parent and kroot and kroot.Parent) then return false, math.huge end
	local delta = AP.MyRoot.Position - kroot.Position
	local horiz = Vector3.new(delta.X, 0, delta.Z).Magnitude

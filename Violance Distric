    infoRow("Place ID", placeIdStr, C.TextDim, placeIdStr)
    infoRow("Job ID", jobShort, C.TextDim, jobId)
    local playersLbl = infoRow("Players", "-", C.Text)
    infoRow("Server Type", serverType, serverType == "Public" and C.TextDim or C.Text)
    local serverAgeLbl = infoRow("Server Age", "-", C.Text)
    task.spawn(function()
        local okInfo, info = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end)
        if gameLbl and gameLbl.Parent then
            if okInfo and type(info) == "table" and info.Name then gameLbl.Text = tostring(info.Name)
            else gameLbl.Text = "Tidak diketahui" end
        end
    end)

    Title("Device")
    infoRow("Executor", executorName, C.Text)
    infoRow("Platform", platformName, C.Text)
    local resLbl = infoRow("Resolution", "-", C.TextDim)
    local uptimeLbl = infoRow("Uptime", "0s", C.Text)

    Title("Community")
    Add("Discord")
    local dControls = controlsOf("Discord")
    if dControls then
        local btn = make("TextButton", { Name = "DiscordBtn", Size = UDim2.new(0, 128, 0, 24), BackgroundColor3 = C.Accent, BackgroundTransparency = 0.75, BorderSizePixel = 0, AutoButtonColor = false, Text = "Copy Invite", TextColor3 = C.Text, Font = Enum.Font.GothamBold, TextSize = 10, LayoutOrder = 1, ZIndex = 6 }, dControls)
        corner(btn, 6)
        stroke(btn, C.White, 1, 0.4)
        hoverEffect(btn, 0.75, 0.6, 0.4)

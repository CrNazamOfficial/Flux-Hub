	local function CastToChar(origin, direction, char)
		if direction.Magnitude < 0.001 then
			return nil
		end

		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude

		local ignore = {}
		local mine = GetCharacter()
		if mine then
			table.insert(ignore, mine)
		end

		local dirVec = direction.Unit * RAY_RANGE

		for _ = 1, 8 do
			params.FilterDescendantsInstances = ignore
			local res = workspace:Raycast(origin, dirVec, params)
			if not res then
				return nil
			end
			local inst = res.Instance
			if inst:IsDescendantOf(char) then
				return res
			end
			if inst.CanCollide == false or inst.Transparency >= 0.95 then
				table.insert(ignore, inst)
			else
				return nil
			end
		end

		return nil
	end

	local function Visible(origin, point, char)
		return CastToChar(origin, point - origin, char) ~= nil
	end

	local function PartPriority(part)
		return BODY_PRIORITY[part.Name] or DEFAULT_PRIORITY
	end

	local function SamplePoints(part)
		local sx = part.Size.X * SAMPLE_FRACTION
		local sy = part.Size.Y * SAMPLE_FRACTION
		local sz = part.Size.Z * SAMPLE_FRACTION
		local cf = part.CFrame
		return {
			part.Position,
			cf:PointToWorldSpace(Vector3.new(sx, 0, 0)),
			cf:PointToWorldSpace(Vector3.new(-sx, 0, 0)),
			cf:PointToWorldSpace(Vector3.new(0, sy, 0)),
			cf:PointToWorldSpace(Vector3.new(0, -sy, 0)),
			cf:PointToWorldSpace(Vector3.new(0, 0, sz)),
			cf:PointToWorldSpace(Vector3.new(0, 0, -sz)),
		}
	end

	local function GetAimPoint(fromPos, body)
		local char = body.Parent
		local fallback = body.Position

		if not char then
			return fallback
		end

		local cam = workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or nil

		local parts = {}
		for _, part in ipairs(char:GetChildren()) do
			if part:IsA("BasePart") and part.Transparency < 0.95 then
				table.insert(parts, part)
			end
		end
		table.sort(parts, function(a, b)
			return PartPriority(a) < PartPriority(b)
		end)

		local muzzleOnly = nil

		for _, part in ipairs(parts) do
			for _, p in ipairs(SamplePoints(part)) do
				if Visible(fromPos, p, char) then
					if not camPos or Visible(camPos, p, char) then
						return p
					elseif not muzzleOnly then
						muzzleOnly = p
					end
				end
			end
		end

		return muzzleOnly or fallback
	end


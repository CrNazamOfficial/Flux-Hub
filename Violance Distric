		end
	end)
end
local BS_FallbackHooked = false
local BS_FallbackFS = nil
local function BS_InstallHook()
	BS_FindChainRemote()
	if BS_ChainRemote then
		RegisterHookHandler(BS_ChainRemote, BS_HandlerFn)
		EnsureNamecallHook()
		BS.HookOk = true
		return true
	end
	if BS_FallbackHooked then return true end
	if not hookfunction then return false end
	pcall(function()
		local tmp = Instance.new("RemoteEvent")
		local fs = tmp.FireServer
		pcall(function() tmp:Destroy() end)
		local function fsh(self, ...)
			if BS.Enabled and not BS.Bypass and typeof(self) == "Instance" and self.Name == BS_CFG.RemoteName
				and not (checkcaller and checkcaller()) then
				local args = table.pack(...)
				local ok, newArgs = pcall(BS_onFire, self, args)
				if ok and newArgs then
					return BS_FallbackFS(self, table.unpack(newArgs, 1, newArgs.n))
				end
			end
			return BS_FallbackFS(self, ...)
		end
		BS_FallbackFS = hookfunction(fs, newcclosure and newcclosure(fsh) or fsh)
		BS_FallbackHooked = true
		BS.HookOk = true
	end)
	return BS.HookOk
end

	local flight = math.min(dist / math.max(sp, 1), CONFIG.PREDICT_MAX_TIME)
	local aimPos = root.Position + Vector3.new(0, CONFIG.AIM_OFFSET_Y, 0) + hv * (flight + lead)
	local want = aimPos - pos
	if want.Magnitude < 0.001 then return end
	want = want.Unit

-- BuildFeature — bikin UI + dispatch callback ke BindHandlers
-- ============================================================
local function snapshotExtras(store)
	local snap = {}
	for k, api in pairs(store) do
		local ok, v = pcall(api.Get)
		if ok then snap[k] = v end
	end
	return snap
end

local function BuildFeature(Add, name, cfg)
	local row = Add(name)
	local mainApi
	if type(cfg) == "function" then cfg = { callback = cfg } end
	cfg = cfg or {}
	local mainType = cfg.type or "toggle"

	local store = {}
	ExtrasRegistry[name] = store

	local function notify(state)
		if type(cfg.callback) == "function" then safeCall(cfg.callback, state) end
		local bound = BindHandlers[name]
		if type(bound) == "function" then
			local ok, err = pcall(bound, state, snapshotExtras(store))
			if not ok then warn("[FluxHub] bind error '" .. tostring(name) .. "': " .. tostring(err)) end
		end
	end

	local function extraChanged()
		if mainApi and type(mainApi.Get) == "function" then
			local ok, v = pcall(mainApi.Get)
			if ok and v == true then notify(true) end
		end
	end

	if mainType == "toggle" then
		mainApi = row:Toggle(cfg.default or false, notify)
	elseif mainType == "stepper" then
		mainApi = row:Stepper({ Min = cfg.min, Max = cfg.max, Step = cfg.step, Default = cfg.default, Decimals = cfg.decimals }, notify)
	elseif mainType == "dropdown" then
		mainApi = row:Dropdown(cfg.options, cfg.default, notify)
	elseif mainType == "button" then
		mainApi = row:Button(cfg.labels, notify)
	else
		mainApi = row:Toggle(cfg.default or false, notify)
	end

	if cfg.color then
		local cApi = row:Color(cfg.color.default, function(c) extraChanged() end)
		mainApi.Color = cApi
		store.color = cApi
	end

	if cfg.extra then
		mainApi.Extras = {}
		for i, ex in ipairs(cfg.extra) do
			local api
			if ex.type == "check" then
				api = row:Check(ex.label or ("Check" .. i), ex.default or false, function() extraChanged() end)
			elseif ex.type == "dropdown" then
				api = row:Dropdown(ex.options, ex.default, function() extraChanged() end)
			elseif ex.type == "stepper" then
				api = row:Stepper({ Min = ex.min, Max = ex.max, Step = ex.step, Default = ex.default, Decimals = ex.decimals }, function() extraChanged() end)
			end
			if api then
				mainApi.Extras[i] = api
				local key = ex.key or ((ex.type or "extra") .. "_" .. i)
				store[key] = api
				if ex.label then store[ex.label] = api end
			end
		end
	end

	return mainApi
end

local function RunTab(tabName, builder)
	local p = Pages[tabName]
	if not p then warn("[FluxHub] Tab tidak ditemukan: " .. tostring(tabName)); return end
	local function Add(text) return Row(p, text) end
	local function Title(text) return Section(p, text) end
	local function AddFeature(name, cfg) return BuildFeature(Add, name, cfg) end
	local ok, err = pcall(builder, Add, Title, AddFeature)
	if not ok then warn("[FluxHub] Error di tab " .. tostring(tabName) .. ": " .. tostring(err)) end
end

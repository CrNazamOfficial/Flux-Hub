	local function unload()
		if Unloaded then return end
		Unloaded = true
		State.Enabled = false
		for _, conn in ipairs(Connections) do
			pcall(function() conn:Disconnect() end)
		end
		Connections = {}
		if ThrowRemote then
			Reg.Handlers[ThrowRemote] = nil
		end
		if SpearMath and OriginalPower then
			pcall(function() SpearMath.power = OriginalPower end)
		end
		for _, p in ipairs(TrailParts) do
			pcall(function() p:Destroy() end)
		end
		TrailParts = {}
		for _, gui in ipairs(Guis) do
			pcall(function() gui:Destroy() end)
		end
		Guis = {}
		if Env.VDSilent then
			Env.VDSilent = nil
		end
	end


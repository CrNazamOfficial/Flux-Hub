	local bestV, bestVd, bestA, bestAd
	for _, c in ipairs(BS.Cands) do
		local d = (c.hrp.Position - from).Magnitude
		if d <= BS_CFG.MaxRange then
			local visible = false
			local ok, res = pcall(function()
				local ignore = {c.key}
				if myChar then ignore[#ignore + 1] = myChar end
				if cam then ignore[#ignore + 1] = cam end
				return workspace:Raycast(from, c.hrp.Position - from, BS_makeParams(ignore))
			end)
			if ok and res == nil then visible = true end
			if visible then
				if not bestVd or d < bestVd then bestV, bestVd = c, d end

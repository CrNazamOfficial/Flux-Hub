local function PK_ReadPerks(char)
	local result, seen = {}, {}
	if not char then return result end
	for _, c in ipairs(char:GetDescendants()) do
		local n, lv = string.match(tostring(c.Name), "^(.+)%s+(%d+)$")
		if n then
			n = string.gsub(n, "^%s+", "")
			n = string.gsub(n, "%s+$", "")
			if n ~= "" and not seen[n] then
				seen[n] = true
				table.insert(result, { Name = n, Level = lv })
			end
		end
	end
	table.sort(result, function(a, b) return a.Name < b.Name end)
	return result
end

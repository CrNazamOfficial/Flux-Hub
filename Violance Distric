	local function AB2_estimateVelocity(key, hrp, now)
		local av = hrp.AssemblyLinearVelocity
		local asm = Vector3.new(av.X, 0, av.Z)
		if asm.Magnitude < 1.5 then asm = ZERO end
		local h = History[key]
		if not h or #h < 3 then VelState[key] = nil; return AB2_clampVel(asm), 1 end
		if now - h.lastMove > AB2_CFG.StaleTime then VelState[key] = nil; return AB2_clampVel(asm), 1 end
		local n = #h
		local vAll = AB2_fitVel(h, 1, n)
		if not vAll then return AB2_clampVel(asm), 1 end
		local vOld = AB2_fitVel(h, 1, math.ceil(n / 2))
		local vNew = AB2_fitVel(h, math.floor(n / 2) + 1, n)
		if vOld and vNew and vOld.Magnitude > 2 and vNew.Magnitude > 2
			and AB2_dot(vOld.Unit, vNew.Unit) < 0.2 then
			local v = vNew
			if v.Magnitude < 1.5 then v = ZERO end
			VelState[key] = { v = v, t = now }
			return AB2_clampVel(v), AB2_CFG.ReversalFactor
		end
		local raw = vAll * 0.6 + asm * 0.4
		if raw.Magnitude < 1.5 then raw = ZERO end
		local vs = VelState[key]
		local v = raw
		if vs then
			local alpha = 1 - math.exp(-(now - vs.t) / AB2_CFG.VelocitySmoothing)
			v = vs.v:Lerp(raw, math.clamp(alpha, 0, 1))
			if v.Magnitude < 1.5 then v = ZERO end
		end
		VelState[key] = { v = v, t = now }
		return AB2_clampVel(v), 1
	end

	local function AB2_readPingSec()
		local ms = 0
		pcall(function() ms = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)

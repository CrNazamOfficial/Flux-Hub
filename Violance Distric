			optionButtons[name] = { Button = ob, Label = ol }
			track(ob.MouseEnter:Connect(function() if name ~= current then tw(ob, 0.1, { BackgroundTransparency = 0.7 }) end end))
			track(ob.MouseLeave:Connect(function() if name ~= current then tw(ob, 0.1, { BackgroundTransparency = 1 }) end end))
			track(ob.MouseButton1Click:Connect(function() playClick(); current = name; refresh(); close(); safeCall(callback, current) end))
		end
		refresh()
		track(btn.MouseButton1Click:Connect(function() playClick(); if isOpen then close() else open() end end))
		function api.Get() return current end
		function api.Set(name, silent)
			if optionButtons[name] then
				current = name
				refresh()
				if not silent then safeCall(callback, current) end
				for _, fn in ipairs(api.Listeners) do safeCall(fn, current) end
			end
		end
		register(api, "Dropdown")
		return api
	end

	local function layoutChecks(newCell)
		local n = #checkCells
		local rows = math.ceil(n / 2)
		for i, c in ipairs(checkCells) do
			local r = math.ceil(i / 2)
			local y = CHECK_PAD_TOP + (r - 1) * (CHECK_H + CHECK_GAP)
			local pos
			if n == 1 then
				c.Size = UDim2.new(1, -24, 0, CHECK_H)
				pos = UDim2.new(0, 12, 0, y)
			else
				c.Size = UDim2.new(0.5, -16, 0, CHECK_H)
				if n % 2 == 1 and i == n then pos = UDim2.new(0.25, 8, 0, y)
				elseif i % 2 == 1 then pos = UDim2.new(0, 12, 0, y)
				else pos = UDim2.new(0.5, 4, 0, y) end
			end
			if c == newCell then c.Position = pos else tw(c, 0.18, { Position = pos }) end
		end
		self.CheckH = CHECK_PAD_TOP + rows * CHECK_H + (rows - 1) * CHECK_GAP + CHECK_PAD_BOTTOM
		self:Relayout(false)
	end

	function self:Check(text2, default, callback)
		if not checksFrame then
			checksFrame = make("Frame", { Name = "Checks", Position = UDim2.new(0, 0, 0, ROW_H + self.OpenExtra), Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, card)

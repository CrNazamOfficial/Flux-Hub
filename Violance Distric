		local payload = { meta = { name = name, savedAt = os.time() }, state = captureState() }
		return pcall(function() writefile(filePath(name), HttpService:JSONEncode(payload)) end)
	end
	local function readSave(name)
		if not fsReady() then return nil end
		local fp = filePath(name)
		if not isfile(fp) then return nil end
		local ok, raw = pcall(readfile, fp)
		if not ok or type(raw) ~= "string" then return nil end
		local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
		if not ok2 or type(data) ~= "table" then return nil end
		return data
	end
	local function deleteSave(name)
		if not fsReady() then return end
		local fp = filePath(name)
		if isfile(fp) and type(delfile) == "function" then pcall(delfile, fp) end
	end

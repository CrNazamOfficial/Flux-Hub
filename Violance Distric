		make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 5, 0, 9), Size = UDim2.new(0, 5, 0, 2), BackgroundColor3 = C.Window, BorderSizePixel = 0, Rotation = 45, ZIndex = 36 }, tick)

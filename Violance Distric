	if not anchored then
		cur = p.AssemblyLinearVelocity; local mag = cur.Magnitude
		if mag < st.minSpeed then st.slow = st.slow + dt; if st.slow > 0.25 then aim.steer = nil end; return end
		st.slow = 0; sp = math.max(mag, st.speed * 0.9)

local function BG2_Smooth(targetCF, dur)
	local c = Players.LocalPlayer.Character; local hrp = c and c:FindFirstChild("HumanoidRootPart")
	if not hrp or not hrp.Parent then return end
	local startCF = hrp.CFrame; local elapsed = 0; local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if not hrp or not hrp.Parent then if conn then conn:Disconnect() end; return end
		elapsed = elapsed + dt
		local a = math.min(elapsed / dur, 1)
		hrp.CFrame = startCF:Lerp(targetCF, a)
		pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero; hrp.AssemblyAngularVelocity = Vector3.zero end)
		if a >= 1 then if conn then conn:Disconnect() end end
	end)
	while elapsed < dur do task.wait() end
	if conn then conn:Disconnect() end
end

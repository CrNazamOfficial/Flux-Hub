local function BS_estimateVelocity(key, hrp)
	local av = hrp.AssemblyLinearVelocity
	local asm = Vector3.new(av.X, 0, av.Z)
	local h = BS_History[key]
	if not h or #h < 3 then
		if asm.Magnitude < 1.5 then asm = BS_ZERO end
		return BS_clampVel(asm), 1
	end
	local first, last = h[1], h[#h]
	if last.t - first.t < 0.06 then
		if asm.Magnitude < 1.5 then asm = BS_ZERO end
		return BS_clampVel(asm), 1
	end
	local mid = h[math.ceil(#h / 2)]
	local vAll = BS_hv(first, last)
	local v1 = BS_hv(first, mid)
	local v2 = BS_hv(mid, last)
	local v = vAll * 0.6 + asm * 0.4
	local factor = 1
	if v1.Magnitude > 2 and v2.Magnitude > 2 and BS_dot(v1.Unit, v2.Unit) < 0.2 then
		v = v2; factor = BS_CFG.ReversalFactor
	end
	if v.Magnitude < 1.5 then v = BS_ZERO end
	return BS_clampVel(v), factor
end

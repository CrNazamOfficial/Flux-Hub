		local lbl = make("TextLabel", { Position = UDim2.new(0, 32, 0, 0), Size = UDim2.new(1, -40, 1, 0), BackgroundTransparency = 1, Text = name, TextColor3 = C.TextDim, Font = Enum.Font.GothamMedium, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 34 }, item)
		checkApis[name] = {
			render = function(onState)
				local on = (onState ~= nil) and onState or (selected[name] == true)
				tick.Visible = on
				item.BackgroundColor3 = on and C.TabActive or C.Button
				tw(item, 0.15, { BackgroundTransparency = on and 0 or 0.35 })
				box.BackgroundColor3 = on and C.White or C.Button
				tw(box, 0.15, { BackgroundTransparency = on and 0 or 0.3 })
				tw(boxStroke, 0.15, { Transparency = on and 1 or 0.8 })
				lbl.TextColor3 = on and C.Text or C.TextDim
			end,
		}
		track(item.MouseEnter:Connect(function() if not selected[name] then tw(item, 0.12, { BackgroundTransparency = 0.15 }) end end))
		track(item.MouseLeave:Connect(function() if not selected[name] then tw(item, 0.12, { BackgroundTransparency = 0.35 }) end end))
		track(item.MouseButton1Click:Connect(function() playClick(); setSelected(name, not selected[name]) end))
	end

	for _, name in ipairs(FEATURES) do
		local reg = ToggleRegistry[name]
		if reg and reg.Listeners then
			reg.Listeners[#reg.Listeners + 1] = function() updateFloatVisual(name) end
		else
			warn("[FluxHub] Panel: toggle tidak ditemukan: " .. name)
		end
	end
	task.spawn(function()
		while gui.Parent do
			task.wait(0.3)
			for name in pairs(floatBtns) do updateFloatVisual(name) end
		end
	end)

	local function setLocked(v)
		locked = v and true or false
		lockBtn.Text = locked and "Unlock" or "Lock"
		lockBtn.TextColor3 = locked and C.White or C.Text
		if lockTabBtn then lockTabBtn.Set(locked and 2 or 1) end
	end
	local function setWindow(open)
		Win.Visible = open and true or false
		if openTabBtn then openTabBtn.Set(open and 2 or 1) end
	end
	local function doSave()
		local data = { selected = {}, pos = {}, locked = locked, win = { x = Win.Position.X.Offset, y = Win.Position.Y.Offset } }
		for _, name in ipairs(FEATURES) do
			if selected[name] then data.selected[#data.selected + 1] = name end
			local fb = floatBtns[name]
			if fb then data.pos[name] = { x = fb.Button.Position.X.Offset, y = fb.Button.Position.Y.Offset }
			elseif savedPos[name] then data.pos[name] = savedPos[name] end
		end
		local ok = false
		if type(writefile) == "function" then ok = pcall(function() writefile(SAVE_FILE, HttpService:JSONEncode(data)) end) end
		return ok
	end
	local function saveWithFeedback()
		local ok = doSave()
		saveBtn.Text = ok and "Saved" or "No File"
		task.delay(1.2, function() saveBtn.Text = "Save" end)
	end
	local function doLoad()
		local raw = nil
		if type(isfile) == "function" and type(readfile) == "function" then
			pcall(function() if isfile(SAVE_FILE) then raw = readfile(SAVE_FILE) end end)
		end
		if type(raw) ~= "string" then return end
		local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
		if not ok or type(data) ~= "table" then return end
		if type(data.pos) == "table" then
			for name, p2 in pairs(data.pos) do
				if type(p2) == "table" and tonumber(p2.x) and tonumber(p2.y) then savedPos[name] = { x = tonumber(p2.x), y = tonumber(p2.y) } end
			end
		end
		if type(data.win) == "table" and tonumber(data.win.x) and tonumber(data.win.y) then
			local v = getViewport()
			local wx = math.clamp(tonumber(data.win.x), 0, math.max(v.X - winW, 0))
			local wy = math.clamp(tonumber(data.win.y), 0, math.max(v.Y - winH, 0))
			Win.Position = UDim2.new(0, wx, 0, wy)
		end
		if type(data.selected) == "table" then
			for _, name in ipairs(data.selected) do if isFeature[name] then setSelected(name, true) end end
		end
		setLocked(data.locked == true)
	end
	track(saveBtn.MouseButton1Click:Connect(saveWithFeedback))
	track(lockBtn.MouseButton1Click:Connect(function() playClick(); setLocked(not locked) end))
	track(closeBtn2.MouseButton1Click:Connect(function() playClick(); setWindow(false) end))
	local rowOpen = Add("Panel Setting")
	openTabBtn = rowOpen:Button({ "Open", "Close" }, function(label, number) setWindow(number == 1) end)
	local rowSave = Add("Save Panel")
	rowSave:Button({ "Save" }, function() saveWithFeedback() end)
	local rowLock = Add("Lock Position Panel")
	lockTabBtn = rowLock:Button({ "Lock Position", "Unlock Position" }, function(label, number) setLocked(number == 1) end)
	doLoad()
end)

-- ===== MISC (save manager) =====
RunTab("Misc", function(Add, Title, AddFeature)
	local p = Pages["Misc"]
	local SAVE_DIR = "FluxHub_Saves"
	local INDEX_FILE = SAVE_DIR .. "/index.json"
	local function fsReady() return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function" and type(makefolder) == "function" and type(isfolder) == "function" end
	local function ensureFolder() if not fsReady() then return end; if not isfolder(SAVE_DIR) then pcall(makefolder, SAVE_DIR) end end
	local function sanitize(name) return string.gsub(tostring(name), "[^%w_%-]", "_") end
	local function filePath(name) return SAVE_DIR .. "/" .. sanitize(name) .. ".json" end
	local function serializeValue(v) if typeof(v) == "Color3" then return { __t = "Color3", r = v.R, g = v.G, b = v.B } end; return v end
	local function deserializeValue(v) if type(v) == "table" and v.__t == "Color3" then return Color3.new(v.r, v.g, v.b) end; return v end
	local function captureState()
		local data = {}
		for key, api in pairs(FeatureRegistry) do
			if type(api) == "table" and type(api.Get) == "function" then
				local ok, v = pcall(api.Get)
				if ok and v ~= nil then data[key] = serializeValue(v) end
			end
		end
		return data
	end
	local function applyState(data)
		if type(data) ~= "table" then return end
		for key, raw in pairs(data) do
			local api = FeatureRegistry[key]
			if type(api) == "table" and type(api.Set) == "function" and type(api.Get) == "function" then
				local v = deserializeValue(raw)
				local same = false
				pcall(function() same = (api.Get() == v) end)
				if not same then pcall(api.Set, v) end
			end
		end
	end

	local saves = {}
	local selectedName = nil
	local autoLoadName = nil
	local currentName = ""
	local saveBtn, openTabBtn
	local refreshList, refreshSaveState, setWindow

	local function readIndex()
		if not fsReady() then return end
		if not isfile(INDEX_FILE) then return end
		local ok, raw = pcall(readfile, INDEX_FILE)
		if not ok or type(raw) ~= "string" then return end
		local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
		if not ok2 or type(data) ~= "table" then return end
		if type(data.list) == "table" then saves = {}; for _, n in ipairs(data.list) do if type(n) == "string" then saves[#saves + 1] = n end end end
		if type(data.auto) == "string" then autoLoadName = data.auto end
	end
	local function writeIndex()
		if not fsReady() then return false end
		ensureFolder()
		local payload = { list = saves, auto = autoLoadName }
		local ok = pcall(function() writefile(INDEX_FILE, HttpService:JSONEncode(payload)) end)
		return ok
	end
	local function writeSave(name)
		if not fsReady() then return false end
		ensureFolder()
		local payload = { meta = { name = name, savedAt = os.time() }, state = captureState() }
		local ok = pcall(function() writefile(filePath(name), HttpService:JSONEncode(payload)) end)
		return ok
	end
	local function readSave(name)
		if not fsReady() then return nil end
		local fp = filePath(name)
		if not isfile(fp) then return nil end
		local ok, raw = pcall(readfile, fp)
		if not ok or type(raw) ~= "string" then return nil end
		local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
		if not ok2 or type(data) ~= "table" then return nil end
		return data
	end
	local function deleteSave(name)
		if not fsReady() then return end
		local fp = filePath(name)
		if isfile(fp) and type(delfile) == "function" then pcall(delfile, fp) end
	end

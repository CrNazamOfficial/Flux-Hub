	local function AG_MainLoop()
		local conn
		conn = RunService.RenderStepped:Connect(function()
			local now = os.clock()
			if not AG_Check or not AG_Check.Parent then AG_Refresh() end
			local vis = AG_Check ~= nil and AG_Check.Parent ~= nil and AG_Check.Visible == true
			if vis then AG.LastVisible = now
			elseif AG.ScourgeActive and now - AG.LastVisible > AG_SCOURGE_TIMEOUT then AG.ScourgeActive = false; AG.Busy = false end
			if not AG.Enabled then AG.PreviousVisible = false; return end
			local wasVis = AG.PreviousVisible

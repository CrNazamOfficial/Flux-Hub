			local handled = nil
			while AG.Enabled do
				if AG.ScourgeActive and AG.ScourgeMode == "INSTANT" then
					AG_Refresh()
					if AG_Check and AG_Check.Visible and AG_Goal and AG_Line then
						local cg = tonumber(AG_Goal.Rotation) or 0
						if handled == nil or math.abs(cg - handled) > 1 then
							if AG_InstantScourge() then handled = cg end
						end
					else handled = nil end
				else handled = nil end
				task.wait(0.005)
			end
		end)
	end
	local AG_Row = Add("Auto Generator")

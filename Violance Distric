		corner(knob, 99)
		local api = { Listeners = {} }
		local function render(animate)
			local t = animate and 0.16 or 0
			if state then
				btn.BackgroundColor3 = C.Accent
				tw(btn, t, { BackgroundTransparency = 0 })
				tw(st, t, { Transparency = 1 })
				tw(knob, t, { Position = UDim2.new(0, 19, 0.5, 0), BackgroundColor3 = C.Window })
			else
				btn.BackgroundColor3 = C.ButtonHover
				tw(btn, t, { BackgroundTransparency = 0.85 })
				tw(st, t, { Transparency = 0.85 })
				tw(knob, t, { Position = UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = C.TextDim })
			end
		end
		function api.Get() return state end
		function api.Set(v, silent)
			if type(v) ~= "boolean" then return end
			if state == v then
				render(true)
				return
			end
			state = v
			render(true)
			if not silent then safeCall(callback, state) end
			for _, fn in ipairs(api.Listeners) do safeCall(fn, state) end
		end
		render(false)
		track(btn.MouseButton1Click:Connect(function() playClick(); api.Set(not state) end))
		register(api, "Toggle")
		return api
	end

	function self:Stepper(opt, callback)
		opt = opt or {}
		local min, max, step = opt.Min or 0, opt.Max or 100, opt.Step or 1
		local decimals = opt.Decimals or 0
		local mult = 10 ^ decimals
		local value, box
		local function fmt(v) return string.format("%." .. tostring(decimals) .. "f", v) end
		local function fix(v) v = math.clamp(v, min, max); v = math.floor(v * mult + 0.5) / mult; return math.clamp(v, min, max) end
		value = fix(opt.Default or min)
		local holder = make("Frame", { Name = "Stepper", Size = UDim2.new(0, 92, 0, 24), BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = nextCtrl(), ZIndex = 6 }, controls)
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, holder)
		local function stepButton(plus, order)
			local b = make("TextButton", { Name = plus and "Plus" or "Minus", Size = UDim2.new(0, 24, 0, 24), BackgroundColor3 = C.Button, BackgroundTransparency = 0.2, BorderSizePixel = 0, AutoButtonColor = false, Text = "", LayoutOrder = order, ZIndex = 7 }, holder)
			corner(b, 6)
			glyph(b, 0, 10)
			if plus then glyph(b, 90, 10) end
			hoverEffect(b, 0.2, 0.05, 0)
			return b
		end
		local minus = stepButton(false, 1)
		box = make("TextBox", { Name = "Value", Size = UDim2.new(0, 40, 0, 24), BackgroundColor3 = C.SearchBg, BackgroundTransparency = 0.2, BorderSizePixel = 0, Text = fmt(value), TextColor3 = C.Text, Font = Enum.Font.GothamMedium, TextSize = 11, ClearTextOnFocus = false, LayoutOrder = 2, ZIndex = 7 }, holder)
		corner(box, 6)
		stroke(box, C.Border, 1, 0.3)
		local plus = stepButton(true, 3)
		local api = { Listeners = {} }
		function api.Get() return value end
		function api.Set(v, silent)
			value = fix(tonumber(v) or value)
			box.Text = fmt(value)
			if not silent then safeCall(callback, value) end
			for _, fn in ipairs(api.Listeners) do safeCall(fn, value) end
		end
		track(minus.MouseButton1Click:Connect(function() playClick(); api.Set(value - step) end))
		track(plus.MouseButton1Click:Connect(function() playClick(); api.Set(value + step) end))
		track(box.FocusLost:Connect(function()
			local n = tonumber(box.Text)
			if n then api.Set(n) else box.Text = fmt(value) end
		end))
		register(api, "Stepper")
		return api
	end


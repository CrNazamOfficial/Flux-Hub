	local AG = { Enabled = false, Mode = "PERFECT", ScourgeMode = "INSTANT", Busy = false, ScourgeActive = false, ScourgeRound = 0, LastVisible = 0, PreviousVisible = false, Conns = {} }
	local AG_Check, AG_Line, AG_Goal, AG_Action = nil, nil, nil, nil
	local AG_LastTrigger = 0
	local AG_TriggerDelay = 0.035
	local AG_SCOURGE_TIMEOUT = 15
	local AG_INSTANT_ANGLE = 109
	local AG_S_MIN, AG_S_MAX = 102, 116
	local AG_N_MIN, AG_N_MAX = 116, 159
	local function AG_Refresh()
		pcall(function()
			local pg = Players.LocalPlayer:FindFirstChild("PlayerGui")
			local sg = pg and pg:FindFirstChild("SkillCheckPromptGui")
			AG_Check = sg and sg:FindFirstChild("Check")
			if AG_Check then
				AG_Line = AG_Check:FindFirstChild("Line")
				AG_Goal = AG_Check:FindFirstChild("Goal")

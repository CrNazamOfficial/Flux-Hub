local function applyFilter(tabName)
    local td = TabData[tabName]
    if not td then return end
    local q = string.lower(td.FilterText or "")
    local anyVisible = false
    for _, entry in ipairs(td.Sections) do
        local match = (q == "") or string.find(string.lower(entry.Name), q, 1, true) ~= nil
        entry.Frame.Visible = match
        if match then anyVisible = true end
    end
    for _, entry in ipairs(td.Rows) do
        local match = (q == "") or string.find(string.lower(entry.Name), q, 1, true) ~= nil
        entry.Frame.Visible = match
        if match then anyVisible = true end
    end
    local order = 0
    for _, entry in ipairs(td.Sections) do
        if entry.Frame.Visible then order = order + 1; entry.Frame.LayoutOrder = order end
    end
    for _, entry in ipairs(td.Rows) do
        if entry.Frame.Visible then order = order + 1; entry.Frame.LayoutOrder = order end
    end
    local existing = td.Page:FindFirstChild("EmptyState")
    if not anyVisible and q ~= "" then
        if not existing then
            make("TextLabel", {
                Name = "EmptyState",
                Size = UDim2.new(1, 0, 0, 40),
                BackgroundTransparency = 1,
                Text = "Tidak ada fitur yang cocok",
                TextColor3 = C.TextDim,
                Font = Enum.Font.GothamMedium,
                TextSize = 11,
                LayoutOrder = 99999,
                ZIndex = 4,
            }, td.Page)
        end
    elseif existing then
        existing:Destroy()
    end
end


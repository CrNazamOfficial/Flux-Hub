		pcall(function() re:FireServer(targetPoint, false) end)
		BG2_StandUp()
		if hrp.Parent then pcall(function() hrp.Anchored = false end) end
		task.wait(BG2_CFG.STAND_UP_DELAY)
		if BG2_CFG.AUTO_REPAIR_AFTER_BYPASS and BG2.Enabled and not BG2.UserMovedDuringBypass then
			BG2.AutoRepairEnabled = true; BG2_StartAuto(gen)
		end
	end)
	local c = Players.LocalPlayer.Character; local hrp = c and c:FindFirstChild("HumanoidRootPart")
	if hrp and hrp.Parent then pcall(function() hrp.Anchored = false end) end
	BG2.IsBypassRunning = false
end


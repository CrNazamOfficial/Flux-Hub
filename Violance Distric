                    if index == 1 then r = n elseif index == 2 then g = n else b = n end
                    setRGB(r, g, b)
                else refresh() end
            end))
        end
        channelBox(rBox, 1); channelBox(gBox, 2); channelBox(bBox, 3)
        local function close() mode = nil; overlay.Visible = false end
        local function open()
            h, s, v = Color3.toHSV(applied)

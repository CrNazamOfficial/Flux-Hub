end
local function SAV_StepSteer(now, dt)
	local st = aim.steer; if not st then return end
	local p, root = st.part, st.root
	if not (p and p.Parent and root and root.Parent) then aim.steer = nil; return end
	if now - st.t0 > st.maxTime then aim.steer = nil; return end
	if not state.silent then aim.steer = nil; return end
	local pos = p.Position; local dist = (root.Position - pos).Magnitude
	if dist <= CONFIG.STEER_STOP_DIST then aim.steer = nil; return end
	local hv = Vector3.new(); local stable = 1
	local tr = tracker[root]
	if CONFIG.PREDICT_MOVEMENT and tr then
		hv = Vector3.new(tr.vel.X, 0, tr.vel.Z); stable = tr.stable or 1
		if tr.pred then hv = tr.pred:Lerp(hv, stable) end
		if hv.Magnitude < 1.0 and stable > 0.6 then local ok, av = pcall(function() return root.AssemblyLinearVelocity end); if ok and typeof(av) == "Vector3" then hv = Vector3.new(av.X, 0, av.Z):Lerp(hv, 0.3) end end

end
local function SAV_SolveDirection(origin, speed, base, hv, g, lead)
	local t = (base - origin).Magnitude / speed
	local dirOut, aimPos = nil, base
	for _ = 1, 8 do
		aimPos = base + hv * (math.min(t, CONFIG.PREDICT_MAX_TIME) + lead)
		local d = aimPos - origin
		local hd = Vector3.new(d.X, 0, d.Z)
		local x = hd.Magnitude; local y = d.Y
		if x < 0.01 then dirOut = Vector3.new(0, y >= 0 and 1 or -1, 0); t = math.abs(y) / speed
		elseif g <= 0 then dirOut = d.Unit; t = d.Magnitude / speed
		else
			local v2 = speed * speed
			local disc = v2 * v2 - g * (g * x * x + 2 * y * v2)
			if disc >= 0 then
				local theta = math.atan((v2 - math.sqrt(disc)) / (g * x))
				local hdir = hd / x
				dirOut = hdir * math.cos(theta) + Vector3.new(0, math.sin(theta), 0)
				local vx = speed * math.cos(theta)
				if vx > 0.01 then t = x / vx end
			else dirOut = d.Unit; t = d.Magnitude / speed end
		end
	end
	if not dirOut or dirOut.X ~= dirOut.X or dirOut.Y ~= dirOut.Y or dirOut.Z ~= dirOut.Z then return nil end
	return dirOut, aimPos
end
local function SAV_ParseThrow(args)
	local first = args[1]
	if type(first) == "table" then
		local d, o = first.Direction, first.Origin
		if typeof(d) ~= "Vector3" or typeof(o) ~= "Vector3" then return nil end
		local sp = first.Speed
		if type(sp) ~= "number" or sp <= 1 then sp = nil end
		return { tbl = true, dir = d, origin = o, speed = sp }
	elseif typeof(first) == "Vector3" then
		local sp = args[2]
		if type(sp) ~= "number" or sp <= 1 then return nil end
		return { tbl = false, dir = first, origin = args[3], speed = sp }
	end

	local function SB_Monitor(char)
		local hum = char:WaitForChild("Humanoid", 5)
		if not hum then return end
		if SB.Conn then pcall(function() SB.Conn:Disconnect() end); SB.Conn = nil end
		SB.LastBase = hum.WalkSpeed
		SB.LastApplied = 0
		SB.Conn = RunService.Heartbeat:Connect(function()

local MP = { Enabled = false, Gui = nil, Box = nil, Label = nil, Conns = {}, Running = false, LastMap = nil, LastMapExists = false }
local MP_CFG = {
	TextSize = 7,
	StartX = 0.5,
	StartY = 56,
	ALWAYS_SHOW = false,
	UpdateRate = 0.5,
}
local function MP_Esc(s)
	s = tostring(s)
	s = string.gsub(s, "&", "&amp;")
	s = string.gsub(s, "<", "&lt;")
	s = string.gsub(s, ">", "&gt;")
	return s
end
local function MP_IsSpec()
	local t = Players.LocalPlayer.Team
	return t ~= nil and t.Name == "Spectator"
end
local function MP_ReadKiller()
	local pGui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local spec = pGui and pGui:FindFirstChild("Spectator")
	local info = spec and spec:FindFirstChild("Info")
	local lbP = info and info:FindFirstChild("Leaderboard")
	local lb = lbP and lbP:FindFirstChild("Leaderboard")
	if not lb then return nil, false end
	local highest, predicted = -1, nil
	for _, f in ipairs(lb:GetChildren()) do
		if f:IsA("GuiObject") then
			local kcF = f:FindFirstChild("kc")
			local kc = kcF and kcF:FindFirstChild("kc")
			if kc then
				local v = tonumber(kc.Text) or 0
				if v > highest then highest = v; predicted = f.Name end
			end
		end
	end
	local your = info:FindFirstChild("Your")
	local myKC = your and your:FindFirstChild("KillerChance")
	local myVal = myKC and tonumber(myKC.Text) or 0
	if myVal > highest then return Players.LocalPlayer.Name, true end
	return predicted, predicted == Players.LocalPlayer.Name
end
local function MP_DetectMap()
	local map = workspace:FindFirstChild("Map")
	if not map then return nil end
	if map:FindFirstChild("random shakes") or map:FindFirstChild("SCP-173 Room") or map:FindFirstChild("SCP-205 Room") then return "Site 68"
	elseif map:FindFirstChild("HooksMeat") then return "BLOODBATH! Club"
	elseif map:FindFirstChild("Gate") and map.Gate:FindFirstChild("vfx") then return "Firelink Shrine"
	elseif map:FindFirstChild("Bldg_Addon_RooftopUnit_A") or map:FindFirstChild("Rooftop") then return "Mercy Hospital Rooftop"
	elseif map:FindFirstChild("White Armored Car") then return "Mount Massive Asylum"
	elseif map:FindFirstChild("Dumbster") then return "The Bay Harbor"
	elseif map:FindFirstChild("water pump") then return "Valdelobos Village"
	elseif map:FindFirstChild("BrickWall") then return "Ashwood Farm"
	elseif map:FindFirstChild("LargeBoulder01") then return "Woodview Cabin" end
	return nil
end

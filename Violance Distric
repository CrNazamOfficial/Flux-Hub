local function AP_UpdateRing(anyIn)
	if not (AP.Visual and AP.MyRoot and AP.MyRoot.Parent and AP.MyAlive) then
		if AP.RingFolder then AP.RingFolder.Parent = nil end
		return
	end
	local parts = AP_EnsureRing(); if not parts then return end
	if AP.RingFolder.Parent ~= workspace.CurrentCamera then AP.RingFolder.Parent = workspace.CurrentCamera end
	local range = AP.Range
	local step = (2 * math.pi) / 32
	local col = anyIn and AP_C_RING_ACTIVE or AP_C_RING_IDLE
	for i = 1, 32 do
		local seg = parts[i]
		local a0 = (i - 1) * step
		local a1 = a0 + step * 0.7
		local p0x, p0z = math.cos(a0) * range, math.sin(a0) * range
		local p1x, p1z = math.cos(a1) * range, math.sin(a1) * range
		local mx, mz = (p0x + p1x) / 2, (p0z + p1z) / 2
		local dx, dz = p1x - p0x, p1z - p0z
		local len = math.sqrt(dx * dx + dz * dz)
		if len < 0.001 then seg.Transparency = 1 else
			local yaw = math.atan2(dz, dx)
			seg.Size = Vector3.new(len, 0.05, 0.18)
			seg.CFrame = CFrame.new(AP.MyRoot.Position.X + mx, AP.MyRoot.Position.Y - 2, AP.MyRoot.Position.Z + mz) * CFrame.Angles(0, -yaw, 0)
			seg.Transparency = 0.4
		end
		seg.Color = col
	end
end

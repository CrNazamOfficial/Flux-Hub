			local ok2, data = pcall(function() return HttpService:JSONDecode(res) end)
			if not ok2 or type(data) ~= "table" or type(data.data) ~= "table" then notify("Server Hop", "Format server invalid"); return end
			local candidates = {}
			for _, s in ipairs(data.data) do if s.id and s.id ~= myJob and s.playing and s.maxPlayers and s.playing < s.maxPlayers then candidates[#candidates + 1] = s.id end end

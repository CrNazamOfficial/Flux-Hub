			local ctr = sm and sm:FindFirstChild("Controls")
			AG_Action = ctr and ctr:FindFirstChild("action")
		end)
	end
	local function AG_Trigger()
		if not AG_Action or not AG_Action.Parent then AG_Refresh() end
		if not AG_Action then return false end
		local now = os.clock()
		if now - AG_LastTrigger < AG_TriggerDelay then return false end
		AG_LastTrigger = now
		pcall(function() if AG_Action:IsA("GuiButton") then AG_Action:Activate() end end)
		if typeof(firesignal) == "function" then pcall(function() firesignal(AG_Action.MouseButton1Down) end) end
		return true
	end
	local function AG_Angle()
		if not AG_Line or not AG_Goal then return nil end
		return tonumber(AG_Line.Rotation) or 0, tonumber(AG_Goal.Rotation) or 0
	end
	local function AG_IsPerfect()
		local l, g = AG_Angle(); if not l then return false end
		return l >= g + AG_S_MIN and l <= g + AG_S_MAX
	end
	local function AG_IsNormal()
		local l, g = AG_Angle(); if not l then return false end
		return l > g + AG_N_MIN and l <= g + AG_N_MAX
	end
	local function AG_InstantNormal()
		if not AG_Check or not AG_Line or not AG_Goal then AG_Refresh() end
		if not AG_Check or not AG_Line or not AG_Goal then return end
		if not AG_Check.Visible then return end
		local g = tonumber(AG_Goal.Rotation) or 0
		pcall(function() AG_Line.Rotation = g + AG_INSTANT_ANGLE end)
		AG_Trigger()
	end
	local function AG_InstantScourge()
		if not AG.Enabled or not AG.ScourgeActive then return false end
		if not AG_Line or not AG_Goal then AG_Refresh() end
		if not AG_Line or not AG_Goal then return false end
		local g = tonumber(AG_Goal.Rotation) or 0
		pcall(function() AG_Line.Rotation = g + AG_INSTANT_ANGLE end)
		local pressed = AG_Trigger()
		if pressed then AG.ScourgeRound = AG.ScourgeRound + 1 end
		return pressed
	end

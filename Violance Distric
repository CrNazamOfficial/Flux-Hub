		end)
	else
		for _, c in ipairs(AST.Conns) do pcall(function() c:Disconnect() end) end
		AST.Conns = {}
		if AST_RefRow._ASTRefreshThread then pcall(function() task.cancel(AST_RefRow._ASTRefreshThread) end); AST_RefRow._ASTRefreshThread = nil end
	end
end)

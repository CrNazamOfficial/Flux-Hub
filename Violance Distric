	end))
	track(delBtn.MouseButton1Click:Connect(function()
		if not delBtn:GetAttribute("Enabled") then return end
		if not selectedName then return end
		deleteSave(selectedName)
		for i, n in ipairs(saves) do if n == selectedName then table.remove(saves, i); break end end
		if autoLoadName == selectedName then autoLoadName = nil end
		selectedName = nil
		writeIndex(); refreshList(); refreshSaveState()
	end))
	track(autoBtn.MouseButton1Click:Connect(function()
		if not autoBtn:GetAttribute("Enabled") then return end
		if not selectedName then return end
		if autoLoadName == selectedName then autoLoadName = nil else autoLoadName = selectedName end
		writeIndex(); refreshList(); refreshSaveState()
	end))

	ensureFolder(); readIndex(); refreshList(); refreshSaveState()
	if autoLoadName and isfile and isfile(filePath(autoLoadName)) then
		task.defer(function()
			while gui.Parent and not revealed do task.wait(0.1) end
			task.wait(0.4)
			if not gui.Parent then return end
			local data = readSave(autoLoadName)
			if data and type(data.state) == "table" then applyState(data.state) end
		end)
	end
end)

-- ===== MINIMIZE / CLOSE / STARTUP =====
local MINI_SIZE = 54
local iconPos = nil

local mini = make("ImageButton", {
	Name = "MiniIcon",
	Position = UDim2.fromOffset(0, 0),
	Size = UDim2.fromOffset(MINI_SIZE, MINI_SIZE),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	AutoButtonColor = false,
	Image = ICONS.Logo,
	ImageTransparency = 1,
	ScaleType = Enum.ScaleType.Fit,
	Visible = false,
	ZIndex = 45,
}, gui)

local function placeMini()
	local x, y
	if iconPos then
		x, y = iconPos.X, iconPos.Y
	else
		x = root.Position.X.Offset + 4
		y = root.Position.Y.Offset + 2
	end
	local vp = viewportSize()
	x = math.clamp(x, 0, math.max(vp.X - MINI_SIZE, 0))
	y = math.clamp(y, 0, math.max(vp.Y - MINI_SIZE, 0))
	mini.Position = UDim2.fromOffset(x, y)
end

local function minimizeMenu()
	if busy or closing or minimized or not revealed then return end
	busy = true
	minimized = true
	placeMini()
	mini.ImageTransparency = 1
	mini.Visible = true
	tw(mini, 0.22, { ImageTransparency = 0 })
	tw(scale, 0.18, { Scale = targetScale * 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.2, function()
		if minimized and not closing then root.Visible = false end
		busy = false
	end)
end

local function restoreMenu()
	if busy or closing or not minimized then return end
	busy = true
	minimized = false
	if reclampAll then reclampAll() end
	scale.Scale = targetScale * 0.9
	root.Visible = true
	tw(scale, 0.25, { Scale = targetScale }, Enum.EasingStyle.Quint)
	tw(mini, 0.15, { ImageTransparency = 1 })
	task.delay(0.17, function()
		if not minimized then mini.Visible = false end
		busy = false
	end)
end

track(minBtn.MouseButton1Click:Connect(function()
	playClick()
	minimizeMenu()
end))

track(mini.MouseButton1Down:Connect(function()
	if minimized then tw(mini, 0.08, { ImageTransparency = 0.25 }) end
end))
track(mini.MouseButton1Up:Connect(function()
	if minimized then tw(mini, 0.12, { ImageTransparency = 0 }) end
end))

-- Close: matikan semua fitur yang ON lewat reg.Set(false)
local function shutdownAllFeatures()
	for name, reg in pairs(ToggleRegistry) do
		if type(reg) == "table" and type(reg.Get) == "function" then
			local ok, on = pcall(reg.Get)
			if ok and on == true then
				pcall(function() reg.Set(false) end)
			end
		end
	end
end

local function finalizeClose()
	pcall(shutdownAllFeatures)
	for _, connection in ipairs(conns) do pcall(function() connection:Disconnect() end) end
	pcall(function() gui:Destroy() end)
	if genv.FluxHub == FluxHub then
		genv.FluxHub = nil
	end
end

FluxHub.__shutdown = finalizeClose


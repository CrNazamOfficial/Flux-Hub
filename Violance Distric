			if not vis then return end
			if not wasVis then
				AG.Busy = false
				if not AG.ScourgeActive and AG.Mode == "INSTANT" then AG_InstantNormal() end
			end
			if not AG.ScourgeActive then
				if not AG.Busy then
					local should = false
					if AG.Mode == "PERFECT" then should = AG_IsPerfect()

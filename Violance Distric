	local function StunAttributeActive(char)
		local ok, attrs = pcall(function()
			return char:GetAttributes()
		end)
		if not ok or type(attrs) ~= "table" then
			return false
		end
		for name, value in pairs(attrs) do
			if string.find(string.lower(tostring(name)), "stun", 1, true) then
				if value ~= nil and value ~= false and value ~= 0 then
					return true
				end
			end
		end
		return false
	end

	local function MarkShot(body)
		if not body or not body.Parent then
			return
		end
		local char = body.Parent
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hum then
			hitWatch = nil
			return
		end
		hitWatch = {
			char = char,
			hum = hum,
			t0 = os.clock(),
			hp = hum.Health,
			ws = hum.WalkSpeed,
			stun = StunAttributeActive(char),
		}
	end

	local function StepHit()
		local w = hitWatch
		if not w then
			return
		end
		local now = os.clock()
		if now - w.t0 > HIT_WATCH_TIME or not w.char.Parent or not w.hum.Parent then
			hitWatch = nil
			return
		end
		local hum = w.hum
		local why = nil
		if hum.Health < w.hp - 0.01 then
			why = "damage"
		elseif w.ws > 0 and hum.WalkSpeed <= w.ws * STUN_SPEED_RATIO then
			why = "stun"
		elseif not w.stun and StunAttributeActive(w.char) then
			why = "stun"
		end
		if hum.Health > w.hp then
			w.hp = hum.Health
		end
		if hum.WalkSpeed > w.ws then
			w.ws = hum.WalkSpeed
		end
		if why then
			hitWatch = nil
			if now - lastHitAt >= HIT_DEBOUNCE then
				lastHitAt = now
				PlayHitSound(false)
			end
		end
	end


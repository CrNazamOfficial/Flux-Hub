		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "Map : -  |  Killer : -",
	}, box)
	local dragging, dragStart, startPos = false, nil, nil
	table.insert(MP.Conns, box.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startPos = Vector2.new(box.Position.X.Offset, box.Position.Y.Offset)
		end
	end))
	table.insert(MP.Conns, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = Vector2.new(input.Position.X, input.Position.Y) - dragStart
			box.Position = UDim2.new(box.Position.X.Scale, startPos.X + d.X, 0, startPos.Y + d.Y)
		end
	end))

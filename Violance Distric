	local function AB2_checkPending()
		local p = AB2.Pending
		if not p then return end
		local waitTime = math.max(AB2_CFG.AckWait, AB2.PingSec + 0.3)
		if os.clock() - p.t < waitTime then return end
		AB2.Pending = nil
		local known = p.a ~= nil or p.b ~= nil or AB2.CdA ~= nil or AB2.CdB ~= nil
		if not known then AB2.Status = "?"; return end
		local accepted = (AB2.CdA ~= p.a) or (AB2.CdB ~= p.b)
		if accepted then
			AB2.Status = "OK"
			if p.dev >= AB2.MaxAngle - 0.5 then
				AB2.MaxAngle = math.min(180, AB2.MaxAngle * 1.3 + 1)
			end
			return
		end
		AB2.Status = "DITOLAK"
		AB2.MaxAngle = math.max(AB2_CFG.MinAngle, p.dev * 0.5)
		local fb = AB2_copyArgs(p.orig)
		local info = fb[3]
		if type(info) == "table" then
			local ni = {}
			for k, v in pairs(info) do ni[k] = v end
			if type(ni.Time) == "number" then
				local ok, sn = pcall(function() return workspace:GetServerTimeNow() end)
				if ok and type(sn) == "number" and math.abs(ni.Time - (sn - (os.clock() - p.t))) < 3 then
					ni.Time = sn
				end
			end
			fb[3] = ni
		end
		AB2.Bypass = true
		pcall(function() p.remote:FireServer(table.unpack(fb, 1, fb.n)) end)
		AB2.Bypass = false
		AB2.Status = "DITOLAK, kirim normal"
	end


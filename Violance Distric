local PanelToggleBusy = {}
local _PanelRegistryRef = nil
local function SetPanelRegistry(ref) _PanelRegistryRef = ref end
local function SafePanelToggle(name, newState)
	local reg = _PanelRegistryRef and _PanelRegistryRef[name]
	if not reg and ToggleRegistry then reg = ToggleRegistry[name] end
	if not reg or type(reg.Get) ~= "function" or type(reg.Set) ~= "function" then return end
	if PanelToggleBusy[name] then return end
	PanelToggleBusy[name] = true
	local cur = false
	pcall(function() cur = reg.Get() end)
	local target = (newState ~= nil) and newState or (not cur)
	if cur ~= target then pcall(function() reg.Set(target) end) end
	task.delay(0.05, function() PanelToggleBusy[name] = nil end)
end


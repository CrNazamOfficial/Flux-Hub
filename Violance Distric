			if self.Close == close then self.Close = nil end
			self.OpenExtra = 0
			self:Relayout(true)
			tw(arrow, 0.18, { Rotation = 0 })
			tw(btnStroke, 0.18, { Transparency = 0.3 })
			task.delay(0.2, function() if mine == token and not isOpen then list.Visible = false end end)

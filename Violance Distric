            btn.Text = ok and "Copied!" or "Gagal"
            task.delay(1.4, function() if btn.Parent then btn.Text = "Copy Invite" end end)
        end))
    end

    Title("Changelog")
    local logCard = make("Frame", { Name = "ChangelogCard", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = C.Button, BackgroundTransparency = 0.35, BorderSizePixel = 0, LayoutOrder = nextOrder(p), ZIndex = 4 }, p)
    corner(logCard, 8)
    stroke(logCard, C.Border, 1, 0.3)
    make("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, logCard)
    make("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, logCard)
    for i, entry in ipairs(CHANGELOG) do
        local item = make("Frame", { Name = "Entry_" .. i, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = i, ZIndex = 5 }, logCard)
        local tag = make("TextLabel", { Size = UDim2.new(0, 0, 0, 18), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = C.White, BackgroundTransparency = 0.75, BorderSizePixel = 0, Text = tostring(entry[1]), TextColor3 = C.Text, Font = Enum.Font.GothamBold, TextSize = 9, ZIndex = 6 }, item)

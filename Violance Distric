	local function analyzeMotion(tr, now)
		local h = tr.hist
		local cutoff = now - Config.ZigzagWindow
		while #h > 0 and h[1].t < cutoff do
			table.remove(h, 1)
		end
		local n = #h
		if n < 4 or (h[n].t - h[1].t) < 0.2 then return nil, 1 end
		local t0, x0, z0 = h[1].t, h[1].x, h[1].z
		local st, stt, sx, stx, sz, stz = 0, 0, 0, 0, 0, 0
		for i = 1, n do
			local t = h[i].t - t0
			local x = h[i].x - x0
			local z = h[i].z - z0
			st = st + t
			stt = stt + t * t
			sx = sx + x
			stx = stx + t * x
			sz = sz + z
			stz = stz + t * z
		end
		local D = n * stt - st * st
		if math.abs(D) < 1e-9 then return nil, 1 end
		local bx = (n * stx - st * sx) / D
		local ax = (sx - bx * st) / n
		local bz = (n * stz - st * sz) / D
		local az = (sz - bz * st) / n
		local sq = 0
		for i = 1, n do
			local t = h[i].t - t0
			local ex = (h[i].x - x0) - (ax + bx * t)
			local ez = (h[i].z - z0) - (az + bz * t)
			sq = sq + ex * ex + ez * ez
		end
		local rms = math.sqrt(sq / n)
		local span = math.max(Config.ZigzagFull - Config.ZigzagDeadzone, 0.01)
		local stable = math.clamp(1 - (rms - Config.ZigzagDeadzone) / span, 0, 1)
		return Vector3.new(bx, 0, bz), stable
	end

	local function trackVelocity(root, now)
		local pos = root.Position
		local tr = Tracker[root]
		if not tr then
			tr = { pos = pos, t = now, vel = Vector3.new(), hist = {}, pred = nil, stable = 1 }
			Tracker[root] = tr
		end
		local jump = (pos - tr.pos).Magnitude
		if jump > 15 then
			tr.hist = { { t = now, x = pos.X, z = pos.Z } }
			tr.vel = Vector3.new()
			tr.pred = nil
			tr.stable = 1
			tr.pos = pos
			tr.t = now
			return tr.vel
		end
		table.insert(tr.hist, { t = now, x = pos.X, z = pos.Z })
		tr.pred, tr.stable = analyzeMotion(tr, now)
		if jump < 0.001 then
			if now - tr.t > 0.15 then tr.vel = Vector3.new() end
			return tr.vel
		end
		local dt = now - tr.t
		if dt <= 0 or dt > 0.35 then
			tr.vel = Vector3.new()
		else
			local raw = (pos - tr.pos) / dt
			if raw.Magnitude > 180 then
				tr.vel = Vector3.new()
			else
				tr.vel = tr.vel:Lerp(raw, Config.VelocitySmooth)
			end
		end
		tr.pos = pos
		tr.t = now
		return tr.vel
	end

	local function wallBlocked(origin, pos, char)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ignore = { char }
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character then table.insert(ignore, p.Character) end
		end
		for _ = 1, 8 do
			params.FilterDescendantsInstances = ignore
			local res = Workspace:Raycast(origin, pos - origin, params)
			if not res then return false end
			local inst = res.Instance
			if inst:IsA("BasePart") and (inst.Transparency >= 0.05 or not inst.CanCollide) then
				table.insert(ignore, inst)
			else
				return true
			end
		end
		return false
	end

	local function refreshTargets(now)
		local cam = Workspace.CurrentCamera
		local myRoot = Aim.MyRoot
		if not cam or not myRoot then
			Aim.Target = nil
			return
		end
		local vp = cam.ViewportSize
		local center = Vector2.new(vp.X / 2, vp.Y / 2)
		local origin = myRoot.Position
		local list = {}
		local best = nil
		for _, char in ipairs(survivorList()) do
			local root = char:FindFirstChild("HumanoidRootPart")
			if root and validTarget(char) then
				local dist = (root.Position - origin).Magnitude
				if dist > 0.5 and dist <= Config.MaxDistance then
					local vel = trackVelocity(root, now)
					local tr = Tracker[root]
					local stable = (tr and tr.stable) or 1
					local hv = Vector3.new(vel.X, 0, vel.Z)
					if tr and tr.pred then
						hv = tr.pred:Lerp(hv, stable)
					end
					if hv.Magnitude > Config.MaxPredictSpeed then
						hv = hv.Unit * Config.MaxPredictSpeed
					end
					local sp, onScreen = cam:WorldToViewportPoint(root.Position)
					if onScreen and sp.Z > 0 then
						local sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
						if sd <= Config.FOV and not (Config.WallCheck and wallBlocked(origin, root.Position, char)) then
							local score = sd
							local entry = { char = char, root = root, name = char.Name, dist = dist, hv = hv, stable = stable, score = score }
							table.insert(list, entry)
							if not best or score < best.score then
								best = entry
							end
						end
					end
				end
			end
		end
		if best and Aim.PrevRoot and best.root ~= Aim.PrevRoot then
			for _, e in ipairs(list) do
				if e.root == Aim.PrevRoot and (e.score - best.score) < Config.Hysteresis then
					best = e
					break
				end
			end
		end
		if best then
			Aim.Target = best
			Aim.PrevRoot = best.root
			Aim.UpdatedAt = now
		else
			Aim.Target = nil
		end
	end

	local function cleanTargetTables()
		for root in pairs(Tracker) do
			if not root.Parent then
				Tracker[root] = nil
			end
		end
	end

	local function maxSpeed()
		if SpearMath and type(SpearMath.Speed) == "number" then return SpearMath.Speed end
		return 165
	end

	local function gravity()
		if SpearMath and typeof(SpearMath.Gravity) == "Vector3" then
			return math.abs(SpearMath.Gravity.Y)
		end
		return 98.1
	end

	local function currentSpeed()
		local s = maxSpeed()
		if LastPower and os.clock() - LastPowerAt <= Config.PowerFresh then
			s = LastPower
		end
		return math.clamp(s, 1, maxSpeed())
	end

	local function solveDirection(origin, speed, base, hv, g, lead)
		local t = (base - origin).Magnitude / speed
		local dirOut = nil
		for _ = 1, 8 do
			local aimPos = base + hv * (math.min(t, Config.PredictMaxTime) + lead)
			local d = aimPos - origin
			local hd = Vector3.new(d.X, 0, d.Z)
			local x = hd.Magnitude
			local y = d.Y
			if x < 0.01 then
				dirOut = Vector3.new(0, y >= 0 and 1 or -1, 0)
				t = math.abs(y) / speed
			elseif g <= 0 then
				dirOut = d.Unit
				t = d.Magnitude / speed
			else
				local v2 = speed * speed
				local disc = v2 * v2 - g * (g * x * x + 2 * y * v2)
				local tanT
				if disc >= 0 then
					tanT = (v2 - math.sqrt(disc)) / (g * x)
				else
					tanT = v2 / (g * x)
				end
				local theta = math.atan(tanT)
				local hdir = hd / x
				dirOut = hdir * math.cos(theta) + Vector3.new(0, math.sin(theta), 0)
				local vx = speed * math.cos(theta)
				if vx > 0.01 then
					t = x / vx
				end
			end
		end
		if not dirOut or dirOut.X ~= dirOut.X or dirOut.Y ~= dirOut.Y or dirOut.Z ~= dirOut.Z then
			return nil
		end
		return dirOut
	end

	local function resolveOrigin(origin)
		local mr = Aim.MyRoot
		if mr and mr.Parent and (origin - mr.Position).Magnitude > 25 then
			return mr.Position + Vector3.new(0, 1.5, 0)
		end
		return origin
	end

	local function spawnTrail(origin, dir)
		local speed = currentSpeed()
		local g = gravity()

		local part = Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Transparency = 1
		part.Size = Vector3.new(0.2, 0.2, 0.2)
		part.CFrame = CFrame.new(origin)

		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, Config.TrailWidth / 2, 0)
		a0.Parent = part
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -Config.TrailWidth / 2, 0)
		a1.Parent = part

		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(Config.TrailColor)
		trail.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.1),
			NumberSequenceKeypoint.new(0.5, 0.5),
			NumberSequenceKeypoint.new(1, 1),
		})
		trail.WidthScale = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0.2),
		})
		trail.Lifetime = Config.TrailLifetime
		trail.MinLength = 0
		trail.LightEmission = 1
		trail.LightInfluence = 0
		trail.FaceCamera = true
		trail.Parent = part

		part.Parent = Workspace
		table.insert(TrailParts, part)

		local pos = origin
		local vel = dir.Unit * speed
		local elapsed = 0
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude

		while not Unloaded and elapsed < Config.TrailMaxTime do
			local dt = math.min(RunService.Heartbeat:Wait(), 0.05)
			local newPos = pos + vel * dt
			local newVel = vel + Vector3.new(0, -g, 0) * dt

			local ignore = { part }
			if LP.Character then table.insert(ignore, LP.Character) end
			params.FilterDescendantsInstances = ignore

			local hit = Workspace:Raycast(pos, newPos - pos, params)
			if hit then
				part.CFrame = CFrame.new(hit.Position)
				break
			end

			part.CFrame = CFrame.new(newPos)
			pos = newPos
			vel = newVel
			elapsed = elapsed + dt
		end

		trail.Enabled = false
		task.wait(Config.TrailLifetime + 0.2)
		local idx = table.find(TrailParts, part)
		if idx then table.remove(TrailParts, idx) end
		pcall(function() part:Destroy() end)
	end

	local function throwHandler(args, self)
		if Unloaded or not Aim.IsKiller then return nil end
		local first = args[1]
		if type(first) ~= "table" then return nil end
		local dir = first.Direction
		local origin = first.Origin
		if typeof(dir) ~= "Vector3" or typeof(origin) ~= "Vector3" then return nil end

		origin = resolveOrigin(origin)
		local finalDir = dir
		local out = nil

		local t = Aim.Target
		if State.Enabled and t and t.root and t.root.Parent
			and os.clock() - Aim.UpdatedAt <= Config.TargetStale then
			local stable = t.stable or 1
			local lead = (Aim.Ping * Config.LeadPingMult + Config.ExtraLead) * (Config.ZigzagLeadMin + (1 - Config.ZigzagLeadMin) * stable)
			local base = bodyCenter(t.char, t.root) + Vector3.new(0, Config.AimOffsetY, 0)
			local newDir = solveDirection(origin, currentSpeed(), base, t.hv or Vector3.new(), gravity(), lead)
			if newDir then
				local copy = {}
				for k, v in pairs(first) do
					copy[k] = v
				end
				copy.Direction = newDir
				out = table.pack(table.unpack(args, 1, args.n))
				out[1] = copy
				finalDir = newDir
			end
		end

		task.spawn(spawnTrail, origin, finalDir)
		return out
	end

	local function ensureHook()
		if Reg.Installed then return true end
		local wrap = newcclosure or function(f) return f end
		if hookmetamethod and getnamecallmethod then
			local ok = pcall(function()
				local old
				old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
					local method = getnamecallmethod()
					if method == "FireServer" then
						local fn = Reg.Handlers[self]
						if fn then
							local mine = false
							if checkcaller then mine = checkcaller() end
							if not mine then
								local args = table.pack(...)
								local okH, result = pcall(fn, args, self)
								if setnamecallmethod then
									pcall(setnamecallmethod, method)
								end
								if okH and type(result) == "table" then
									return old(self, table.unpack(result, 1, result.n or #result))
								end
							end
						end
					end
					return old(self, ...)
				end))
				Reg.Old = old
				Reg.Installed = true
			end)
			if ok and Reg.Installed then return true end
		end
		if hookfunction then
			local ok = pcall(function()
				local fs = Instance.new("RemoteEvent").FireServer
				local old
				old = hookfunction(fs, wrap(function(self, ...)
					local fn = Reg.Handlers[self]
					if fn then
						local mine = false
						if checkcaller then mine = checkcaller() end
						if not mine then
							local args = table.pack(...)
							local okH, result = pcall(fn, args, self)
							if okH and type(result) == "table" then
								return old(self, table.unpack(result, 1, result.n or #result))
							end
						end
					end
					return old(self, ...)
				end))
				Reg.Old = old
				Reg.Installed = true
			end)
			if ok and Reg.Installed then return true end
		end
		return false
	end


		end
	end
	local best, bestSpeed = nil, 0
	for p, c in pairs(job.cands) do
		if not p.Parent then job.cands[p] = nil
		else local age = now - c.t; if age >= 0.1 then local sp = (p.Position - c.pos).Magnitude / age; if sp > bestSpeed then bestSpeed = sp; best = p end end end

	local function IsKillerChar(player, char)
		if char:FindFirstChild(KILLER_MARKER_NAME, true) then
			return true
		end
		local okTag, hasTag = pcall(function()
			return char:HasTag("Killer")
		end)
		if okTag and hasTag then
			return true
		end
		if player.Team and player.Team.Name == "Killer" then
			return true
		end
		return false
	end

	local function GetTarget()
		local myChar = GetCharacter()
		local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

		if not myHRP then
			return nil, nil
		end

		if targetMode == "Killer" then
			local nearestBody, nearestName = nil, nil
			local nearestDistance = math.huge

			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= PLAYER then
					local char = player.Character
					if char and IsKillerChar(player, char) then
						local hum = char:FindFirstChildOfClass("Humanoid")
						local body = GetBody(char)
						if body and (not hum or hum.Health > 0) then
							local distance = (body.Position - myHRP.Position).Magnitude
							if distance < nearestDistance then
								nearestDistance = distance
								nearestBody = body
								nearestName = player.Name
							end
						end
					end
				end
			end

			return nearestBody, nearestName
		end

		local cam = workspace.CurrentCamera
		if not cam then
			return nil, nil
		end

		local camPos = cam.CFrame.Position
		local camLook = cam.CFrame.LookVector
		local bestBody, bestName, bestDot = nil, nil, -math.huge

		for _, root in ipairs(GetSCPs()) do
			if root and root.Parent then
				local dir = root.Position - camPos
				if dir.Magnitude > 0.001 then
					local dot = camLook:Dot(dir.Unit)
					if dot > 0.5 and dot > bestDot then
						bestDot = dot
						bestBody = root
						bestName = root.Parent.Name
					end
				end
			end
		end

		return bestBody, bestName
	end

	local targetBody = nil

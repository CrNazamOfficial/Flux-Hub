	local function WE_Handle(child)
		if not WE.Enabled or child.Name ~= "VaultTrigger" then return end
		local win = child.Parent; if not win or not win:IsA("Model") then return end
		if WE.Scanned[win] or WE.Objects[win] then return end
		WE.Scanned[win] = true
		local bottom = win:FindFirstChild("Bottom")

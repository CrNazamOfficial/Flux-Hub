local function make(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props) do obj[k] = v end
	if parent then obj.Parent = parent end
	return obj
end

local function corner(parent, radius)
	return make("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function stroke(parent, color, thickness, transparency)
	return make("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function tw(obj, time, props, style, dir)
	local tween = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

local function track(conn) conns[#conns + 1] = conn; return conn end

local function safeCall(fn, ...)
	if type(fn) == "function" then
		local ok, err = pcall(fn, ...)
		if not ok then warn("[FluxHub] " .. tostring(err)) end
	end
end

local function getParent()
	local ok, ui = pcall(function() if gethui then return gethui() end return nil end)
	if ok and ui then return ui end
	local ok2 = pcall(function()
		local test = Instance.new("Folder")
		test.Parent = CoreGui
		test:Destroy()
	end)
	if ok2 then return CoreGui end
	local lp = Players.LocalPlayer
	while not lp do task.wait(); lp = Players.LocalPlayer end
	return lp:WaitForChild("PlayerGui")
end


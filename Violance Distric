-- ===== API JEMBATAN =====
function FluxHub:Get(name)
	local api = FeatureRegistry[name]
	if api then return api end
	return ToggleRegistry[name]
end

function FluxHub:Set(name, value, silent)
	local api = FeatureRegistry[name]
	if api and type(api.Set) == "function" then
		local ok, err = pcall(api.Set, value, silent)
		if not ok then warn("[FluxHub] Set error '" .. tostring(name) .. "': " .. tostring(err)); return false end
		return true
	end
	return false
end

function FluxHub:Bind(name, handler)
	if type(handler) ~= "function" then
		warn("[FluxHub] Bind: handler bukan function untuk '" .. tostring(name) .. "'")
		return false
	end
	if not FeatureRegistry[name] and not ToggleRegistry[name] then
		warn("[FluxHub] Bind: fitur tidak ditemukan '" .. tostring(name) .. "'")
		return false
	end
	BindHandlers[name] = handler
	return true
end

function FluxHub:GetExtras(name)
	local store = ExtrasRegistry[name]
	if type(store) ~= "table" then return {} end
	local snap = {}
	for k, api in pairs(store) do
		if type(api) == "table" and type(api.Get) == "function" then
			local ok, v = pcall(api.Get)
			if ok then snap[k] = v end
		end
	end
	return snap
end

function FluxHub:IsOn(name)
	local api = ToggleRegistry[name] or FeatureRegistry[name]
	if api and type(api.Get) == "function" then
		local ok, v = pcall(api.Get)
		if ok then return v == true end
	end
	return false
end

function FluxHub:Wait(timeout)
	timeout = timeout or 10
	local deadline = os.clock() + timeout
	while os.clock() < deadline do
		if self.Ready == true then return true end
		task.wait(0.05)
	end
	return self.Ready == true
end

function FluxHub:Notify(title, subtitle, iconId, hold)
	return showNotif(title, subtitle, iconId, hold)
end


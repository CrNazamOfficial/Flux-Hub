local MINI_SIZE = 54
local iconPos = nil
local mini = make("ImageButton", {
	Name = "MiniIcon", Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(MINI_SIZE, MINI_SIZE),
	BackgroundTransparency = 1, BorderSizePixel = 0, AutoButtonColor = false,
	Image = ICONS.Logo, ImageTransparency = 1, ScaleType = Enum.ScaleType.Fit, Visible = false, ZIndex = 45,
}, gui)
local function placeMini()
	local x, y
	if iconPos then x, y = iconPos.X, iconPos.Y
	else x = root.Position.X.Offset + 4; y = root.Position.Y.Offset + 2 end
	local vp = viewportSize()
	x = math.clamp(x, 0, math.max(vp.X - MINI_SIZE, 0))
	y = math.clamp(y, 0, math.max(vp.Y - MINI_SIZE, 0))
	mini.Position = UDim2.fromOffset(x, y)
end
local function minimizeMenu()
	if busy or closing or minimized or not revealed then return end
	busy = true; minimized = true
	placeMini(); mini.ImageTransparency = 1; mini.Visible = true
	tw(mini, 0.22, { ImageTransparency = 0 })
	tw(scale, 0.18, { Scale = targetScale * 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.2, function() if minimized and not closing then root.Visible = false end; busy = false end)
end
local function restoreMenu()
	if busy or closing or not minimized then return end
	busy = true; minimized = false
	if reclampAll then reclampAll() end
	scale.Scale = targetScale * 0.9
	root.Visible = true
	tw(scale, 0.25, { Scale = targetScale }, Enum.EasingStyle.Quint)
	tw(mini, 0.15, { ImageTransparency = 1 })
	task.delay(0.17, function() if not minimized then mini.Visible = false end; busy = false end)
end
track(minBtn.MouseButton1Click:Connect(function() playClick(); minimizeMenu() end))
track(mini.MouseButton1Down:Connect(function() if minimized then tw(mini, 0.08, { ImageTransparency = 0.25 }) end end))
track(mini.MouseButton1Up:Connect(function() if minimized then tw(mini, 0.12, { ImageTransparency = 0 }) end end))
track(closeBtn.MouseButton1Click:Connect(function()
	playClick()
	if closing then return end
	closing = true
	mini.Visible = false
	tw(scale, 0.2, { Scale = targetScale * 0.85 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.22, function()
		for _, connection in ipairs(conns) do pcall(function() connection:Disconnect() end) end
		pcall(function() gui:Destroy() end)
	end)
end))
local headerHandles = { header }
for _, obj in ipairs(header:GetDescendants()) do
	if obj:IsA("GuiObject") and obj ~= minBtn and obj ~= closeBtn and not obj:IsDescendantOf(minBtn) and not obj:IsDescendantOf(closeBtn) then
		headerHandles[#headerHandles + 1] = obj
	end
end
makeDrag({ Handles = headerHandles, Target = root, Size = function() return Vector2.new(rootW, rootH) end, Smooth = DRAG_SMOOTH, Threshold = 3 })
makeDrag({
	Handles = { mini }, Target = mini, Size = Vector2.new(MINI_SIZE, MINI_SIZE), Threshold = 6,
	OnTap = function() playClick(); restoreMenu() end,
	OnDragEnd = function(x, y) iconPos = Vector2.new(x, y) end,
})
revealMenu = function()
	if revealed or closing then return end
	revealed = true
	local vp = viewportSize()
	root.Position = UDim2.fromOffset(math.max(math.floor((vp.X - rootW) / 2), 0), math.max(math.floor((vp.Y - rootH) / 2), 0))
	scale.Scale = targetScale * 0.88
	root.Visible = true
	floatLayer.Visible = true
	tw(scale, 0.3, { Scale = targetScale }, Enum.EasingStyle.Quint)
	task.delay(0.32, function()
		if gui.Parent and not closing then
			opened = true
			if not minimized then scale.Scale = targetScale end
		end
	end)
	if reclampAll then reclampAll() end
end

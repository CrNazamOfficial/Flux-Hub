	local function InstallHook()
		if SHARED.hooked then
			return true
		end

		if not (hookmetamethod and getnamecallmethod and setnamecallmethod and newcclosure) then
			return false
		end

		local ok = pcall(function()
			local old
			old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
				local method = getnamecallmethod()

				if method == "FireServer" and self == SHARED.remote then
					local mine = false
					if checkcaller then
						mine = checkcaller()
					end

					if not mine then
						local fn = SHARED.aim
						if fn then
							local tool, dir = ...
							if typeof(tool) == "Instance" and typeof(dir) == "Vector3" then
								local okAim, newDir = pcall(fn)
								if okAim and typeof(newDir) == "Vector3" then
									setnamecallmethod("FireServer")
									return old(self, tool, newDir, select(3, ...))
								end
							end
						end
					end

					setnamecallmethod("FireServer")
					return old(self, ...)
				end

				return old(self, ...)
			end))
		end)

		if ok then
			SHARED.hooked = true
		end

		return ok
	end


local function SE_IsKiller(p)
	if p == Players.LocalPlayer then return false end
	if p:GetAttribute("Role") == "Killer" or p:GetAttribute("IsKiller") == true then return true end
	if p.Character then
		if p.Character:GetAttribute("IsKiller") == true or p.Character:GetAttribute("Role") == "Killer" then return true end
		if p.Character:FindFirstChild("Lookscriptkiller", true) then return true end
		local tool = p.Character:FindFirstChildWhichIsA("Tool")
		if tool and (tool:FindFirstChild("Hitbox") or tool:FindFirstChild("Attack") or tool:FindFirstChild("KnifeScript")) then return true end
	end
	if p.Team then
		local tn = string.lower(p.Team.Name)
		if string.find(tn, "killer", 1, true) or string.find(tn, "murder", 1, true) then return true end
	end
	return false
end

local function SE_Clear(p)
	local o = SE.Objs[p]
	if not o then return end
	SE.Objs[p] = nil
	pcall(function() o.hl:Destroy() end)
end

local function SE_RefreshHighlight(p)
	if p == Players.LocalPlayer then return end
	local char = p.Character
	if not char or not char.Parent then SE_Clear(p); return end
	if SE_IsKiller(p) then SE_Clear(p); return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then SE_Clear(p); return end

	local o = SE.Objs[p]
	if o and o.char == char and o.hl and o.hl.Parent then
		pcall(function()
			o.hl.FillColor = SE.Color
			o.hl.OutlineColor = SE.Color
		end)
		return
	end

	SE_Clear(p)
	local hl = Instance.new("Highlight")
	hl.Name = "SurvivorESP_Chams"
	hl.FillColor = SE.Color
	hl.FillTransparency = 0.75
	hl.OutlineColor = SE.Color
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = char

	SE.Objs[p] = { hl = hl, char = char }
end

local function SE_Apply(p)
	if p == Players.LocalPlayer then return end
	if p:GetAttribute("_ESP_Hooked") then return end
	p:SetAttribute("_ESP_Hooked", true)
	table.insert(SE.Conns, p.CharacterAdded:Connect(function(char)
		for i = 1, 6 do
			task.wait(i == 1 and 0.1 or 0.4)
			if not char.Parent then return end
			SE_RefreshHighlight(p)
		end
	end))
	if p.Character then
		task.spawn(function()
			for i = 1, 6 do
				task.wait(i == 1 and 0.1 or 0.4)
				if not p.Character or not p.Character.Parent then return end
				SE_RefreshHighlight(p)
			end
		end)
	end
	table.insert(SE.Conns, p:GetAttributeChangedSignal("Role"):Connect(function() SE_RefreshHighlight(p) end))
	table.insert(SE.Conns, p:GetAttributeChangedSignal("IsKiller"):Connect(function() SE_RefreshHighlight(p) end))
	table.insert(SE.Conns, p.Changed:Connect(function(prop)
		if prop == "Team" then SE_RefreshHighlight(p) end
	end))
end

local SE_Row = Add("Survivor Esp")
local SE_Toggle = SE_Row:Toggle(false, function(state)
	SE.Enabled = state
	if state then
		for _, p in ipairs(Players:GetPlayers()) do SE_Apply(p) end
		table.insert(SE.Conns, Players.PlayerAdded:Connect(SE_Apply))
		SE.Watchdog = task.spawn(function()

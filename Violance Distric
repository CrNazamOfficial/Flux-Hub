	task.spawn(function()
		local lastPct = -1
		while GE.Enabled and obj and obj.Parent do
			local o = GE.Objs[obj]
			if not o or o.hl ~= hl or not hl.Parent then return end
			if not GE_IsGeneratorModel(obj) then GE_Cleanup(obj); return end
			local p = math.clamp(GE_Progress(obj) or 0, 0, 100)
			local pct = math.floor(p + 0.5)
			if pct ~= lastPct then
				lastPct = pct
				local c = GE_Color(p / 100)
				local hex = string.format("%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
				lbl.Text = string.format('Generator | <font color="#%s">%d%%</font>', hex, pct)
				hl.OutlineTransparency = (pct >= 100) and 1 or 0
				hl.FillTransparency = (pct >= 100) and 1 or 0.85
				tag.Enabled = (pct < 100)
			end
			task.wait(0.15)
		end
		GE_Cleanup(obj)
	end)

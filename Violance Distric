		p.Name = "Seg_" .. i; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.CastShadow = false
		p.Material = Enum.Material.Neon; p.Size = Vector3.new(1, 0.05, 0.18); p.Color = AP.Cfg.RingColor; p.Transparency = 0.35
		p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = f
		segs[i] = p
	end
	AP.State.RingParts = segs
	return segs
end

local function AP_GroundDy(hrp, myChar)
	if not hrp then return 0 end
	if not AP.State.RayParams then
		AP.State.RayParams = RaycastParams.new()
		AP.State.RayParams.FilterType = Enum.RaycastFilterType.Exclude
		AP.State.RayParams.RespectCanCollide = true
	end
	if AP.State.RayChar ~= myChar then
		AP.State.RayChar = myChar
		AP.State.RayParams.FilterDescendantsInstances = myChar and { myChar } or {}
	end
	local ok, res = pcall(workspace.Raycast, workspace, hrp.Position, Vector3.new(0, -30, 0), AP.State.RayParams)
	if ok and res then return (res.Position.Y + 0.1) - hrp.Position.Y end
	local hip = 2
	local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
	if hum and hum.HipHeight and hum.HipHeight >= 0.1 then hip = hum.HipHeight end
	return -(hip + hrp.Size.Y / 2) + 0.1
end

local function AP_UpdateRing(hrp, myChar, range)
	local parts = AP_EnsureRing()
	if not parts then return end
	local cam = workspace.CurrentCamera
	if AP.State.RingFolder.Parent ~= cam then AP.State.RingFolder.Parent = cam end
	local step = (2 * math.pi) / 32
	local dy = AP_GroundDy(hrp, myChar)
	local baseY = hrp.Position.Y + dy
	for i = 1, 32 do
		local seg = parts[i]
		local a0 = (i - 1) * step
		local a1 = a0 + step * 0.7
		local p0x, p0z = math.cos(a0) * range, math.sin(a0) * range
		local p1x, p1z = math.cos(a1) * range, math.sin(a1) * range
		local mx, mz = (p0x + p1x) / 2, (p0z + p1z) / 2
		local dx, dz = p1x - p0x, p1z - p0z
		local len = math.sqrt(dx * dx + dz * dz)
		if len < 0.001 then
			seg.Transparency = 1
		else
			local yaw = math.atan2(dz, dx)
			seg.Size = Vector3.new(len, 0.05, 0.18)
			seg.CFrame = CFrame.new(hrp.Position.X + mx, baseY, hrp.Position.Z + mz) * CFrame.Angles(0, -yaw, 0)
			seg.Transparency = 0.35
			seg.Color = AP.Cfg.RingColor
		end
	end
end


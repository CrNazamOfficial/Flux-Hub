	local function AB2_onFire(remote, args)
		if AB2.Dead then return nil end
		local a1 = args[1]
		local now = os.clock()
		local isVec = typeof(a1) == "Vector3"
		if isVec and AB2.LastSent and a1 == AB2.LastSent and now - AB2.LastSentT < 0.15 then return nil end
		if isVec then AB2.Fired = AB2.Fired + 1 end
		if not AB2.Enabled then return nil end
		if a1 == "windup" then
			AB2.Casting = true
			AB2.CastUntil = now + AB2_CFG.CastTimeout
			return nil
		end
		if not isVec then return nil end
		if AB2.Casting then AB2.CastUntil = now + AB2_CFG.FaceHold end
		local snap = AB2.Snap
		if not snap then return nil end
		local info = args[3]
		local origin
		if type(info) == "table" and typeof(info.Origin) == "Vector3" then origin = info.Origin end
		if not origin then origin = AB2.CamPos end
		if not origin then return nil end
		local aim = AB2_aimFromSnap(snap, origin)
		local d = aim - origin
		local m = d.Magnitude
		if m ~= m or m < 0.5 or m == math.huge then return nil end
		local sent = AB2_limitDir(a1, d.Unit, AB2.MaxAngle)
		local sm = sent.Magnitude
		if sm ~= sm or sm < 0.5 then return nil end
		sent = sent.Unit
		local base = sent
		if a1.Magnitude > 0.001 then base = a1.Unit end
		local dev = math.deg(math.acos(math.clamp(AB2_dot(base, sent), -1, 1)))
		local out = AB2_copyArgs(args)
		out[1] = sent
		AB2.Changed = AB2.Changed + 1
		AB2.LastSent = sent
		AB2.LastSentT = now
		AB2.Pending = { t = now, remote = remote, orig = args, dev = dev, a = AB2.CdA, b = AB2.CdB }
		return out
	end


local function AP_Process(rec, now, fresh)
	if rec.isLunge then
		if (not fresh) and (not rec.data.lunging) and (now - rec.start > 0.1) then
			if AP.Attacks[rec.key] == rec then AP.Attacks[rec.key] = nil end
			return false
		end
	else
		local tr = rec.track
		if (not fresh) and (not tr.IsPlaying) and (now - rec.start > 0.1) then
			if AP.Attacks[tr] == rec then AP.Attacks[tr] = nil end
			return false
		end
	end
	if not (AP.MyRoot and AP.MyRoot.Parent) then return false end
	local kroot = rec.kroot
	if not (kroot and kroot.Parent) then
		kroot = rec.data.char:FindFirstChild("HumanoidRootPart")
		rec.kroot = kroot
		if not kroot then return false end
	end
	local valid, dist = AP_DistCheck(kroot)
	if not valid then
		if rec.armed == nil then rec.armed = false end
		return false
	end
	local delta = AP.MyRoot.Position - kroot.Position
	local inRange = dist <= AP.Range
	if rec.armed == nil then rec.armed = AP.MyAlive and (AP_Eff(kroot, delta, dist) <= AP.Range) or false end
	if not rec.armed then
		if rec.data.lunging then rec.armed = true else return false end
	end
	if (not AP.Enabled) or (not AP.MyAlive) then return inRange end
	local eff = AP_Eff(kroot, delta, dist)
	if eff <= AP.Range then
		local hit = AP_HIT_TIME[rec.id]

	--------------------------------------------------
	-- PREDICTION: VELOCITY TRACKER
	--------------------------------------------------

	local track = {
		body = nil,
		hist = {},
		vel = Vector3.new(0, 0, 0),
	}

	local function ResetTrack()
		track.body = nil
		track.hist = {}
		track.vel = Vector3.new(0, 0, 0)
	end

	local function UpdateVelocity(body)
		local now = os.clock()
		local pos = body.Position

		if track.body ~= body then
			track.body = body
			track.hist = { { t = now, p = pos } }
			track.vel = Vector3.new(0, 0, 0)
			return track.vel
		end

		local hist = track.hist
		local last = hist[#hist]

		if last and (pos - last.p).Magnitude > 25 then
			track.hist = { { t = now, p = pos } }
			track.vel = Vector3.new(0, 0, 0)
			return track.vel
		end

		if not last or now - last.t >= 0.01 then
			table.insert(hist, { t = now, p = pos })
		end

		while #hist > 2 and now - hist[1].t > HIST_WINDOW do
			table.remove(hist, 1)
		end

		local first = hist[1]
		local dt = now - first.t
		if #hist >= 2 and dt >= 0.1 then
			track.vel = (pos - first.p) / dt
		else
			track.vel = Vector3.new(0, 0, 0)
		end

		return track.vel
	end

	local function GetVelocity(body)
		local hv = Vector3.new(0, 0, 0)
		if track.body == body then
			hv = track.vel
		end

		local av = Vector3.new(0, 0, 0)
		local ok, v = pcall(function()
			return body.AssemblyLinearVelocity
		end)
		if ok and typeof(v) == "Vector3" then
			av = v
		end

		local vel
		if av.Magnitude >= 1 then
			if hv.Magnitude >= 1 then
				vel = (hv + av) / 2
			else
				vel = av
			end
		else
			if hv.Magnitude >= 1 then
				vel = hv * 0.5
			else
				vel = Vector3.new(0, 0, 0)
			end
		end

		vel = Vector3.new(vel.X, math.clamp(vel.Y * 0.5, -30, 30), vel.Z)

		if vel.Magnitude > MAX_TARGET_SPEED then
			vel = vel.Unit * MAX_TARGET_SPEED
		end

		return vel
	end

	local function PredictPoint(fromPos, point, body)
		local vel = GetVelocity(body)
		local lead = PREDICT_BIAS + GetPing() * PING_MULT

		local flight = (point - fromPos).Magnitude / PROJECTILE_SPEED
		for _ = 1, 6 do
			local predicted = point + vel * (flight + lead)
			flight = (predicted - fromPos).Magnitude / PROJECTILE_SPEED
		end

		local offset = vel * (flight + lead)
		if offset.Magnitude > MAX_LEAD then
			offset = offset.Unit * MAX_LEAD
		end

		local finalPos = point + offset

		if PROJECTILE_GRAVITY > 0 then
			finalPos = finalPos + Vector3.new(0, 0.5 * PROJECTILE_GRAVITY * flight * flight, 0)
		end

		return finalPos, vel
	end

	--------------------------------------------------

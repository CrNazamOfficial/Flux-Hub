		track(b.MouseEnter:Connect(function() if b:GetAttribute("Enabled") then tw(b, 0.12, { BackgroundTransparency = over }) end end))
		track(b.MouseLeave:Connect(function() if b:GetAttribute("Enabled") then tw(b, 0.12, { BackgroundTransparency = idle }) end end))

local AP_BLOCK_HEIGHTS = { -2.5, 0, 2 }

local function AP_IsBlocked(kChar, myChar, kHRP, myHRP)
	AP_BlockParams.FilterDescendantsInstances = { kChar, myChar }
	local hits = 0
	for _, h in ipairs(AP_BLOCK_HEIGHTS) do
		local from = kHRP.Position + Vector3.new(0, h, 0)
		local to = myHRP.Position + Vector3.new(0, h, 0)
		local hit = workspace:Raycast(from, to - from, AP_BlockParams)
		if hit then hits += 1
		elseif AP.Cfg.BlockNeedsAll then return false end
	end
	if AP.Cfg.BlockNeedsAll then return hits == #AP_BLOCK_HEIGHTS end
	return hits > 0
end


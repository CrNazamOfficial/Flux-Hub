local function BG2_DoMulti(targetPoint)
	if BG2.IsBypassRunning or not BG2.Enabled or not targetPoint or not targetPoint.Parent then return end
	local gen = targetPoint.Parent
	if not gen or BG2.ProcessedGens[gen] then return end
	BG2.Injected[targetPoint] = nil

		local re = BG2_getRepairEvent(); if not re then return end
		BG2.ProcessedGens[gen] = true; BG2_ClearProcessed(gen, targetPoint)
		local pts = BG2_GetPoints(gen)
		if #pts < BG2_CFG.MIN_TITIK_REPAIR then BG2.ProcessedGens[gen] = nil; return end
		local c = Players.LocalPlayer.Character; local hrp = c and c:FindFirstChild("HumanoidRootPart")
		if not hrp then BG2.ProcessedGens[gen] = nil; return end
		local origP = hrp.Position; local origR = hrp.CFrame - hrp.CFrame.Position
		hrp.Anchored = false; task.wait(0.03)
		local body = gen:FindFirstChild("GeneratorBody") or gen.PrimaryPart
		local count = 0
		for _, p in pairs(pts) do
			if not BG2.Enabled or not hrp.Parent then break end
			if not p or not p.Parent then count = count + 1; continue end
			count = count + 1
			if count > BG2_CFG.MAX_TITIK then break end
			local look = body and body.Position or p.Position
			local tcf
			if (look - p.Position).Magnitude > 0.5 then tcf = CFrame.lookAt(p.Position, look) else tcf = CFrame.new(p.Position) * origR end
			BG2_Smooth(tcf, BG2_CFG.SMOOTH_MOVE_DURATION); task.wait(BG2_CFG.SMOOTH_SETTLE_DELAY)
			BG2_MarkInjected(p)
			pcall(function() re:FireServer(p, true) end)
			if not BG2_WaitRepair(p, BG2_CFG.CONFIRM_TIMEOUT) then
				pcall(function() re:FireServer(p, false) end)
				task.wait(BG2_CFG.TP_DELAY)
				if hrp.Parent and p.Parent then BG2_Smooth(tcf, BG2_CFG.SMOOTH_MOVE_DURATION); task.wait(BG2_CFG.SMOOTH_SETTLE_DELAY) end
				BG2_MarkInjected(p)
				pcall(function() re:FireServer(p, true) end)
				BG2_WaitRepair(p, BG2_CFG.RETRY_TIMEOUT)
			end
		end
		if hrp.Parent then hrp.Anchored = false; BG2_Smooth(CFrame.new(origP) * origR, BG2_CFG.SMOOTH_MOVE_DURATION) end

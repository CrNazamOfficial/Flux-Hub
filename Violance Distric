			if AG.ScourgeMode == "NORMAL" then
				if not AG.Busy and AG_IsNormal() then AG.Busy = true; AG_Trigger(); task.delay(0.06, function() AG.Busy = false end) end
			end
		end)
		table.insert(AG.Conns, conn)

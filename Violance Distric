local function AP_EnsureRing()
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	if AP.State.RingFolder and AP.State.RingFolder.Parent == cam then return AP.State.RingParts end
	AP_DestroyRing()
	local f = Instance.new("Folder"); f.Name = "AP_Ring"; f.Parent = cam; AP.State.RingFolder = f
	local segs = {}
	for i = 1, 32 do

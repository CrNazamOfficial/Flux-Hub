	local bz = (n * stz - st * sz) / D; local az = (sz - bz * st) / n
	local sq = 0
	for i = 1, n do
		local t = h[i].t - t0
		local ex = (h[i].x - x0) - (ax + bx * t); local ez = (h[i].z - z0) - (az + bz * t)
		sq = sq + ex * ex + ez * ez
	end

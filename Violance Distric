            end
        end
        track(swatch.MouseButton1Click:Connect(open))
        track(overlay.MouseButton1Click:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then close() end end))
        track(cancelBtn.MouseButton1Click:Connect(close))
        track(applyBtn.MouseButton1Click:Connect(function() local r, g, b = toRGB(); close(); api.Set(Color3.fromRGB(r, g, b)) end))
        refresh()
        register(api, "Color")
        return api
    end

    return self
end


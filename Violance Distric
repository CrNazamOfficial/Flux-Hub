local function BS_checkPending()
	local p = BS.Pending
	if not p then return end
	if not BS.Enabled then BS.Pending = nil; return end
	local waitTime = math.max(BS_CFG.AckWait, BS.PingSec + 0.3)
	if os.clock() - p.t < waitTime then return end
	BS.Pending = nil
	local known = p.a ~= nil or p.b ~= nil or BS.CdA ~= nil or BS.CdB ~= nil
	if not known then return end
	local accepted = (BS.CdA ~= p.a) or (BS.CdB ~= p.b)
	if accepted then
		BS.Proven = true
		if p.dev >= BS.MaxAngle - 0.5 then BS.MaxAngle = math.min(180, BS.MaxAngle * 1.3 + 1) end
		return
	end
	if BS.Proven then return end
	BS.MaxAngle = math.max(BS_CFG.MinAngle, p.dev * 0.5)
	local fb = BS_copyArgs(p.orig)
	local info = fb[3]
	if type(info) == "table" then
		local ni = {}
		for k, v in pairs(info) do ni[k] = v end
		if type(ni.Time) == "number" then
			local ok, sn = pcall(function() return workspace:GetServerTimeNow() end)
			if ok and type(sn) == "number" and math.abs(ni.Time - (sn - (os.clock() - p.t))) < 3 then ni.Time = sn end
		end
		fb[3] = ni
	end
	BS.Bypass = true
	pcall(function() p.remote:FireServer(table.unpack(fb, 1, fb.n)) end)
	BS.Bypass = false
end
local function BS_faceStep()
	if BS.Dead then return end

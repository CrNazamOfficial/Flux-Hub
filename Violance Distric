local function AP_IsFacingMe(kHRP, myHRP)
	local to = myHRP.Position - kHRP.Position
	local flatTo = Vector3.new(to.X, 0, to.Z)
	if flatTo.Magnitude < 0.5 then return true end
	local look = kHRP.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude < 0.001 then return true end
	flatLook = flatLook.Unit
	local dot = flatLook:Dot(flatTo.Unit)
	if dot <= 0 then return false end
	if math.deg(math.acos(math.clamp(dot, -1, 1))) <= AP.Cfg.FacingHalfAngle then return true end
	local lateral = (flatTo - flatLook * flatTo:Dot(flatLook)).Magnitude
	return lateral <= AP.Cfg.FacingLateral
end

local AP_BlockParams = RaycastParams.new()

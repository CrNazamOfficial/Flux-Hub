local function BS_aimFromSnap(snap, origin)
	local pos = snap.pos
	local vel, factor, lead = snap.vel, snap.factor, snap.lead
	local travel = (pos - origin).Magnitude / BS_CFG.ProjectileSpeed
	local aim = pos
	for _ = 1, 5 do
		local tt = math.min(travel + lead, BS_CFG.MaxPredictTime)
		aim = pos + vel * (tt * factor)
		travel = (aim - origin).Magnitude / BS_CFG.ProjectileSpeed
	end
	return aim
end
local function BS_limitDir(orig, want, maxDeg)
	local o = want
	if orig.Magnitude > 0.001 then o = orig.Unit end
	local c = math.clamp(BS_dot(o, want), -1, 1)
	local ang = math.deg(math.acos(c))
	if ang <= maxDeg then return want end
	local perp = want - o * c
	if perp.Magnitude < 0.0001 then return want end
	perp = perp.Unit
	local r = math.rad(maxDeg)
	return o * math.cos(r) + perp * math.sin(r)
end
local function BS_copyArgs(args)
	local out = {}
	for i = 1, args.n do out[i] = args[i] end
	out.n = args.n
	return out
end
local function BS_onFire(remote, args)
	if BS.Dead then return nil end
	local a1 = args[1]
	local now = os.clock()
	local isVec = typeof(a1) == "Vector3"
	if isVec and BS.LastSent and a1 == BS.LastSent and now - BS.LastSentT < 0.15 then return nil end
	if isVec then BS.Fired = BS.Fired + 1 end
	if not BS.Enabled then return nil end
	if a1 == "windup" then
		BS.Casting = true
		BS.CastUntil = now + BS_CFG.CastTimeout
		return nil
	end
	if not isVec then return nil end
	if BS.Casting then BS.CastUntil = now + BS_CFG.FaceHold end
	local snap = BS.Snap
	if not snap then return nil end
	local info = args[3]
	local origin
	if type(info) == "table" and typeof(info.Origin) == "Vector3" then origin = info.Origin end
	if not origin then origin = BS.CamPos end
	if not origin then return nil end
	local aim = BS_aimFromSnap(snap, origin)
	local d = aim - origin
	local m = d.Magnitude
	if m ~= m or m < 0.5 or m == math.huge then return nil end
	local sent = BS_limitDir(a1, d.Unit, BS.MaxAngle)
	local sm = sent.Magnitude
	if sm ~= sm or sm < 0.5 then return nil end
	sent = sent.Unit
	local base = sent
	if a1.Magnitude > 0.001 then base = a1.Unit end
	local dev = math.deg(math.acos(math.clamp(BS_dot(base, sent), -1, 1)))
	local out = BS_copyArgs(args)
	out[1] = sent
	BS.Changed = BS.Changed + 1
	BS.LastSent = sent
	BS.LastSentT = now
	BS.Pending = {t = now, remote = remote, orig = args, dev = dev, a = BS.CdA, b = BS.CdB}
	return out
end
local function BS_HandlerFn(args, self)
	if not BS.Enabled or BS.Dead then return args end
	if BS.Bypass then return args end
	if typeof(self) ~= "Instance" or self.Name ~= BS_CFG.RemoteName then return args end
	local ok, newArgs = pcall(BS_onFire, self, args)
	if ok and newArgs then
		return newArgs
	end
	return args
end
local function BS_FindChainRemote()
	pcall(function()
		local r = ReplicatedStorage:FindFirstChild("Remotes")
		if not r then return end
		for _, d in ipairs(r:GetDescendants()) do
			if d.Name == BS_CFG.RemoteName and (d:IsA("RemoteEvent") or d:IsA("UnreliableRemoteEvent")) then
				BS_ChainRemote = d; return
